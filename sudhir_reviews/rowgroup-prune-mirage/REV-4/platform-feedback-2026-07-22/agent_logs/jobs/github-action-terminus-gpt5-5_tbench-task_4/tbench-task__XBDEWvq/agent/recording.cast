[21.057833, "o", "--- /app/cpp/include/loam/report.hpp\r\n"]
[21.058814, "o", "#pragma once\r\n\r\n#include \"loam/types.hpp\"\r\n\r\n#include <filesystem>\r\n#include <string>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n\r\n"]
[21.058859, "o", "void write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases);\r\nstd::string digest_hex(const std::string& text);\r\nstd::string lane_name(Lane lane);\r\n\r\n}  // namespace loam\r\n"]
[21.059134, "o", "/app/cpp/include/loam/store.hpp\r\n"]
[21.059822, "o", "--- /app/cpp/include/loam/store.hpp\r\n"]
[21.060519, "o", "#pragma once\r\n\r\n#include \"loam/types.hpp\"\r\n\r\n#include <filesystem>\r\n"]
[21.060606, "o", "#include <vector>\r\n\r\nnamespace loam {\r\n\r\nstd::vector<Slab> load_store(const std::filesystem::path& path);\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory);\r\nCaseResult run_case(const CaseSpec& spec);\r\n\r\n}  // namespace loam\r\n"]
[21.06077, "o", "/app/cpp/include/loam/types.hpp\r\n"]
[21.061489, "o", "--- /app/cpp/include/loam/types.hpp\r\n"]
[21.062287, "o", "#pragma once\r\n\r\n#include <cstdint>\r\n#include <string>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n\r\nenum class Origin : std::uint8_t { Retired = 0, Inherited = 1, Current = 2 };\r\n\r\nstruct Cell {\r\n    std::uint8_t present{};\r\n    Origin origin{Origin::Current};"]
[21.062332, "o", "\r\n    std::int64_t amount{};\r\n    std::string region;\r\n};\r\n\r\nstruct Slab {\r\n    std::size_t id{};\r\n    std::uint8_t generation{};\r\n    std::int64_t low{};\r\n    std::int64_t high{};\r\n    bool has_absent{};\r\n    std::string region_low;\r\n    std::string region_high;\r\n    std::vector<Cell> cells;\r\n    std::vector<std::int64_t> amount_lane;\r\n    std::vector<std::uint8_t> presence_lane;\r\n    std::vector<std::uint8_t> origin_lane;\r\n    std::vector<std::string> region_lane;\r\n};\r\n\r\nenum class Op { All, Equal, Range, IsNull, RegionEqual };\r\nenum class Lane { Row, Batch };\r\n"]
[21.062392, "o", "\r\nstruct Probe {\r\n    Op op{Op::All};\r\n    std::int64_t x{};\r\n    std::int64_t y{};\r\n    std::string text;\r\n    Lane lane{Lane::Row};\r\n    bool skipping{};\r\n};\r\n\r\nstruct Gate {\r\n    bool read{true};\r\n    std::string note;\r\n};\r\n\r\nstruct Tally {\r\n    std::int64_t row_count{};\r\n    std::int64_t sum_amount{};\r\n    std::int64_t pages_read{};\r\n};\r\n\r\n"]
[21.062456, "o", "struct CaseSpec {\r\n    std::string case_id;\r\n    std::string store_path;\r\n    Probe probe;\r\n};\r\n\r\nstruct CaseResult {\r\n    std::string case_id;\r\n    Tally tally;\r\n    std::int64_t pages_total{};\r\n    Lane lane{Lane::Row};\r\n    bool skipping{};\r\n};\r\n\r\n}  // namespace loam\r\n"]
[21.062712, "o", "/app/cpp/src/digest.cpp\r\n"]
[21.063447, "o", "--- /app/cpp/src/digest.cpp\r\n"]
[21.064143, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <cstdint>\r\n#include <iomanip>\r\n#include <sstream>\r\n\r\nnamespace loam {\r\n\r\nstd::string digest_hex(const std::string& text) {\r\n    std::uint64_t value = 1469598103934665603ULL;\r\n"]
[21.064172, "o", "    for (const unsigned char byte : text) {\r\n        value ^= byte;\r\n        value *= 1099511628211ULL;\r\n    }\r\n    std::ostringstream out;\r\n    out << std::hex << std::setfill('0') << std::setw(16) << value;\r\n    return out.str();\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.06441, "o", "/app/cpp/src/harbor/pale.cpp\r\n"]
[21.065281, "o", "--- /app/cpp/src/harbor/pale.cpp\r\n"]
[21.065927, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nstd::string turn_d(const Gate& a, const Probe& b) {\r\n    const char* lane = b.lane == Lane::Batch ? \"batch\" : \"row\";\r\n    return std::string(lane) + \":\" + (a.read ? \"open:\" : \"closed:\") + a.note;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.066152, "o", "/app/cpp/src/harbor/veil.cpp\r\n"]
[21.06676, "o", "--- /app/cpp/src/harbor/veil.cpp\r\n"]
[21.067389, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n        return {true, \"full\"};\r\n    }\r\n    if (b.op == Op::All) {\r\n        return {true, \"all\"};\r\n    }\r\n"]
[21.067431, "o", "    if (b.op == Op::IsNull) {\r\n        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n\r\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.067676, "o", "/app/cpp/src/lattice/bay.cpp\r\n"]
[21.068282, "o", "--- /app/cpp/src/lattice/bay.cpp\r\n"]
[21.068919, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\n\r\nTally sweep_e(const Tally& a, const Tally& b) {\r\n    return {\r\n        a.row_count + b.row_count,\r\n        a.sum_amount + b.sum_amount,\r\n        a.pages_read + b.pages_read,\r\n    };\r\n}\r\n\r\n"]
[21.068949, "o", "}  // namespace loam\r\n"]
[21.069143, "o", "/app/cpp/src/lattice/rill.cpp\r\n"]
[21.069817, "o", "--- /app/cpp/src/lattice/rill.cpp\r\n"]
[21.070544, "o", "#include \"loam/exec.hpp\"\r\n\r\n#include <cstddef>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n"]
[21.070584, "o", "    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n\r\n    const std::size_t count = a.amount_lane.size();\r\n    std::vector<unsigned char> admit(count, 0);\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    }\r\n\r\n    if (b.op == Op::IsNull) {\r\n        for (std::size_t i = 0; i < count; ++i) {\r\n            if (admit[i] == 0) {\r\n                ++tally.row_count;\r\n            }\r\n        }\r\n        return tally;\r\n"]
[21.070615, "o", "    }\r\n\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        if (admit[i] == 0) {\r\n            continue;\r\n        }\r\n        bool keep = false;\r\n        switch (b.op) {\r\n            case Op::All:\r\n                keep = true;\r\n                break;\r\n            case Op::Equal:\r\n                keep = a.amount_lane[i] == b.x;\r\n                break;\r\n            case Op::Range:\r\n"]
[21.070644, "o", "                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n                break;\r\n            case Op::IsNull:\r\n                keep = false;\r\n                break;\r\n            case Op::RegionEqual:\r\n                keep = a.region_lane[i] == b.text;\r\n                break;\r\n        }\r\n        if (keep) {\r\n            ++tally.row_count;\r\n            tally.sum_amount += a.amount_lane[i];\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n"]
[21.070688, "o", "\r\n}  // namespace loam\r\n"]
[21.070924, "o", "/app/cpp/src/main.cpp\r\n"]
[21.071744, "o", "--- /app/cpp/src/main.cpp\r\n"]
[21.072434, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n\r\n"]
[21.072492, "o", "namespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n\r\nint main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n            results.reserve(specs.size());\r\n"]
[21.072531, "o", "            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n"]
[21.072567, "o", "        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
[21.072801, "o", "/app/cpp/src/parse.cpp\r\n"]
[21.073552, "o", "--- /app/cpp/src/parse.cpp\r\n"]
[21.074478, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n"]
[21.074535, "o", "    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);\r\n}\r\n\r\n"]
[21.074567, "o", "}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n"]
[21.074615, "o", "            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n"]
[21.074649, "o", "            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.074925, "o", "/app/cpp/src/report.cpp\r\n"]
[21.075588, "o", "--- /app/cpp/src/report.cpp\r\n"]
[21.076396, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <fstream>\r\n#include <sstream>\r\n#include <stdexcept>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::string escape_json(const std::string& value) {\r\n    std::string out;\r\n    for (const char ch : value) {\r\n        if (ch == '\"' || ch == '\\\\') {\r\n"]
[21.076452, "o", "            out.push_back('\\\\');\r\n        }\r\n        out.push_back(ch);\r\n    }\r\n    return out;\r\n}\r\n\r\nstd::string cases_json(const std::vector<CaseResult>& cases) {\r\n    std::ostringstream out;\r\n    out << '[';\r\n    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n        if (i != 0) out << ',';\r\n        const auto& item = cases[i];\r\n        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n            << \",\\\"pages_total\\\":\" << item.pages_total\r\n            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n            << '}';\r\n    }\r\n    out << ']';\r\n    return out.str();\r\n}\r\n\r\n}  // namespace\r\n"]
[21.076484, "o", "\r\nstd::string lane_name(const Lane lane) {\r\n    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n}\r\n\r\nvoid write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n    if (path.has_parent_path()) {\r\n        std::filesystem::create_directories(path.parent_path());\r\n    }\r\n    const std::string body = cases_json(cases);\r\n    const std::string digest = digest_hex(body);\r\n    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    if (!output) {\r\n        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n    }\r\n"]
[21.076532, "o", "    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.076745, "o", "/app/cpp/src/row.cpp\r\n"]
[21.077429, "o", "--- /app/cpp/src/row.cpp\r\n"]
[21.079264, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\n"]
[21.079309, "o", "namespace {\r\n"]
[21.079345, "o", "\r\nbool is_live(const Cell& cell) {\r\n    if (cell.origin == Origin::Retired) {\r\n        return false;\r\n    }\r\n    if (cell.origin == Origin::Inherited) {\r\n"]
[21.079379, "o", "        return true;\r\n    }\r\n    return cell.present != 0;\r\n}\r\n\r\n"]
[21.079445, "o", "bool matches(const Cell& cell, const Probe& probe) {\r\n    switch (probe.op) {\r\n        case Op::All:\r\n            return true;\r\n        case Op::Equal:\r\n            return cell.amount == probe.x;\r\n        case Op::Range:\r\n            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n        case Op::IsNull:\r\n            return false;\r\n        case Op::RegionEqual:\r\n            return cell.region == probe.text;\r\n    }\r\n    return false;\r\n"]
[21.07948, "o", "}\r\n\r\n}  // namespace\r\n\r\nTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n"]
[21.079523, "o", "    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n    for (const auto& cell : a.cells) {\r\n"]
[21.079555, "o", "        const bool live = is_live(cell);\r\n        if (b.op == Op::IsNull) {\r\n            if (!live) {\r\n                ++tally.row_count;\r\n"]
[21.079586, "o", "            }\r\n            continue;\r\n        }\r\n        if (live && matches(cell, b)) {\r\n            ++tally.row_count;\r\n"]
[21.079621, "o", "            tally.sum_amount += cell.amount;\r\n        }\r\n    }\r\n    return tally;\r\n}"]
[21.079652, "o", "\r\n\r\n}  // namespace loam\r\n"]
[21.080071, "o", "/app/cpp/src/store.cpp\r\n"]
[21.080771, "o", "--- /app/cpp/src/store.cpp\r\n"]
[21.081421, "o", "#include \"loam/store.hpp\"\r\n\r\n#include \"loam/exec.hpp\"\r\n#include \"loam/plan.hpp\"\r\n\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n"]
[21.081464, "o", "    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<Slab> load_store(const std::filesystem::path& path) {\r\n    std::ifstream input(path);\r\n    if (!input) {\r\n"]
[21.081507, "o", "        throw std::runtime_error(\"cannot open store: \" + path.string());\r\n    }\r\n\r\n    std::vector<Slab> slabs;\r\n    std::string line;\r\n    while (std::getline(input, line)) {\r\n        if (line.empty() || line.rfind(\"H|\", 0) == 0) {\r\n            continue;\r\n        }\r\n        const auto page = split(line);\r\n        if (page.size() != 9 || page[0] != \"P\") {\r\n            throw std::runtime_error(\"bad page record in \" + path.string());\r\n        }\r\n        Slab slab;\r\n        slab.id = std::stoull(page[1]);\r\n"]
[21.08154, "o", "        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n        slab.low = std::stoll(page[3]);\r\n        slab.high = std::stoll(page[4]);\r\n        slab.has_absent = page[5] == \"1\";\r\n        slab.region_low = page[6];\r\n        slab.region_high = page[7];\r\n        const auto row_count = std::stoull(page[8]);\r\n        for (std::size_t i = 0; i < row_count; ++i) {\r\n            if (!std::getline(input, line)) {\r\n                throw std::runtime_error(\"short page in \" + path.string());\r\n            }\r\n"]
[21.081572, "o", "            const auto row = split(line);\r\n            if (row.size() != 5 || row[0] != \"R\") {\r\n                throw std::runtime_error(\"bad row record in \" + path.string());\r\n            }\r\n            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));\r\n            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));\r\n            const auto amount = std::stoll(row[3]);\r\n            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});\r\n            slab.presence_lane.push_back(presence);\r\n            slab.origin_lane.push_back(origin);\r\n            slab.amount_lane.push_back(amount);\r\n"]
[21.081618, "o", "            slab.region_lane.push_back(row[4]);\r\n        }\r\n        slabs.push_back(std::move(slab));\r\n    }\r\n    return slabs;\r\n}\r\n\r\nCaseResult run_case(const CaseSpec& spec) {\r\n    const auto slabs = load_store(spec.store_path);\r\n    Tally total;\r\n    for (const auto& slab : slabs) {\r\n        const Gate gate = turn_b(slab, spec.probe);\r\n        const auto label = turn_d(gate, spec.probe);\r\n        (void)label;\r\n        const Tally part = spec.probe.lane == Lane::Batch\r\n            ? sweep_c(slab, spec.probe, gate)\r\n            : walk_row(slab, spec.probe, gate);\r\n        total = sweep_e(total, part);\r\n"]
[21.081666, "o", "    }\r\n    return {\r\n        spec.case_id,\r\n        total,\r\n        static_cast<std::int64_t>(slabs.size()),\r\n        spec.probe.lane,\r\n        spec.probe.skipping,\r\n    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
