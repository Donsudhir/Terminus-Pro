[27.16484, "o", "     6\t#include <string>\r\n     7\t\r\n     8\tnamespace loam {\r\n     9\tnamespace {\r\n"]
[27.164873, "o", "    10\t\r\n    11\tstd::vector<std::string> split(const std::string& line) {\r\n    12\t    std::vector<std::string> fields;\r\n    13\t    std::size_t start = 0;\r\n    14\t    while (true) {\r\n    15\t        const auto end = line.find('|', start);\r\n    16\t        fields.push_back(line.substr(start, end - start));\r\n    17\t        if (end == std::string::npos) {\r\n    18\t            break;\r\n    19\t        }\r\n    20\t        start = end + 1;\r\n    21\t    }\r\n    22\t    return fields;\r\n    23\t}\r\n    24\t\r\n    25\tOp parse_op(const std::string& value) {\r\n    26\t    if (value == \"all\") return Op::All;\r\n    27\t    if (value == \"eq\") return Op::Equal;\r\n"]
[27.164924, "o", "    28\t    if (value == \"range\") return Op::Range;\r\n    29\t    if (value == \"isnull\") return Op::IsNull;\r\n    30\t    if (value == \"region_eq\") return Op::RegionEqual;\r\n    31\t    throw std::runtime_error(\"unknown operation: \" + value);\r\n    32\t}\r\n"]
[27.164966, "o", "    33\t\r\n    34\tLane parse_lane(const std::string& value) {\r\n    35\t    if (value == \"row\") return Lane::Row;\r\n    36\t    if (value == \"batch\") return Lane::Batch;\r\n    37\t    throw std::runtime_error(\"unknown path: \" + value);\r\n    38\t}\r\n    39\t\r\n    40\t}  // namespace\r\n    41\t\r\n    42\tstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    43\t    std::vector<std::filesystem::path> paths;\r\n    44\t    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n    45\t        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n    46\t            paths.push_back(entry.path());\r\n    47\t        }\r\n    48\t    }\r\n    49\t    std::sort(paths.begin(), paths.end());\r\n    50\t\r\n"]
[27.164999, "o", "    51\t    std::vector<CaseSpec> cases;\r\n    52\t    for (const auto& path : paths) {\r\n    53\t        std::ifstream input(path);\r\n    54\t        if (!input) {\r\n    55\t            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n    56\t        }\r\n    57\t        std::string line;\r\n    58\t        while (std::getline(input, line)) {\r\n    59\t            if (line.empty() || line[0] == '#') {\r\n    60\t                continue;\r\n    61\t            }\r\n    62\t            const auto fields = split(line);\r\n    63\t            if (fields.size() != 8) {\r\n    64"]
[27.165039, "o", "\t                throw std::runtime_error(\"bad case row in \" + path.string());\r\n    65\t            }\r\n    66\t            Probe probe;\r\n    67\t            probe.op = parse_op(fields[2]);\r\n    68\t            if (probe.op == Op::RegionEqual) {\r\n    69\t                probe.text = fields[3];\r\n    70\t            } else {\r\n    71\t                probe.x = std::stoll(fields[3]);\r\n    72\t                probe.y = std::stoll(fields[4]);\r\n    73\t            }\r\n    74\t            probe.lane = parse_lane(fields[5]);\r\n    75\t            probe.skipping = fields[6] == \"1\";\r\n"]
[27.165073, "o", "    76\t            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n    77\t        }\r\n    78\t    }\r\n    79\t    return cases;\r\n    80\t}\r\n    81\t\r\n    82\t}  // namespace loam\r\n"]
