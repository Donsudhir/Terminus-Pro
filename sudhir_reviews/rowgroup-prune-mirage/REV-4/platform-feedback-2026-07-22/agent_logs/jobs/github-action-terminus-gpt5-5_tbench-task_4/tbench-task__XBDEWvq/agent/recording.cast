[62.725601, "i", " const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\n    const bool read = !(right < a.low || left > a.high);\n    return {read, read ? \"range-hit\" : \"range-away\"};\n''','''    const std::int64_t left = b.x;\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\n\n    // Generation 3 writers record low/high over the live-value domain.  Some\n    // archived generation-2 slabs carry mixed lanes and incomplete numeric\n    // markers (for example markers copied from absent/legacy sentinels rather\n    // than live amounts).  Readers must not rewrite those artifacts, so keep\n    // the fast numeric gate for faithful slabs and open older suspect slabs for\n    // exact row/lattice evaluation.\n    if (a.generation < 3 && a.has_absent) {\n        return {true, \"legacy-open\"};\n    }\n\n    const bool read = !(right < a.low || left > a.high);\n    return {read, read ? \"range-hit\" : \"range-away\"};\n''')\np.write_text(s)\n\np=Path('/app/rust/src/ember/fold.rs')\ns=p.read_text()\ns=s.replace('''    let mut low = a[0];\n    l"]
