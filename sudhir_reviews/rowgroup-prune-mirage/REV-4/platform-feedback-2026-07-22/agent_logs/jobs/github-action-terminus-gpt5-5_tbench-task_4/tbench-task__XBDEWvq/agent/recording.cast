[32.597516, "o", "\r\n    16\tbool matches(const Cell& cell, const Probe& probe) {\r\n    17\t    switch (probe.op) {\r\n    18\t        case Op::All:\r\n    19\t            return true;\r\n    20\t        case Op::Equal:\r\n    21\t            return cell.amount == probe.x;\r\n    22\t        case Op::Range:\r\n    23\t            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n    24\t        case Op::IsNull:\r\n    25\t            return false;\r\n    26\t        case Op::RegionEqual:\r\n    27\t            return cell.region == probe.text;\r\n    28\t    }\r\n    29\t    return false;\r\n    30\t}\r\n    31\t\r\n    32\t}  // namespace\r\n    33\t\r\n    34\tTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    35\t    Tally tally;\r\n    36\t    if (!c.read) {\r\n"]
[32.597545, "o", "    37\t        return tally;\r\n    38\t    }\r\n    39\t    tally.pages_read = 1;\r\n    40\t    for (const auto& cell : a.cells) {\r\n    41\t        const bool live = is_live(cell);\r\n    42\t        if (b.op == Op::IsNull) {\r\n    43\t            if (!live) {\r\n    44\t                ++tally.row_count;\r\n    45\t            }\r\n    46\t            continue;\r\n    47\t        }\r\n"]
