[21.048938, "o", "CXX ?= g++\r\nCXXFLAGS ?= -std=c++20 -O2 -Wall -Wextra -Wpedantic -Werror -Iinclude\r\nLDFLAGS ?=\r\n\r\nSOURCES := $(shell find src -type f -name '*.cpp' | sort)\r\nOBJECTS := $(patsubst src/%.cpp,build/%.o,$(SOURCES))\r\nTARGET := build/loam\r\n\r\n.PHONY: all clean\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(OBJECTS)"]
[21.04899, "o", "\r\n\t$(CXX) $(CXXFLAGS) $(OBJECTS) $(LDFLAGS) -o $@\r\n\r\nbuild/%.o: src/%.cpp\r\n\t@mkdir -p $(dir $@)\r\n\t$(CXX) $(CXXFLAGS) -c $< -o $@\r\n\r\nclean:\r\n\trm -rf build\r\n"]
