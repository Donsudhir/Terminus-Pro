[95.939198, "i", "python3 - <<'PY'\nfrom pathlib import Path\n\nPath('/app/cpp/src/lattice/rill.cpp').write_text('''#include \"loam/exec.hpp\"\\n\\nnamespace loam {\\nnamespace {\\n\\nbool is_text(const std::string& a, const std::string& b) {\\n    return a == b;\\n}\\n\\nbool is_live(std::uint8_t present, std::uint8_t origin) {\\n    if (origin == static_cast<std::uint8_t>(Origin::Retired)) {\\n        return false;\\n    }\\n    if (origin == static_cast<std::uint8_t>(Origin::Inherited)) {\\n        return true;\\n    }\\n    return present != 0;\\n}\\n\\n}  // namespace\\n\\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\\n    Tally tally;\\n    if (!c.read) {\\n        return tally;\\n    }\\n    tally.pages_read = 1;\\n    const std::size_t count = a.amount_lane.size();\\n    std::vector<std::uint8_t> admit(count);\\n    for (std::size_t i = 0; i < count; ++i) {\\n        admit[i] = is_live(a.presence_lane[i], a.origin_lane[i]) ? 1 : 0;\\n    }\\n\\n    for (std::size_t i = 0; i < count; ++i) {\\n        if (b.op == Op::IsNull) {\\n            if"]
[95.939317, "i", " (!admit[i]) {\\n                ++tally.row_count;\\n            }\\n            continue;\\n        }\\n\\n        if (!admit[i]) {\\n            continue;\\n        }\\n\\n        bool keep = false;\\n        switch (b.op) {\\n            case Op::All:\\n                keep = true;\\n                break;\\n            case Op::Equal:\\n                keep = a.amount_lane[i] == b.x;\\n                break;\\n            case Op::Range:\\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\\n                break;\\n            case Op::IsNull:\\n                keep = false;\\n                break;\\n            case Op::RegionEqual:\\n                keep = is_text(a.region_lane[i], b.text);\\n                break;\\n        }\\n        if (keep) {\\n            ++tally.row_count;\\n            tally.sum_amount += a.amount_lane[i];\\n        }\\n    }\\n    return tally;\\n}\\n\\n}  // namespace loam\\n''')\n\nPath('/app/cpp/src/harbor/veil.cpp').write_text('''#include \"loam/plan.hpp\"\\n\\nnamespace loam {\\n\\nGate tu"]
