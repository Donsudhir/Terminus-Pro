[27.166484, "o", "     1\t#include \"loam/report.hpp\"\r\n     2\t\r\n     3\t#include <fstream>\r\n     4\t#include <sstream>\r\n     5\t#include <stdexcept>\r\n"]
[27.166496, "o", "     6\t\r\n     7\tnamespace loam {\r\n     8\tnamespace {\r\n     9\t\r\n    10\tstd::string escape_json(const std::string& value) {\r\n    11\t    std::string out;\r\n"]
[27.166543, "o", "    12\t    for (const char ch : value) {\r\n    13\t        if (ch == '\"' || ch == '\\\\') {\r\n    14\t            out.push_back('\\\\');\r\n    15\t        }\r\n    16\t        out.push_back(ch);\r\n    17\t    }\r\n    18\t    return out;\r\n    19\t}\r\n    20\t\r\n    21\tstd::string cases_json(const std::vector<CaseResult>& cases) {\r\n    22\t    std::ostringstream out;\r\n    23\t    out << '[';\r\n    24\t    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n    25\t        if (i != 0) out << ',';\r\n    26\t        const auto& item = cases[i];\r\n    27\t        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n"]
[27.1666, "o", "    28\t            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n    29\t            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n    30\t            << \",\\\"pages_total\\\":\" << item.pages_total\r\n    31\t            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n    32\t            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n    33\t            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n"]
[27.166659, "o", "    34\t            << '}';\r\n    35\t    }\r\n    36\t    out << ']';\r\n    37\t    return out.str();\r\n    38\t}\r\n    39\t\r\n    40\t}  // namespace\r\n    41\t\r\n    42\tstd::string lane_name(const Lane lane) {\r\n    43\t    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n    44\t}\r\n    45\t\r\n    46\tvoid write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n    47\t    if (path.has_parent_path()) {\r\n    48\t        std::filesystem::create_directories(path.parent_path());\r\n    49\t    }\r\n    50\t    const std::string body = cases_json(cases);\r\n    51\t    const std::string digest = digest_hex(body);\r\n    52\t    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    53\t    if (!output) {\r\n    54\t        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n    55\t    }\r\n    56\t    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n"]
[27.166691, "o", "    57\t           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n    58\t}\r\n    59\t\r\n    60\t}  // namespace loam\r\n"]
[27.166828, "o", "### /app/cpp/src/main.cpp\r\n"]
[27.168081, "o", "     1\t#include \"loam/report.hpp\"\r\n     2\t#include \"loam/store.hpp\"\r\n     3\t\r\n     4\t#include <filesystem>\r\n     5\t#include <iostream>\r\n     6\t#include <stdexcept>\r\n     7\t"]
[27.168096, "o", "#include <sys/wait.h>\r\n     8\t#include <unistd.h>\r\n     9\t#include <vector>\r\n    10\t\r\n    11\tnamespace {\r\n"]
[27.168189, "o", "    12\t\r\n    13\tint run_ingest(const char* input, const char* output) {\r\n    14\t    const pid_t child = fork();\r\n    15\t    if (child == -1) {\r\n    16\t        throw std::runtime_error(\"fork failed\");\r\n    17\t    }\r\n    18\t    if (child == 0) {\r\n    19\t        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n    20\t        _exit(127);\r\n    21\t    }\r\n    22\t    int status = 0;\r\n    23\t    if (waitpid(child, &status, 0) == -1) {\r\n    24\t        throw std::runtime_error(\"waitpid failed\");\r\n    25\t    }\r\n    26\t    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n    27\t}\r\n    28\t\r\n    29\t}  // namespace\r\n    30\t\r\n    31\tint main(int argc, char** argv) {\r\n    32\t    try {\r\n    33\t        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n    34\t            const auto specs = loam::load_cases(argv[2]);\r\n    35\t            std::vector<loam::CaseResult> results;\r\n    36\t            results.reserve(specs.size());\r\n"]
[27.168235, "o", "    37\t            for (const auto& spec : specs) {\r\n    38\t                results.push_back(loam::run_case(spec));\r\n    39\t            }\r\n    40\t            loam::write_report(argv[3], results);\r\n    41\t            return 0;\r\n    42\t        }\r\n    43\t        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n    44\t            return run_ingest(argv[2], argv[3]);\r\n    45\t        }\r\n    46\t        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n    47\t            const auto slabs = loam::load_store(argv[2]);\r\n    48\t            for (const auto& slab : slabs) {\r\n    49\t                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n    50\t                          << '|' << slab.low << '|' << slab.high << '|'\r\n    51\t                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n    52\t                          << '\\n';\r\n    53\t            }\r\n    54\t            return 0;\r\n    55\t        }\r\n    56\t        std::cerr << \"usage: loam audit <case-directory> <report-"]
[27.168272, "o", "path>\\n\"\r\n    57\t                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n    58\t                  << \"       loam inspect <store>\\n\";\r\n    59\t        return 2;\r\n    60\t    } catch (const std::exception& error) {\r\n    61\t        std::cerr << \"loam: \" << error.what() << '\\n';\r\n    62\t        return 1;\r\n    63\t    }\r\n    64\t}\r\n"]
