[62.725693, "i", "et mut high = a[0];\n    let mut has_absent = false;\n    for (value, present) in a.iter().zip(b.iter()) {\n        low = low.min(*value);\n        high = high.max(*value);\n        has_absent |= *present == 0;\n    }\n\n    Ok(Mark {\n        low,\n        high,\n        has_absent,\n    })\n''','''    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        let live = *origin != crate::model::RUNE_VOID && *present != 0;\n        if live {\n            low = Some(low.map_or(*value, |old| old.min(*value)));\n            high = Some(high.map_or(*value, |old| old.max(*value)));\n        } else {\n            has_absent = true;\n        }\n    }\n\n    Ok(Mark {\n        low: low.unwrap_or(0),\n        high: high.unwrap_or(0),\n        has_absent,\n    })\n''')\np.write_text(s)\nPY\n/app/tools/build-all\n/app/bin/loam audit /app/data/cases /app/output/audit.json && cat /app/output/audit.json\n"]
