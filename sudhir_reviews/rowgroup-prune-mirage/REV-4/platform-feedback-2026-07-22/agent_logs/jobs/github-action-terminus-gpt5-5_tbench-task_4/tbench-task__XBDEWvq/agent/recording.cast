[62.381331, "o", "     8\tTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n     9\t    Tally tally;\r\n    10\t    if (!c.read) {\r\n    11\t        return tally;\r\n    12\t    }\r\n    13\t    tally.pages_read = 1;\r\n    14\t\r\n    15\t    const std::size_t count = a.amount_lane.size();\r\n    16\t    std::vector<unsigned char> admit(count, 0);\r\n    17\t    for (std::size_t i = 0; i < count; ++i) {\r\n    18\t        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    if (b.op == Op::IsNull) {\r\n    22\t        for (std::size_t i = 0; i < count; ++i) {\r\n"]
