[27.159734, "o", "     1\t#include \"loam/plan.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n"]
[27.159774, "o", "     4\t\r\n     5\tGate turn_b(const Slab& a, const Probe& b) {\r\n"]
[27.159807, "o", "     6\t    if (!b.skipping) {\r\n     7\t        return {true, \"full\"};\r\n     8\t    }\r\n     9\t    if (b.op == Op::All) {\r\n    10\t        return {true, \"all\"};\r\n    11\t    }\r\n    12\t    if (b.op == Op::IsNull) {\r\n"]
[27.15983, "o", "    13\t        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    14\t    }\r\n    15\t    if (b.op == Op::RegionEqual) {\r\n    16\t        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n    17\t        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    18\t    }\r\n    19\t\r\n"]
[27.159873, "o", "    20\t    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    21\t    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    22\t    const bool read = !(right < a.low || left > a.high);\r\n    23\t    return {read, read ? \"range-hit\" : \"range-away\"};\r\n    24\t}\r\n    25\t\r\n    26\t}  // namespace loam\r\n"]
[27.160352, "o", "### /app/cpp/src/row.cpp\r\n"]
[27.162805, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4\tnamespace {\r\n"]
[27.162818, "o", "     5\t\r\n     6\tbool is_live(const Cell& cell) {\r\n"]
[27.162868, "o", "     7\t    if (cell.origin == Origin::Retired) {\r\n     8\t        return false;\r\n     9\t    }\r\n    10\t    if (cell.origin == Origin::Inherited) {\r\n    11\t        return true;\r\n"]
[27.162914, "o", "    12\t    }\r\n    13\t    return cell.present != 0;\r\n    14\t}\r\n    15\t\r\n    16\tbool matches(const Cell& cell, const Probe& probe) {\r\n"]
[27.162962, "o", "    17\t    switch (probe.op) {\r\n    18\t        case Op::All:\r\n    19\t            return true;\r\n    20\t        case Op::Equal:\r\n    21\t            return cell.amount == probe.x;\r\n    22\t        case Op::Range:\r\n    23\t            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n"]
[27.162996, "o", "    24\t        case Op::IsNull:\r\n    25\t            return false;\r\n    26\t        case Op::RegionEqual:\r\n    27\t            return cell.region == probe.text;\r\n    28\t    }\r\n    29\t    return false;\r\n    30\t}\r\n    31\t\r\n"]
[27.163028, "o", "    32\t}  // namespace\r\n    33\t\r\n    34\tTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    35\t    Tally tally;\r\n    36\t    if (!c.read) {\r\n    37\t        return tally;\r\n"]
[27.163059, "o", "    38\t    }\r\n    39\t    tally.pages_read = 1;\r\n    40\t    for (const auto& cell : a.cells) {\r\n    41\t        const bool live = is_live(cell);\r\n    42\t        if (b.op == Op::IsNull) {\r\n    43\t            if (!live) {"]
[27.163092, "o", "\r\n    44\t                ++tally.row_count;\r\n    45\t            }\r\n    46\t            continue;\r\n    47\t        }\r\n    48\t        if (live && matches(cell, b)) {\r\n"]
[27.163125, "o", "    49\t            ++tally.row_count;\r\n    50\t            tally.sum_amount += cell.amount;\r\n    51\t        }\r\n    52\t    }\r\n    53\t    return tally;\r\n"]
[27.163155, "o", "    54\t}\r\n    55\t\r\n    56\t}  // namespace loam\r\n"]
