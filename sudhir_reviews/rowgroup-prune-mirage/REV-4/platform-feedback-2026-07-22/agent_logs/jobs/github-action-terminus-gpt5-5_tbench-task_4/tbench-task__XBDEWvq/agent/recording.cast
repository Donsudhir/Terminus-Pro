[32.599826, "o", "    75\t\r\n    76\tCaseResult run_case(const CaseSpec& spec) {\r\n    77\t    const auto slabs = load_store(spec.store_path);\r\n    78\t    Tally total;\r\n    79\t    for (const auto& slab : slabs) {\r\n    80\t        const Gate gate = turn_b(slab, spec.probe);\r\n    81\t        const auto label = turn_d(gate, spec.probe);\r\n    82\t        (void)label;\r\n    83\t        const Tally part = spec.probe.lane == Lane::Batch\r\n    84\t            ? sweep_c(slab, spec.probe, gate)\r\n    85\t"]
