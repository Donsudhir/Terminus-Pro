[38.572738, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4\t\r\n     5\tTally sweep_e(const Tally& a, const Tally& b) {\r\n     6\t    return {\r\n     7\t        a.row_count + b.row_count,\r\n     8\t        a.sum_amount + b.sum_amount,\r\n     9\t        a.pages_read + b.pages_read,\r\n    10\t    };\r\n    11\t}\r\n    12\t\r\n    13\t}  // namespace loam\r\n"]
[38.573097, "o", "### /app/cpp/src/lattice/rill.cpp\r\n"]
[38.574952, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\t#include <cstddef>\r\n"]
[38.574991, "o", "     4\t#include <vector>\r\n     5\t\r\n     6\tnamespace loam {\r\n     7\t\r\n"]
[38.575025, "o", "     8\tTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n     9\t    Tally tally;\r\n    10\t    if (!c.read) {\r\n    11\t        return tally;\r\n    12\t    }\r\n    13\t    tally.pages_read = 1;\r\n    14\t\r\n    15\t    const std::size_t count = a.amount_lane.size();\r\n    16\t    std::vector<unsigned char> admit(count, 0);\r\n    17\t    for (std::size_t i = 0; i < count; ++i) {\r\n"]
[38.575064, "o", "    18\t        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    if (b.op == Op::IsNull) {\r\n    22\t        for (std::size_t i = 0; i < count; ++i) {\r\n    23\t            if (admit[i] == 0) {\r\n    24\t                ++tally.row_count;\r\n    25\t            }\r\n    26\t        }\r\n    27"]
[38.575086, "o", "\t        return tally;\r\n    28\t    }\r\n    29\t\r\n    30\t    for (std::size_t i = 0; i < count; ++i) {\r\n    31\t        if (admit[i] == 0) {\r\n    32\t            continue;\r\n    33\t        }\r\n    34\t        bool keep = false;\r\n    35\t        switch (b.op) {\r\n    36\t            case Op::All:\r\n    37\t                keep = true;\r\n    38\t                break;\r\n"]
[38.575157, "o", "    39\t            case Op::Equal:\r\n    40\t                keep = a.amount_lane[i] == b.x;\r\n    41\t                break;\r\n    42\t            case Op::Range:\r\n    43\t                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n    44\t                break;\r\n"]
[38.575222, "o", "    45\t            case Op::IsNull:\r\n    46\t                keep = false;\r\n    47\t                break;\r\n    48\t            case Op::RegionEqual:\r\n    49\t                keep = a.region_lane[i] == b.text;\r\n    50\t                break;\r\n    51\t        }\r\n    52\t        if (keep) {\r\n    53\t            ++tally.row_count;\r\n    54\t            tally.sum_amount += a.amount_lane[i];\r\n    55\t        }\r\n    56\t    }\r\n    57\t    return tally;\r\n    58\t}\r\n    59\t\r\n    60\t}  // namespace loam\r\n"]
[38.575547, "o", "### /app/cpp/src/row.cpp\r\n"]
[38.577257, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4"]
[38.577268, "o", "\tnamespace {\r\n     5\t\r\n     6\tbool is_live(const Cell& cell) {\r\n"]
[38.577325, "o", "     7\t    if (cell.origin == Origin::Retired) {\r\n     8\t        return false;\r\n     9\t    }\r\n    10\t    if (cell.origin == Origin::Inherited) {\r\n    11\t        return true;\r\n    12\t    }\r\n    13\t    return cell.present != 0;\r\n"]
[38.577354, "o", "    14\t}\r\n    15\t\r\n    16\tbool matches(const Cell& cell, const Probe& probe) {\r\n    17\t    switch (probe.op) {\r\n    18\t        case Op::All:\r\n    19\t            return true;\r\n    20\t        case Op::Equal:\r\n    21\t            return cell.amount == probe.x;\r\n    22\t        case Op::Range:\r\n    23\t            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n    24\t        case Op::IsNull:\r\n"]
[38.57739, "o", "    25\t            return false;\r\n    26\t        case Op::RegionEqual:\r\n    27\t            return cell.region == probe.text;\r\n    28\t    }\r\n    29\t    return false;\r\n    30\t}\r\n    31\t\r\n    32\t}  // namespace\r\n"]
[38.577439, "o", "    33\t\r\n    34\tTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    35\t    Tally tally;\r\n    36\t    if (!c.read) {\r\n    37\t        return tally;\r\n    38\t    }\r\n    39\t    tally.pages_read = 1;\r\n    40\t    for (const auto& cell : a.cells) {\r\n    41\t        const bool live = is_live(cell);\r\n    42\t        if (b.op == Op::IsNull) {\r\n"]
[38.577475, "o", "    43\t            if (!live) {\r\n    44\t                ++tally.row_count;\r\n    45\t            }\r\n    46\t            continue;\r\n    47\t        }\r\n    48\t        if (live && matches(cell, b)) {\r\n    49\t            ++tally.row_count;\r\n    50\t            tally.sum_amount += cell.amount;\r\n    51\t        }\r\n    52\t    }\r\n    53\t    return tally;\r\n    54\t}\r\n"]
[38.577505, "o", "    55\t\r\n    56\t}  // namespace loam\r\n"]
[38.57778, "o", "### /app/cpp/src/harbor/veil.cpp\r\n"]
[38.579034, "o", "     1\t#include \"loam/plan.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4\t\r\n     5\tGate turn_b(const Slab& a, const Probe& b) {\r\n"]
[38.579044, "o", "     6\t    if (!b.skipping) {\r\n     7\t        return {true, \"full\"};\r\n     8\t    }\r\n"]
[38.579096, "o", "     9\t    if (b.op == Op::All) {\r\n    10\t        return {true, \"all\"};\r\n    11\t    }\r\n    12\t    if (b.op == Op::IsNull) {\r\n    13\t        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    14\t    }\r\n    15\t    if (b.op == Op::RegionEqual) {\r\n    16\t        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n"]
[38.579108, "o", "    17\t        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    18\t    }\r\n    19\t\r\n    20\t    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    21\t    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    22\t    const bool read = !(right < a.low || left > a.high);\r\n    23\t    return {read, read ? \"range-hit\" : \"range-away\"};\r\n    24\t}\r\n    25\t\r\n    26\t}  // namespace loam\r\n"]
