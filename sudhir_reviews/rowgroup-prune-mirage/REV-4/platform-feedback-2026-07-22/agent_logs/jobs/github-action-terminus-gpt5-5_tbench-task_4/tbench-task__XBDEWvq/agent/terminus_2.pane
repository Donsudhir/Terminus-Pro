     7	#include <sys/wait.h>
     8	#include <unistd.h>
     9	#include <vector>
    10	
    11	namespace {
    12	
    13	int run_ingest(const char* input, const char* output) {
    14	    const pid_t child = fork();
    15	    if (child == -1) {
    16	        throw std::runtime_error("fork failed");
    17	    }
    18	    if (child == 0) {
    19	        execl("/app/bin/loam-ingest", "loam-ingest", input, output, nullptr);
    20	        _exit(127);
    21	    }
    22	    int status = 0;
    23	    if (waitpid(child, &status, 0) == -1) {
    24	        throw std::runtime_error("waitpid failed");
    25	    }
    26	    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;
    27	}
    28	
    29	}  // namespace
    30	
    31	int main(int argc, char** argv) {
    32	    try {
    33	        if (argc == 4 && std::string(argv[1]) == "audit") {
    34	            const auto specs = loam::load_cases(argv[2]);
    35	            std::vector<loam::CaseResult> results;
    36	            results.reserve(specs.size());
    37	            for (const auto& spec : specs) {
    38	                results.push_back(loam::run_case(spec));
    39	            }
    40	            loam::write_report(argv[3], results);
    41	            return 0;
    42	        }
    43	        if (argc == 4 && std::string(argv[1]) == "ingest") {
    44	            return run_ingest(argv[2], argv[3]);
    45	        }
    46	        if (argc == 3 && std::string(argv[1]) == "inspect") {
    47	            const auto slabs = loam::load_store(argv[2]);
    48	            for (const auto& slab : slabs) {
    49	                std::cout << slab.id << '|' << static_cast<int>(slab.generation)
    50	                          << '|' << slab.low << '|' << slab.high << '|'
    51	                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()
    52	                          << '\n';
    53	            }
    54	            return 0;
    55	        }
    56	        std::cerr << "usage: loam audit <case-directory> <report-path>\n"
    57	                  << "       loam ingest <csv> <store-directory>\n"
    58	                  << "       loam inspect <store>\n";
    59	        return 2;
    60	    } catch (const std::exception& error) {
    61	        std::cerr << "loam: " << error.what() << '\n';
    62	        return 1;
    63	    }
    64	}
