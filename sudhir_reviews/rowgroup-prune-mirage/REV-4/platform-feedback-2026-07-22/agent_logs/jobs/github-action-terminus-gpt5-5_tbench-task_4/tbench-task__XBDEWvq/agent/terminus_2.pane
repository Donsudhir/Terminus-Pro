### /app/cpp/src/lattice/rill.cpp
     1	#include "loam/exec.hpp"
     2	
     3	#include <cstddef>
     4	#include <vector>
     5	
     6	namespace loam {
     7	
     8	Tally sweep_c(const Slab& a, const Probe& b, const Gate& c) {
     9	    Tally tally;
    10	    if (!c.read) {
    11	        return tally;
    12	    }
    13	    tally.pages_read = 1;
    14	
    15	    const std::size_t count = a.amount_lane.size();
    16	    std::vector<unsigned char> admit(count, 0);
    17	    for (std::size_t i = 0; i < count; ++i) {
    18	        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;
    19	    }
    20	
    21	    if (b.op == Op::IsNull) {
    22	        for (std::size_t i = 0; i < count; ++i) {
    23	            if (admit[i] == 0) {
    24	                ++tally.row_count;
    25	            }
    26	        }
    27	        return tally;
    28	    }
    29	
    30	    for (std::size_t i = 0; i < count; ++i) {
    31	        if (admit[i] == 0) {
    32	            continue;
    33	        }
    34	        bool keep = false;
    35	        switch (b.op) {
    36	            case Op::All:
    37	                keep = true;
    38	                break;
    39	            case Op::Equal:
    40	                keep = a.amount_lane[i] == b.x;
    41	                break;
    42	            case Op::Range:
    43	                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;
    44	                break;
    45	            case Op::IsNull:
    46	                keep = false;
    47	                break;
    48	            case Op::RegionEqual:
    49	                keep = a.region_lane[i] == b.text;
    50	                break;
    51	        }
    52	        if (keep) {
    53	            ++tally.row_count;
    54	            tally.sum_amount += a.amount_lane[i];
    55	        }
    56	    }
    57	    return tally;
    58	}
    59	
    60	}  // namespace loam
### /app/cpp/src/main.cpp
     1	#include "loam/report.hpp"
     2	#include "loam/store.hpp"
     3	
     4	#include <filesystem>
     5	#include <iostream>
     6	#include <stdexcept>
     7	#include <sys/wait.h>
     8	#include <unistd.h>
     9	#include <vector>
    10	
    11	namespace {
    12	
    13	int run_ingest(const char* input, const char* output) {
    14	    const pid_t child = fork();
    15	    if (child == -1) {
    16	        throw std::runtime_error("fork failed");
    17	    }
    18	    if (child == 0) {
    19	        execl("/app/bin/loam-ingest", "loam-ingest", input, output, nullptr);
    20	        _exit(127);
    21	    }
    22	    int status = 0;
    23	    if (waitpid(child, &status, 0) == -1) {
    24	        throw std::runtime_error("waitpid failed");
    25	    }
    26	    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;
    27	}
    28	
    29	}  // namespace
    30	
    31	int main(int argc, char** argv) {
    32	    try {
    33	        if (argc == 4 && std::string(argv[1]) == "audit") {
    34	            const auto specs = loam::load_cases(argv[2]);
    35	            std::vector<loam::CaseResult> results;
    36	            results.reserve(specs.size());
    37	            for (const auto& spec : specs) {
    38	                results.push_back(loam::run_case(spec));
    39	            }
    40	            loam::write_report(argv[3], results);
    41	            return 0;
    42	        }
    43	        if (argc == 4 && std::string(argv[1]) == "ingest") {
    44	            return run_ingest(argv[2], argv[3]);
    45	        }
    46	        if (argc == 3 && std::string(argv[1]) == "inspect") {
    47	            const auto slabs = loam::load_store(argv[2]);
    48	            for (const auto& slab : slabs) {
    49	                std::cout << slab.id << '|' << static_cast<int>(slab.generation)
    50	                          << '|' << slab.low << '|' << slab.high << '|'
    51	                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()
    52	                          << '\n';
    53	            }
    54	            return 0;
    55	        }
    56	        std::cerr << "usage: loam audit <case-directory> <report-path>\n"
    57	                  << "       loam ingest <csv> <store-directory>\n"
    58	                  << "       loam inspect <store>\n";
    59	        return 2;
    60	    } catch (const std::exception& error) {
    61	        std::cerr << "loam: " << error.what() << '\n';
    62	        return 1;
    63	    }
    64	}
### /app/cpp/src/parse.cpp
     1	#include "loam/store.hpp"
     2	
     3	#include <algorithm>
     4	#include <fstream>
     5	#include <stdexcept>
     6	#include <string>
     7	
     8	namespace loam {
     9	namespace {
    10	
    11	std::vector<std::string> split(const std::string& line) {
    12	    std::vector<std::string> fields;
    13	    std::size_t start = 0;
    14	    while (true) {
    15	        const auto end = line.find('|', start);
    16	        fields.push_back(line.substr(start, end - start));
    17	        if (end == std::string::npos) {
    18	            break;
    19	        }
    20	        start = end + 1;
    21	    }
    22	    return fields;
    23	}
    24	
    25	Op parse_op(const std::string& value) {
    26	    if (value == "all") return Op::All;
    27	    if (value == "eq") return Op::Equal;
    28	    if (value == "range") return Op::Range;
    29	    if (value == "isnull") return Op::IsNull;
    30	    if (value == "region_eq") return Op::RegionEqual;
    31	    throw std::runtime_error("unknown operation: " + value);
    32	}
    33	
    34	Lane parse_lane(const std::string& value) {
    35	    if (value == "row") return Lane::Row;
    36	    if (value == "batch") return Lane::Batch;
    37	    throw std::runtime_error("unknown path: " + value);
    38	}
    39	
    40	}  // namespace
    41	
    42	std::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {
    43	    std::vector<std::filesystem::path> paths;
    44	    for (const auto& entry : std::filesystem::directory_iterator(directory)) {
    45	        if (entry.is_regular_file() && entry.path().extension() == ".case") {
    46	            paths.push_back(entry.path());
    47	        }
    48	    }
    49	    std::sort(paths.begin(), paths.end());
    50	
    51	    std::vector<CaseSpec> cases;
    52	    for (const auto& path : paths) {
    53	        std::ifstream input(path);
    54	        if (!input) {
    55	            throw std::runtime_error("cannot open case file: " + path.string());
    56	        }
    57	        std::string line;
    58	        while (std::getline(input, line)) {
    59	            if (line.empty() || line[0] == '#') {
    60	                continue;
    61	            }
    62	            const auto fields = split(line);
    63	            if (fields.size() != 8) {
    64	                throw std::runtime_error("bad case row in " + path.string());
    65	            }
    66	            Probe probe;
    67	            probe.op = parse_op(fields[2]);
    68	            if (probe.op == Op::RegionEqual) {
    69	                probe.text = fields[3];
    70	            } else {
    71	                probe.x = std::stoll(fields[3]);
    72	                probe.y = std::stoll(fields[4]);
    73	            }
    74	            probe.lane = parse_lane(fields[5]);
    75	            probe.skipping = fields[6] == "1";
    76	            cases.push_back({fields[0], fields[1], std::move(probe)});
    77	        }
    78	    }
    79	    return cases;
    80	}
    81	
    82	}  // namespace loam
### /app/cpp/src/report.cpp
     1	#include "loam/report.hpp"
     2	
     3	#include <fstream>
     4	#include <sstream>
     5	#include <stdexcept>
     6	
     7	namespace loam {
     8	namespace {
     9	
    10	std::string escape_json(const std::string& value) {
    11	    std::string out;
    12	    for (const char ch : value) {
    13	        if (ch == '"' || ch == '\\') {
    14	            out.push_back('\\');
    15	        }
    16	        out.push_back(ch);
    17	    }
    18	    return out;
    19	}
    20	
    21	std::string cases_json(const std::vector<CaseResult>& cases) {
    22	    std::ostringstream out;
    23	    out << '[';
    24	    for (std::size_t i = 0; i < cases.size(); ++i) {
    25	        if (i != 0) out << ',';
    26	        const auto& item = cases[i];
    27	        out << "{\"case_id\":\"" << escape_json(item.case_id)
    28	            << "\",\"row_count\":" << item.tally.row_count
    29	            << ",\"sum_amount\":" << item.tally.sum_amount
    30	            << ",\"pages_total\":" << item.pages_total
    31	            << ",\"pages_read\":" << item.tally.pages_read
    32	            << ",\"path\":\"" << lane_name(item.lane)
    33	            << "\",\"skipping\":" << (item.skipping ? "true" : "false")
    34	            << '}';
    35	    }
    36	    out << ']';
    37	    return out.str();
    38	}
    39	
    40	}  // namespace
    41	
    42	std::string lane_name(const Lane lane) {
    43	    return lane == Lane::Batch ? "batch" : "row";
    44	}
    45	
    46	void write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {
    47	    if (path.has_parent_path()) {
    48	        std::filesystem::create_directories(path.parent_path());
    49	    }
    50	    const std::string body = cases_json(cases);
    51	    const std::string digest = digest_hex(body);
    52	    std::ofstream output(path, std::ios::binary | std::ios::trunc);
    53	    if (!output) {
    54	        throw std::runtime_error("cannot write report: " + path.string());
    55	    }
    56	    output << "{\"status\":\"complete\",\"cases\":" << body
    57	           << ",\"digest\":\"" << digest << "\"}\n";
    58	}
    59	
    60	}  // namespace loam
### /app/cpp/src/row.cpp
     1	#include "loam/exec.hpp"
     2	
     3	namespace loam {
     4	namespace {
     5	
     6	bool is_live(const Cell& cell) {
     7	    if (cell.origin == Origin::Retired) {
     8	        return false;
     9	    }
    10	    if (cell.origin == Origin::Inherited) {
    11	        return true;
    12	    }
    13	    return cell.present != 0;
    14	}
    15	
    16	bool matches(const Cell& cell, const Probe& probe) {
    17	    switch (probe.op) {
    18	        case Op::All:
    19	            return true;
    20	        case Op::Equal:
    21	            return cell.amount == probe.x;
    22	        case Op::Range:
    23	            return cell.amount >= probe.x && cell.amount <= probe.y;
    24	        case Op::IsNull:
    25	            return false;
    26	        case Op::RegionEqual:
    27	            return cell.region == probe.text;
    28	    }
    29	    return false;
    30	}
    31	
    32	}  // namespace
    33	
    34	Tally walk_row(const Slab& a, const Probe& b, const Gate& c) {
    35	    Tally tally;
    36	    if (!c.read) {
    37	        return tally;
    38	    }
    39	    tally.pages_read = 1;
    40	    for (const auto& cell : a.cells) {
    41	        const bool live = is_live(cell);
    42	        if (b.op == Op::IsNull) {
    43	            if (!live) {
    44	                ++tally.row_count;
    45	            }
    46	            continue;
    47	        }
    48	        if (live && matches(cell, b)) {
    49	            ++tally.row_count;
    50	            tally.sum_amount += cell.amount;
    51	        }
    52	    }
    53	    return tally;
    54	}
    55	
    56	}  // namespace loam
### /app/cpp/src/store.cpp
     1	#include "loam/store.hpp"
     2	
     3	#include "loam/exec.hpp"
     4	#include "loam/plan.hpp"
     5	
     6	#include <fstream>
     7	#include <stdexcept>
     8	#include <string>
     9	
    10	namespace loam {
    11	namespace {
    12	
    13	std::vector<std::string> split(const std::string& line) {
    14	    std::vector<std::string> fields;
    15	    std::size_t start = 0;
    16	    while (true) {
    17	        const auto end = line.find('|', start);
    18	        fields.push_back(line.substr(start, end - start));
    19	        if (end == std::string::npos) {
    20	            break;
    21	        }
    22	        start = end + 1;
    23	    }
    24	    return fields;
    25	}
    26	
    27	}  // namespace
    28	
    29	std::vector<Slab> load_store(const std::filesystem::path& path) {
    30	    std::ifstream input(path);
    31	    if (!input) {
    32	        throw std::runtime_error("cannot open store: " + path.string());
    33	    }
    34	
    35	    std::vector<Slab> slabs;
    36	    std::string line;
    37	    while (std::getline(input, line)) {
    38	        if (line.empty() || line.rfind("H|", 0) == 0) {
    39	            continue;
    40	        }
    41	        const auto page = split(line);
    42	        if (page.size() != 9 || page[0] != "P") {
    43	            throw std::runtime_error("bad page record in " + path.string());
    44	        }
    45	        Slab slab;
    46	        slab.id = std::stoull(page[1]);
    47	        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));
    48	        slab.low = std::stoll(page[3]);
    49	        slab.high = std::stoll(page[4]);
    50	        slab.has_absent = page[5] == "1";
    51	        slab.region_low = page[6];
    52	        slab.region_high = page[7];
    53	        const auto row_count = std::stoull(page[8]);
    54	        for (std::size_t i = 0; i < row_count; ++i) {
    55	            if (!std::getline(input, line)) {
    56	                throw std::runtime_error("short page in " + path.string());
    57	            }
    58	            const auto row = split(line);
    59	            if (row.size() != 5 || row[0] != "R") {
    60	                throw std::runtime_error("bad row record in " + path.string());
    61	            }
    62	            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));
    63	            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));
    64	            const auto amount = std::stoll(row[3]);
    65	            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});
    66	            slab.presence_lane.push_back(presence);
    67	            slab.origin_lane.push_back(origin);
    68	            slab.amount_lane.push_back(amount);
    69	            slab.region_lane.push_back(row[4]);
    70	        }
    71	        slabs.push_back(std::move(slab));
    72	    }
    73	    return slabs;
    74	}
    75	
    76	CaseResult run_case(const CaseSpec& spec) {
    77	    const auto slabs = load_store(spec.store_path);
    78	    Tally total;
    79	    for (const auto& slab : slabs) {
    80	        const Gate gate = turn_b(slab, spec.probe);
    81	        const auto label = turn_d(gate, spec.probe);
    82	        (void)label;
    83	        const Tally part = spec.probe.lane == Lane::Batch
    84	            ? sweep_c(slab, spec.probe, gate)
    85	            : walk_row(slab, spec.probe, gate);
    86	        total = sweep_e(total, part);
    87	    }
    88	    return {
    89	        spec.case_id,
    90	        total,
    91	        static_cast<std::int64_t>(slabs.size()),
    92	        spec.probe.lane,
    93	        spec.probe.skipping,
    94	    };
    95	}
