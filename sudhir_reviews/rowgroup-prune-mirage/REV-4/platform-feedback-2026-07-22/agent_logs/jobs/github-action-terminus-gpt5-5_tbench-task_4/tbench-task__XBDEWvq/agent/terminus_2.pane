     1	#include "loam/store.hpp"
     2	
     3	#include <algorithm>
     4	#include <fstream>
     5	#include <stdexcept>
     6	#include <string>
     7	
     8	namespace loam {
     9	namespace {
    10	
    11	std::vector<std::string> split(const std::string& line) {
    12	    std::vector<std::string> fields;
    13	    std::size_t start = 0;
    14	    while (true) {
    15	        const auto end = line.find('|', start);
    16	        fields.push_back(line.substr(start, end - start));
    17	        if (end == std::string::npos) {
    18	            break;
    19	        }
    20	        start = end + 1;
    21	    }
    22	    return fields;
    23	}
    24	
    25	Op parse_op(const std::string& value) {
    26	    if (value == "all") return Op::All;
    27	    if (value == "eq") return Op::Equal;
    28	    if (value == "range") return Op::Range;
    29	    if (value == "isnull") return Op::IsNull;
    30	    if (value == "region_eq") return Op::RegionEqual;
    31	    throw std::runtime_error("unknown operation: " + value);
    32	}
    33	
    34	Lane parse_lane(const std::string& value) {
    35	    if (value == "row") return Lane::Row;
    36	    if (value == "batch") return Lane::Batch;
    37	    throw std::runtime_error("unknown path: " + value);
    38	}
    39	
    40	}  // namespace
    41	
    42	std::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {
    43	    std::vector<std::filesystem::path> paths;
    44	    for (const auto& entry : std::filesystem::directory_iterator(directory)) {
    45	        if (entry.is_regular_file() && entry.path().extension() == ".case") {
    46	            paths.push_back(entry.path());
    47	        }
    48	    }
    49	    std::sort(paths.begin(), paths.end());
    50	
    51	    std::vector<CaseSpec> cases;
    52	    for (const auto& path : paths) {
    53	        std::ifstream input(path);
    54	        if (!input) {
    55	            throw std::runtime_error("cannot open case file: " + path.string());
    56	        }
    57	        std::string line;
    58	        while (std::getline(input, line)) {
    59	            if (line.empty() || line[0] == '#') {
    60	                continue;
    61	            }
    62	            const auto fields = split(line);
    63	            if (fields.size() != 8) {
    64	                throw std::runtime_error("bad case row in " + path.string());
    65	            }
    66	            Probe probe;
    67	            probe.op = parse_op(fields[2]);
    68	            if (probe.op == Op::RegionEqual) {
    69	                probe.text = fields[3];
    70	            } else {
    71	                probe.x = std::stoll(fields[3]);
    72	                probe.y = std::stoll(fields[4]);
    73	            }
    74	            probe.lane = parse_lane(fields[5]);
    75	            probe.skipping = fields[6] == "1";
    76	            cases.push_back({fields[0], fields[1], std::move(probe)});
    77	        }
    78	    }
    79	    return cases;
    80	}
    81	
    82	}  // namespace loam
