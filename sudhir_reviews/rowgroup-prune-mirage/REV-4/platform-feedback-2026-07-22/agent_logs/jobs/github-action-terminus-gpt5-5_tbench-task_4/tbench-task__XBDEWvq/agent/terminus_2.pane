     1	use crate::model::{FoldErr, Mark};
     2	
     3	pub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {
     4	    if a.is_empty() {
     5	        return Err(FoldErr::Empty);
     6	    }
     7	    if a.len() != b.len() || a.len() != c.len() {
     8	        return Err(FoldErr::Shape);
     9	    }
    10	
    11	    let mut low = a[0];
    12	    let mut high = a[0];
    13	    let mut has_absent = false;
    14	    for (value, present) in a.iter().zip(b.iter()) {
    15	        low = low.min(*value);
    16	        high = high.max(*value);
    17	        has_absent |= *present == 0;
    18	    }
    19	
    20	    Ok(Mark {
    21	        low,
    22	        high,
    23	        has_absent,
    24	    })
    25	}
