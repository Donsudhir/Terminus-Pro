''','''    const std::int64_t left = b.x;
    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;

    // Generation 3 writers record low/high over the live-value domain.  Some
    // archived generation-2 slabs carry mixed lanes and incomplete numeric
    // markers (for example markers copied from absent/legacy sentinels rather
    // than live amounts).  Readers must not rewrite those artifacts, so keep
    // the fast numeric gate for faithful slabs and open older suspect slabs for
    // exact row/lattice evaluation.
    if (a.generation < 3 && a.has_absent) {
        return {true, "legacy-open"};
    }

    const bool read = !(right < a.low || left > a.high);
    return {read, read ? "range-hit" : "range-away"};
''')
