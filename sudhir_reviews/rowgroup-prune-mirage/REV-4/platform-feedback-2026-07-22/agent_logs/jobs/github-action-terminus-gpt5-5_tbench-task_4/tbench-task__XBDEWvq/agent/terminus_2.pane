     1	#include "loam/report.hpp"
     2	
     3	#include <cstdint>
     4	#include <iomanip>
     5	#include <sstream>
     6	
     7	namespace loam {
     8	
     9	std::string digest_hex(const std::string& text) {
    10	    std::uint64_t value = 1469598103934665603ULL;
    11	    for (const unsigned char byte : text) {
    12	        value ^= byte;
    13	        value *= 1099511628211ULL;
    14	    }
    15	    std::ostringstream out;
    16	    out << std::hex << std::setfill('0') << std::setw(16) << value;
    17	    return out.str();
    18	}
    19	
    20	}  // namespace loam
