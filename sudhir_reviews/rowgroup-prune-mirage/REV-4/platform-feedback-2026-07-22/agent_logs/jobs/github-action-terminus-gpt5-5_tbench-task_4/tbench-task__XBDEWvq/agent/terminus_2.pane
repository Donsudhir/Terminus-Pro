     4	
     5	std::string turn_d(const Gate& a, const Probe& b) {
     6	    const char* lane = b.lane == Lane::Batch ? "batch" : "row";
     7	    return std::string(lane) + ":" + (a.read ? "open:" : "closed:") + a.note;
     8	}
     9	
