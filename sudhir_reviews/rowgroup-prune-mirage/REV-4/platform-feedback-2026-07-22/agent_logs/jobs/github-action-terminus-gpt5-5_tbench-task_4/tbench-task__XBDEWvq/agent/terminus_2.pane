    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {
        let live = *origin != crate::model::RUNE_VOID && *present != 0;
        if live {
            low = Some(low.map_or(*value, |old| old.min(*value)));
            high = Some(high.map_or(*value, |old| old.max(*value)));
        } else {
            has_absent = true;
        }
    }

    Ok(Mark {
        low: low.unwrap_or(0),
        high: high.unwrap_or(0),
        has_absent,
    })
''')
