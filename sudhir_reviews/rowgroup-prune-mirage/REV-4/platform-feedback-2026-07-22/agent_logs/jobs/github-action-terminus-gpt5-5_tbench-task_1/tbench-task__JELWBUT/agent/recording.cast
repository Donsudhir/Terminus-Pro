[21.025797, "o", "--- store.cpp\r\n"]
[21.027087, "o", "#include \"loam/store.hpp\"\r\n\r\n#include \"loam/exec.hpp\"\r\n#include \"loam/plan.hpp\"\r\n\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n"]
[21.027144, "o", "\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<Slab> load_store(const std::filesystem::path& path) {\r\n    std::ifstream input(path);\r\n    if (!input) {\r\n        throw std::runtime_error(\"cannot open store: \" + path.string());\r\n    }\r\n"]
[21.027172, "o", "\r\n    std::vector<Slab> slabs;\r\n    std::string line;\r\n    while (std::getline(input, line)) {\r\n        if (line.empty() || line.rfind(\"H|\", 0) == 0) {\r\n            continue;\r\n        }\r\n        const auto page = split(line);\r\n        if (page.size() != 9 || page[0] != \"P\") {\r\n            throw std::runtime_error(\"bad page record in \" + path.string());\r\n        }\r\n        Slab slab;\r\n        slab.id = std::stoull(page[1]);\r\n        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n        slab.low = std::stoll(page[3]);\r\n        slab.high = std::stoll(page[4]);\r\n        slab.has_absent = page[5] == \"1\";\r\n        slab.region_low = page[6];\r\n        slab.region_high = page[7];\r\n        const auto row_count = std::stoull(page[8]);\r\n        for (std::size_t i = 0; i < row_count; ++i) {\r\n"]
[21.027197, "o", "            if (!std::getline(input, line)) {\r\n                throw std::runtime_error(\"short page in \" + path.string());\r\n            }\r\n            const auto row = split(line);\r\n            if (row.size() != 5 || row[0] != \"R\") {\r\n                throw std::runtime_error(\"bad row record in \" + path.string());\r\n            }\r\n            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));\r\n            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));\r\n            const auto amount = std::stoll(row[3]);\r\n            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});\r\n            slab.presence_lane.push_back(presence);\r\n"]
[21.02723, "o", "            slab.origin_lane.push_back(origin);\r\n            slab.amount_lane.push_back(amount);\r\n            slab.region_lane.push_back(row[4]);\r\n        }\r\n        slabs.push_back(std::move(slab));\r\n    }\r\n    return slabs;\r\n}\r\n\r\nCaseResult run_case(const CaseSpec& spec) {\r\n    const auto slabs = load_store(spec.store_path);\r\n    Tally total;\r\n    for (const auto& slab : slabs) {\r\n        const Gate gate = turn_b(slab, spec.probe);\r\n        const auto label = turn_d(gate, spec.probe);\r\n        (void)label;\r\n"]
[21.027253, "o", "        const Tally part = spec.probe.lane == Lane::Batch\r\n            ? sweep_c(slab, spec.probe, gate)\r\n            : walk_row(slab, spec.probe, gate);\r\n        total = sweep_e(total, part);\r\n    }\r\n    return {\r\n        spec.case_id,\r\n        total,\r\n        static_cast<std::int64_t>(slabs.size()),\r\n        spec.probe.lane,\r\n        spec.probe.skipping,\r\n"]
[21.027274, "o", "    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.027502, "o", "\u001b[?2004h"]
[21.027526, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[21.379643, "i", "echo '--- row.cpp'; sed -n '1,260p' cpp/src/row.cpp\n"]
[21.38272, "o", "echo '--- row.cpp'; sed -n '1,260p' cpp/src/row.cpp\r\n\u001b[?2004l\r--- row.cpp\r\n"]
[21.383898, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nbool is_live(const Cell& cell) {\r\n    if (cell.origin == Origin::Retired) {\r\n        return false;\r\n    }\r\n    if (cell.origin == Origin::Inherited) {\r\n        return true;\r\n    }\r\n    return cell.present != 0;\r\n}\r\n\r\nbool matches(const Cell& cell, const Probe& probe) {\r\n    switch (probe.op) {\r\n        case Op::All:\r\n            return true;\r\n        case Op::Equal:\r\n            return cell.amount == probe.x;\r\n        case Op::Range:\r\n            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n"]
[21.384057, "o", "        case Op::IsNull:\r\n            return false;\r\n        case Op::RegionEqual:\r\n            return cell.region == probe.text;\r\n    }\r\n    return false;\r\n}\r\n\r\n}  // namespace\r\n\r\nTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n    for (const auto& cell : a.cells) {\r\n        const bool live = is_live(cell);\r\n        if (b.op == Op::IsNull) {\r\n            if (!live) {\r\n                ++tally.row_count;\r\n            }\r\n            continue;\r\n        }\r\n        if (live && matches(cell, b)) {\r\n            ++tally.row_count;\r\n            tally.sum_amount += cell.amount;\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[21.384228, "o", "\u001b[?2004h"]
[21.384281, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[21.700934, "i", "echo '--- parse.cpp'; sed -n '1,260p' cpp/src/parse.cpp\n"]
[21.701395, "o", "echo '--- parse.cpp'; sed -n '1,260p' cpp/src/parse.cpp\r\n\u001b[?2004l\r"]
[21.701463, "o", "--- parse.cpp\r\n"]
[21.703746, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n"]
[21.70378, "o", "#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\n"]
[21.703801, "o", "std::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n"]
[21.70383, "o", "    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n"]
[21.703851, "o", "    }\r\n    return fields;\r\n"]
[21.703871, "o", "}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n"]
[21.703887, "o", "    if (value == \"range\") return Op::Range;\r\n"]
[21.703906, "o", "    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n"]
[21.703926, "o", "    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);"]
[21.703945, "o", "\r\n}\r\n"]
[21.703965, "o", "\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {"]
[21.703981, "o", "\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n"]
[21.703998, "o", "        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n"]
[21.704014, "o", "\r\n    std::vector<CaseSpec> cases;\r\n"]
[21.70403, "o", "    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n"]
[21.704045, "o", "        std::string line;\r\n        while (std::getline(input, line)) {\r\n"]
[21.704064, "o", "            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n"]
[21.70408, "o", "                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n"]
[21.7041, "o", "            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n"]
[21.704116, "o", "                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n"]
[21.704133, "o", "            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n"]
[21.704149, "o", "        }\r\n    }\r\n    return cases;\r\n}\r\n"]
[21.704164, "o", "\r\n}  // namespace loam\r\n"]
