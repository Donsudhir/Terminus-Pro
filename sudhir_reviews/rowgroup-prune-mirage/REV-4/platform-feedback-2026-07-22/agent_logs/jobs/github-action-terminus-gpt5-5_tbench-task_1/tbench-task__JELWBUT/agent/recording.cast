[20.665174, "o", "enum class Origin : std::uint8_t { Retired = 0, Inherited = 1, Current = 2 };\r\n\r\nstruct Cell {\r\n    std::uint8_t present{};\r\n    Origin origin{Origin::Current};\r\n    std::int64_t amount{};"]
[20.665193, "o", "\r\n    std::string region;\r\n};\r\n\r\nstruct Slab {\r\n    std::size_t id{};\r\n    std::uint8_t generation{};\r\n    std::int64_t low{};\r\n    std::int64_t high{};\r\n    bool has_absent{};\r\n    std::string region_low;\r\n    std::string region_high;\r\n    std::vector<Cell> cells;\r\n"]
