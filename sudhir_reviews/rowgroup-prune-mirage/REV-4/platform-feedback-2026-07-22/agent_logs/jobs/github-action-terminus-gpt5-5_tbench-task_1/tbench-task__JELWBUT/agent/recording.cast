[20.665239, "o", "};\r\n\r\nenum class Op { All, Equal, Range, IsNull, RegionEqual };\r\nenum class Lane { Row, Batch };\r\n\r\nstruct Probe {\r\n    Op op{Op::All};\r\n    std::int64_t x{};\r\n    std::int64_t y{};\r\n    std::string text;\r\n    Lane lane{Lane::Row};\r\n    bool skipping{};\r\n};\r\n"]
