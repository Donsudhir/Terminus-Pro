[77.784612, "o", "cat > rust/src/ember/fold.rs <<'RS'\r\n\u001b[?2004l\r\u001b[?2004h> use crate::model::{FoldErr, Mark, RUNE_FIXED, RUNE_VOID};\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn is_live(present: u8, origin: u8) -> bool {\r\n\u001b[?2004l\r\u001b[?2004h>     if origin == RUNE_VOID {\r\n\u001b[?2004l\r\u001b[?2004h>         return false;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if origin == RUNE_FIXED {\r\n\u001b[?2004l\r\u001b[?2004h>         return true;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     present != 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.786607, "o", "pub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n\u001b[?2004l\r\u001b[?2004h>     if a.is_empty() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(FoldErr::Empty);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if a.len() != b.len() || a.len() != c.len() {\r\n\u001b[?2004l\r\u001b[?2004h>         return Err(FoldErr::Shape);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     let mut low = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut high = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut saw_live = false;\r\n\u001b[?2004l\r\u001b[?2004h>     let mut has_absent = false;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\r\n\u001b[?2004l\r\u001b[?2004h>         if is_live(*present, *origin) {\r\n\u001b[?2004l\r\u001b[?2004h>             if saw_live {\r\n\u001b[?2004l\r\u001b[?2004h>                 low = low.min(*value);\r\n\u001b[?2004l\r\u001b[?2004h>                 high = high.max(*value);\r\n\u001b[?2004l\r\u001b[?2004h>             } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.788613, "o", "                low = *value;\r\n\u001b[?2004l\r\u001b[?2004h>                 high = *value;\r\n\u001b[?2004l\r\u001b[?2004h>                 saw_live = true;\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r\u001b[?2004h>             has_absent = true;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if !saw_live {\r\n\u001b[?2004l\r\u001b[?2004h>         has_absent = true;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Ok(Mark {\r\n\u001b[?2004l\r\u001b[?2004h>         low,\r\n\u001b[?2004l\r\u001b[?2004h>         high,\r\n\u001b[?2004l\r\u001b[?2004h>         has_absent,\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> RS\r\n\u001b[?2004l\r"]
