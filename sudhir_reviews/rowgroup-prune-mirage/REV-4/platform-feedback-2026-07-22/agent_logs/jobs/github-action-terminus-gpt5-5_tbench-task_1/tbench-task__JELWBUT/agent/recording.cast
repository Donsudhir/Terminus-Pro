[13.780079, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <cstdint>\r\n#include <iomanip>\r\n#include <sstream>\r\n\r\nnamespace loam {\r\n\r\nstd::string digest_hex(const std::string& text) {\r\n    std::uint64_t value = 1469598103934665603ULL;\r\n    for (const unsigned char byte : text) {\r\n"]
[13.780154, "o", "        value ^= byte;\r\n        value *= 1099511628211ULL;\r\n    }\r\n    std::ostringstream out;\r\n    out << std::hex << std::setfill('0') << std::setw(16) << value;\r\n    return out.str();\r\n}\r\n\r\n"]
[13.780193, "o", "}  // namespace loam\r\n"]
[13.780351, "o", "\u001b[?2004h"]
[13.780376, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
