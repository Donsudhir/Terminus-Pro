[22.003639, "i", "echo '--- main.cpp'; sed -n '1,300p' cpp/src/main.cpp\n"]
[22.004792, "o", "echo '--- main.cpp'; sed -n '1,300p' cpp/src/main.cpp\r\n"]
[22.004808, "o", "\u001b[?2004l\r"]
[22.004864, "o", "--- main.cpp\r\n"]
[22.00867, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n\r\nnamespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n\r\nint main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n     "]
[22.008728, "o", "           results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& err"]
[22.008741, "o", "or) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[22.316021, "i", "echo '--- report.cpp'; sed -n '1,260p' cpp/src/report.cpp\n"]
[22.31622, "o", "echo '--- report.cpp'; sed -n '1,260p' cpp/src/report.cpp\r\n"]
[22.316244, "o", "\u001b[?2004l\r"]
[22.31628, "o", "--- report.cpp\r\n"]
[22.317939, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <fstream>\r\n#include <sstream>\r\n#include <stdexcept>\r\n"]
[22.317983, "o", "\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::string escape_json(const std::string& value) {\r\n    std::string out;\r\n"]
[22.318014, "o", "    for (const char ch : value) {\r\n        if (ch == '\"' || ch == '\\\\') {\r\n            out.push_back('\\\\');\r\n        }\r\n        out.push_back(ch);\r\n    }\r\n    return out;\r\n}\r\n\r\nstd::string cases_json(const std::vector<CaseResult>& cases) {\r\n    std::ostringstream out;\r\n    out << '[';\r\n    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n        if (i != 0) out << ',';\r\n        const auto& item = cases[i];\r\n        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n"]
[22.318039, "o", "            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n            << \",\\\"pages_total\\\":\" << item.pages_total\r\n            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n"]
[22.318074, "o", "            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n            << '}';\r\n    }\r\n    out << ']';\r\n    return out.str();\r\n}\r\n\r\n}  // namespace\r\n"]
[22.318096, "o", "\r\nstd::string lane_name(const Lane lane) {\r\n    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n}\r\n\r\nvoid write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n    if (path.has_parent_path()) {\r\n        std::filesystem::create_directories(path.parent_path());\r\n    }\r\n    const std::string body = cases_json(cases);\r\n    const std::string digest = digest_hex(body);\r\n    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    if (!output) {\r\n        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n"]
[22.318115, "o", "    }\r\n    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n"]
[22.318131, "o", "}\r\n\r\n}  // namespace loam\r\n"]
[22.31835, "o", "\u001b[?2004h"]
