[28.698693, "o", "\u001b[?2004l\r"]
[28.700028, "o", "\u001b[?2004h"]
[28.700075, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[29.039586, "i", "sed -n '1,220p' cpp/src/row.cpp\n"]
[29.039795, "o", "sed -n '1,220p' cpp/src/row.cpp\r\n\u001b[?2004l\r"]
[29.04182, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nbool is_live(const Cell& cell) {\r\n    if (cell.origin == Origin::Retired) {\r\n        return false;\r\n    }\r\n    if (cell.origin == Origin::Inherited) {\r\n        return true;\r\n    }\r\n    return cell.present != 0;\r\n}\r\n\r\n"]
[29.041831, "o", "bool matches(const Cell& cell, const Probe& probe) {\r\n    switch (probe.op) {\r\n        case Op::All:\r\n"]
[29.041878, "o", "            return true;\r\n        case Op::Equal:\r\n            return cell.amount == probe.x;\r\n        case Op::Range:\r\n            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n        case Op::IsNull:\r\n            return false;"]
[29.041947, "o", "\r\n        case Op::RegionEqual:\r\n            return cell.region == probe.text;\r\n    }\r\n    return false;\r\n}\r\n\r\n}  // namespace\r\n\r\nTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n    for (const auto& cell : a.cells) {\r\n        const bool live = is_live(cell);\r\n        if (b.op == Op::IsNull) {\r\n            if (!live) {\r\n                ++tally.row_count;\r\n            }\r\n            continue;\r\n        }\r\n        if (live && matches(cell, b)) {\r\n"]
[29.041981, "o", "            ++tally.row_count;\r\n            tally.sum_amount += cell.amount;\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[29.042172, "o", "\u001b[?2004h"]
[29.042198, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[29.354025, "i", "sed -n '1,220p' cpp/src/harbor/pale.cpp\nsed -n '1,220p' cpp/src/harbor/veil.cpp\n"]
[29.354197, "o", "sed -n '1,220p' cpp/src/harbor/pale.cpp\r\n\u001b[?2004l\r"]
[29.355647, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nstd::string turn_d(const Gate& a, const Probe& b) {\r\n    const char* lane = b.lane == Lane::Batch ? \"batch\" : \"row\";\r\n    return std::string(lane) + \":\" + (a.read ? \"open:\" : \"closed:\") + a.note;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[29.355909, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[29.356028, "o", "sed -n '1,220p' cpp/src/harbor/veil.cpp\r\n\u001b[?2004l\r"]
[29.357218, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n        return {true, \"full\"};\r\n    }\r\n"]
[29.357226, "o", "    if (b.op == Op::All) {\r\n        return {true, \"all\"};\r\n    }\r\n    if (b.op == Op::IsNull) {\r\n"]
[29.357278, "o", "        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n\r\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r\n}\r\n\r\n}  // namespace loam\r\n"]
[29.357468, "o", "\u001b[?2004h"]
[29.357487, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[29.678249, "i", "sed -n '1,260p' cpp/src/lattice/bay.cpp\nsed -n '1,260p' cpp/src/lattice/rill.cpp\n"]
[29.678459, "o", "sed -n '1,260p' cpp/src/lattice/bay.cpp\r\n\u001b[?2004l\r"]
[29.679878, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\n\r\n"]
[29.6799, "o", "Tally sweep_e(const Tally& a, const Tally& b) {\r\n    return {\r\n        a.row_count + b.row_count,\r\n        a.sum_amount + b.sum_amount,\r\n        a.pages_read + b.pages_read,\r\n"]
[29.679928, "o", "    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
[29.680152, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[29.680298, "o", "sed -n '1,260p' cpp/src/lattice/rill.cpp\r\n\u001b[?2004l\r"]
[29.681449, "o", "#include \"loam/exec.hpp\"\r\n\r\n#include <cstddef>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n"]
[29.681472, "o", "\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n"]
[29.681489, "o", "    tally.pages_read = 1;\r\n\r\n    const std::size_t count = a.amount_lane.size();\r\n    std::vector<unsigned char> admit(count, 0);\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    }\r\n\r\n    if (b.op == Op::IsNull) {\r\n        for (std::size_t i = 0; i < count; ++i) {\r\n            if (admit[i] == 0) {\r\n                ++tally.row_count;\r\n            }\r\n"]
[29.681507, "o", "        }\r\n        return tally;\r\n    }\r\n\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        if (admit[i] == 0) {\r\n            continue;\r\n        }\r\n        bool keep = false;\r\n        switch (b.op) {\r\n            case Op::All:\r\n                keep = true;"]
[29.681523, "o", "\r\n                break;\r\n            case Op::Equal:\r\n                keep = a.amount_lane[i] == b.x;\r\n                break;\r\n"]
[29.68154, "o", "            case Op::Range:\r\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n                break;\r\n            case Op::IsNull:\r\n                keep = false;\r\n                break;\r\n            case Op::RegionEqual:\r\n"]
[29.681557, "o", "                keep = a.region_lane[i] == b.text;\r\n                break;\r\n        }\r\n        if (keep) {\r\n            ++tally.row_count;\r\n            tally.sum_amount += a.amount_lane[i];\r\n        }\r\n    }\r\n    return tally;\r\n}"]
[29.681591, "o", "\r\n\r\n}  // namespace loam\r\n"]
[29.681776, "o", "\u001b[?2004h"]
[29.681792, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[30.024328, "i", "sed -n '1,220p' cpp/src/parse.cpp\nsed -n '1,220p' cpp/src/main.cpp\nsed -n '1,180p' cpp/src/report.cpp\n"]
[30.024494, "o", "sed -n '1,220p' cpp/src/parse.cpp\r\n\u001b[?2004l\r"]
[30.025692, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n"]
[30.025728, "o", "\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n"]
[30.025752, "o", "        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\n"]
[30.025772, "o", "Lane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n"]
[30.025807, "o", "        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;\r\n"]
[30.025829, "o", "    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n"]
[30.02586, "o", "                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n"]
[30.02588, "o", "            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[30.026113, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[30.026213, "o", "sed -n '1,220p' cpp/src/main.cpp\r\n\u001b[?2004l\r"]
[30.027186, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n"]
[30.027214, "o", "\r\nnamespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n"]
[30.027237, "o", "    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n\r\nint main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n"]
[30.027258, "o", "            std::vector<loam::CaseResult> results;\r\n            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n"]
[30.027285, "o", "            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n"]
[30.027317, "o", "                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
[30.027485, "o", "\u001b[?2004h"]
[30.02752, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[30.02761, "o", "sed -n '1,180p' cpp/src/report.cpp\r\n\u001b[?2004l\r"]
[30.028924, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <fstream>\r\n#include <sstream>\r\n#include <stdexcept>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\n"]
[30.028949, "o", "std::string escape_json(const std::string& value) {\r\n    std::string out;\r\n    for (const char ch : value) {\r\n"]
[30.028965, "o", "        if (ch == '\"' || ch == '\\\\') {\r\n            out.push_back('\\\\');\r\n        }\r\n        out.push_back(ch);\r\n    }\r\n    return out;\r\n}\r\n\r\nstd::string cases_json(const std::vector<CaseResult>& cases) {\r\n    std::ostringstream out;\r\n    out << '[';\r\n    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n        if (i != 0) out << ',';\r\n        const auto& item = cases[i];\r\n        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n"]
[30.028976, "o", "            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n            << \",\\\"pages_total\\\":\" << item.pages_total\r\n            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n            << '}';\r\n"]
[30.029092, "o", "    }\r\n    out << ']';\r\n    return out.str();\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::string lane_name(const Lane lane) {"]
[30.02913, "o", "\r\n    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n}\r\n\r\nvoid write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n    if (path.has_parent_path()) {\r\n        std::filesystem::create_directories(path.parent_path());\r\n    }\r\n    const std::string body = cases_json(cases);\r\n    const std::string digest = digest_hex(body);\r\n    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    if (!output) {\r\n        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n    }\r\n    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n}\r\n\r\n}  // namespace loam\r\n"]
[30.029232, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[34.501264, "i", "cat cpp/src/harbor/veil.cpp\n"]
[34.501423, "o", "cat cpp/src/harbor/veil.cpp\r\n\u001b[?2004l\r"]
[34.502393, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n        return {true, \"full\"};\r\n    }\r\n    if (b.op == Op::All) {\r\n        return {true, \"all\"};\r\n    }\r\n    if (b.op == Op::IsNull) {\r\n        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n\r\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r\n}\r\n\r\n}  // namespace loam\r\n"]
[34.502602, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[34.844902, "i", "cat cpp/src/lattice/bay.cpp\n"]
[34.845063, "o", "cat cpp/src/lattice/bay.cpp\r\n\u001b[?2004l\r"]
[34.846083, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\n\r\nTally sweep_e(const Tally& a, const Tally& b) {\r\n    return {\r\n        a.row_count + b.row_count,\r\n        a.sum_amount + b.sum_amount,\r\n        a.pages_read + b.pages_read,\r\n    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
[34.846295, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[35.188225, "i", "cat cpp/src/lattice/rill.cpp\n"]
[35.188412, "o", "cat cpp/src/lattice/rill.cpp\r\n\u001b[?2004l\r"]
[35.189604, "o", "#include \"loam/exec.hpp\"\r\n\r\n#include <cstddef>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n\r\n    const std::size_t count = a.amount_lane.size();\r\n    std::vector<unsigned char> admit(count, 0);\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    }\r\n\r\n    if (b.op == Op::IsNull) {\r\n        for (std::size_t i = 0; i < count; ++i) {\r\n            if (admit[i] == 0) {\r\n                ++tally.row_count;\r\n            }\r\n        }\r\n        return tally;\r\n    }\r\n\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        if (admit[i] == 0) {\r\n            continue;\r\n        }\r\n        bool keep = false;\r\n        switch (b.op) {\r\n            case Op::All:\r\n                keep = true;\r\n                break;\r\n            case Op::Equal:\r\n                keep = a.amount_lane[i] == b.x;\r\n                break;\r\n       "]
[35.189707, "o", "     case Op::Range:\r\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n                break;\r\n            case Op::IsNull:\r\n                keep = false;\r\n                break;\r\n            case Op::RegionEqual:\r\n                keep = a.region_lane[i] == b.text;\r\n                break;\r\n        }\r\n        if (keep) {\r\n            ++tally.row_count;\r\n            tally.sum_amount += a.amount_lane[i];\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[35.18982, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[35.507679, "i", "cat cpp/Makefile\ncat Makefile\ncat tools/build-all\n"]
[35.507797, "o", "cat cpp/Makefile\r\n\u001b[?2004l\r"]
[35.508914, "o", "CXX ?= g++\r\nCXXFLAGS ?= -std=c++20 -O2 -Wall -Wextra -Wpedantic -Werror -Iinclude\r\nLDFLAGS ?=\r\n\r\nSOURCES := $(shell find src -type f -name '*.cpp' | sort)\r\nOBJECTS := $(patsubst src/%.cpp,build/%.o,$(SOURCES))\r\nTARGET := build/loam\r\n\r\n.PHONY: all clean\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(OBJECTS)\r\n\t$(CXX) $(CXXFLAGS) $(OBJECTS) $(LDFLAGS) -o $@\r\n\r\nbuild/%.o: src/%.cpp\r\n\t@mkdir -p $(dir $@)\r\n\t$(CXX) $(CXXFLAGS) -c $< -o $@\r\n\r\nclean:\r\n\trm -rf build\r\n"]
[35.50911, "o", "\u001b[?2004hroot@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
[35.509162, "o", "cat Makefile\r\n\u001b[?2004l\r"]
[35.509937, "o", ".PHONY: all clean\r\n\r\nall:\r\n\t./tools/build-all\r\n\r\nclean:\r\n\t$(MAKE) -C cpp clean\r\n\trm -rf rust/target bin\r\n"]
[35.510086, "o", "\u001b[?2004h"]
[35.510106, "o", "root@240bd692-4b37-48aa-9ec3-3e3a312056af:/app# "]
