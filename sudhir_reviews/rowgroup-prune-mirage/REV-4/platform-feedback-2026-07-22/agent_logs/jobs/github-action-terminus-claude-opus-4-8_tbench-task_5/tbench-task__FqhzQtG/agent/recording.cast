[83.741458, "o", "�;\u0005�P\u0000�>\u0005�O\u0000�B\u0005�P\u0000�B\u0005�P\u0000�H~�O\u0000�I\u0005�P\u0000�J\u0005�P\u0000�L\u0005�O\u0000�L\u0005�O\u0000�L\u0005�P\u0000�M\u0005�P\u0000�M\u0005�P\u0000�N\u0005�P\u0000�N\u0005�P\u0000�O\u0005�O\u0000�O\u000f�O\u0000�O\u0005�P\u0000�O\u0005�P\u0000�O\u0005�P\u0000\u0001\u0000\u0000\u0000\u0000\u0000�\u0003]\u0001U/\u0005�\u0003\u0000?\u0005�\u0003\u0000J\u0005�\u0003\u0000l\u0005�\u0002\u0000�\u0001\u0005�\u0002\u0000�\u0001\u0005�\u0002\u0000�\u0001\u0005�\u0001\u0000�\u0002\u0005\u0000\u0000�\u0003\u0005�\u0004\u0000�\u0003\u0005�\u0004\u0000�\u0003\u0005�\u0001\u0000�\u0006\u0005�\u0007\u0000�\u0007\u0005�\u0007\u0000�\u0007\u0005�\u0007\u0000�\u0007\u0005�\u0007\u0000\u0001\u0000\u0000\u0000\u0000\u0000�\u0003�\u0001\u0001�\u0001�\u0001\u0005�\u0018\u0000�\u0002\u0005�\u0019\u0000�\u0002I�\u0018\u0000�\u0005�\u0002�\u0019\u0000�\b�\u0001�\u0019\u0000�\r\np�\u0019\u0000�\f\u0005�\u0018\u0000�\f\u0005�\u0019\u0000�\r\u0005�\u0019\u0000�\r\u0005�\u0018\u0000�\u000e\u0005\u0000\u0000�\u000e\u0005�\u0018\u0000�\u000e\u0005�\u0018\u0000�\u000f\u0005�\u0019\u0000�\u000f\u0005�\u0018\u0000�\u0010\u0005�\u0019\u0000�\u0011\u0005�\u0019\u0000�\u0012\u0005�\u0019\u0000�\u0012\u0005�\u0019\u0000�\u00139�\u0018\u0000�\u0013P�\u0018\u0000�\u0014\u0005�\u0018\u0001�\u0016\u0005�\u0019\u0000�\u0016\u0005�\u0018\u0000�\u0016\u0005�\u0018\u0000�\u0017w�\u0019\u0000�\u0018\u000f�\u0019\u0000�\u0018\u0005�\u0019\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0003-\u0001\"\u001a�\u0001\u0000\u0000�\u0002\u0005\u0000\u0000�\u0002\u0005�\u0004\u0000�\u0003\u0005�\u0004\u0000�\u0003\u0005�\u0004\u0000�\u0004\u0005�\u0001\u0000\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000��\u0001\r\n;J�\u0001\u0000�\u0001\u0005\u0000\u0000��\u0001\r\n;J�\u0001\u0000�\u0001\u0005\u0000\u0000��\u0001\u0019�\u0001\u0005�\u000b\u0000�\u0007\u0005�\u000b\u0000�\t�\u0001�\u000b\u0000�\u000b\u0005�\u000b\u0000��\u0001\u0004\u0015\u0005\u000