[178.359259, "i", "cat > /app/rust/src/ember/fold.rs << 'EOF'\nuse crate::model::{FoldErr, Mark};\n\n// Origin lane encoding (mirrors the reader): 0 = Retired, 1 = Inherited, 2 = Current.\nconst ORIGIN_RETIRED: u8 = 0;\nconst ORIGIN_INHERITED: u8 = 1;\n\nfn is_live(origin: u8, present: u8) -> bool {\n    if origin == ORIGIN_RETIRED {\n        return false;\n    }\n    if origin == ORIGIN_INHERITED {\n        return true;\n    }\n    present != 0\n}\n\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\n    if a.is_empty() {\n        return Err(FoldErr::Empty);\n    }\n    if a.len() != b.len() || a.len() != c.len() {\n        return Err(FoldErr::Shape);\n    }\n\n    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        if is_live(*origin, *present) {\n            low = Some(match low {\n                Some(current) => current.min(*value),\n                None => *value,\n            });\n       "]
[178.359375, "i", "     high = Some(match high {\n                Some(current) => current.max(*value),\n                None => *value,\n            });\n        } else {\n            has_absent = true;\n        }\n    }\n\n    match (low, high) {\n        (Some(low), Some(high)) => Ok(Mark {\n            low,\n            high,\n            has_absent,\n        }),\n        _ => Ok(Mark {\n            low: 0,\n            high: 0,\n            has_absent: true,\n        }),\n    }\n}\nEOF\n"]
