[71.083742, "o", "cat /app/rust/src/report.rs\r\n"]
[71.083775, "o", "\u001b[?2004l\r"]
[71.084739, "o", "use crate::ember::pale::Dial;\r\n\r\npub(crate) fn line(a: &Dial) -> String {\r\n    format!(\"jobs={} cells={} bytes={}\", a.jobs, a.cells, a.bytes)\r\n}\r\n"]
[71.084912, "o", "\u001b[?2004h"]
