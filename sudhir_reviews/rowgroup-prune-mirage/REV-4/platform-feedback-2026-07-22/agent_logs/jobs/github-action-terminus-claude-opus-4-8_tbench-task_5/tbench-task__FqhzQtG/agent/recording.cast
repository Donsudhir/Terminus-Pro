[83.741202, "o", "�\u0001\u0000\u0000\u0000L\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004A\u000e(�\u0005A\u000e0�\u0006n\r\n\u000e(A\u000e B\u000e\u0018B\u000e\u0010B\u000e\bI\u000b\u0003\u0002\u0001\r\n\u000e(A\u000e B\u000e\u0018B\u000e\u0010B\u000e\bG\u000bL\u0000\u0000\u0000\b\u0004\u0000\u0000PU���\u0001\u0000\u0000\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003E\u000e �\u0004A\u000e(�\u0005A\u000e0�\u0006\u0003b\u0001\r\n\u000e(G\u000e B\u000e\u0018B\u000e\u0010B\u000e\bE\u000bA\u000e(A\u000e B\u000e\u0018B\u000e\u0010B\u000e\b\u0000\u0000\u00000\u0000\u0000\u0000�\u0003\u0000\u0000�V���\u0000\u0000\u0000\u0004J\u0014A\u0000B\u000e\u0010�\u0002A\u000e\u0018�\u0003A\u000e �\u0004\u0002F\r\n\u000e\u0018A\u000e\u0010B\u000e\bC\u000b\u0000\u0000\u0000H\u0000\u0000\u0000�\u0004\u0000\u0000\fW��\f\u0005\u0000\u0000\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006N\u000e8�\u0007D\u000eP\u0003�\u0002\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bH\u000bL\u0000\u0000\u0000p\u0004\u0000\u0000�7���\u0005\u0000\u0000\u0004\\\u0014A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005D\u000e0�\u0006A\u000e8�\u0007G\u000e�\u0001\u0002C\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b$\u0000\u0000\u0000�\u0004\u0000\u0000A*��<\u0001\u0000\u0000\u0004�\u0014A\u0000\u000e�\u0001�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000P\u0005\u0000\u0000����\u0001\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0010\u0000\u0000\u0000d\u0005\u0000\u0000����\u0006\u0000\u0000\u0000\u0000\u0000\u0000\u0000h\u0000\u0000\u0000\u0010\u0005\u0000\u00000[��\u0002\t\u0000\u0000\u0004�\u0014A\u0000K\u000e\u0010�\u0002I\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007D\u000e�\u0001\u0003\u0000\u0003\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bH\u000b\u0003A\u0005\u000e\b������A\u000e�\