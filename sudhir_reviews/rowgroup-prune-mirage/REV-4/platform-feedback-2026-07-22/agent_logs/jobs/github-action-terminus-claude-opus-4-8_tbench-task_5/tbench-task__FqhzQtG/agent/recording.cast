[21.981996, "o", "#pragma once\r\n\r\n#include \"loam/types.hpp\"\r\n\r\nnamespace loam {\r\n\r\nTally walk_row(const Slab& a, const Probe& b, const Gate& c);\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c);\r\nTally sweep_e(const Tally& a, const Tally& b);\r\n\r\n}  // namespace loam\r\n"]
[21.982199, "o", "\u001b[?2004hroot@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[22.347784, "i", "cat /app/cpp/include/loam/plan.hpp\n"]
[22.347973, "o", "cat /app/cpp/include/loam/plan.hpp\r\n\u001b[?2004l\r"]
[22.349085, "o", "#pragma once\r\n\r\n#include \"loam/types.hpp\"\r\n\r\nnamespace loam {\r\n\r\nGate turn_b(const Slab& a, const Probe& b);\r\nstd::string turn_d(const Gate& a, const Probe& b);\r\n\r\n}  // namespace loam\r\n"]
[22.349257, "o", "\u001b[?2004h"]
