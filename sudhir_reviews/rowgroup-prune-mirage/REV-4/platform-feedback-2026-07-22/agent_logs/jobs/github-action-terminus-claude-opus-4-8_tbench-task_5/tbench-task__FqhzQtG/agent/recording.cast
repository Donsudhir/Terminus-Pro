[46.817455, "o", "\u001b[?2004hroot@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[57.353351, "i", "cat /app/rust/src/main.rs\n"]
[57.353476, "o", "cat /app/rust/src/main.rs\r\n\u001b[?2004l\r"]
[57.354358, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\nuse ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n\r\nfn main() {\r\n    if let Err(error) = run() {\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n    Ok(())\r\n}\r\n"]
[57.354531, "o", "\u001b[?2004h"]
[57.354563, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[57.701915, "i", "cat /app/rust/src/model.rs\n"]
[57.702184, "o", "cat /app/rust/src/model.rs\r\n"]
[57.702223, "o", "\u001b[?2004l\r"]
[57.703178, "o", "pub(crate) const RUNE_VOID: u8 = 0;\r\npub(crate) const RUNE_FIXED: u8 = 1;\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Cell {\r\n    pub origin: u8,\r\n    pub present: u8,\r\n    pub amount: i64,\r\n    pub region: String,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Mark {\r\n    pub low: i64,\r\n    pub high: i64,\r\n    pub has_absent: bool,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Page {\r\n    pub id: usize,\r\n    pub generation: u8,\r\n    pub mark: Mark,\r\n    pub region_low: String,\r\n    pub region_high: String,\r\n    pub cells: Vec<Cell>,\r\n"]
[57.703188, "o", "}\r\n\r\n#[derive(Debug)]\r\npub(crate) enum FoldErr {\r\n    Empty,\r\n    Shape,\r\n}\r\n\r\nimpl std::fmt::Display for FoldErr {\r\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n        match self {\r\n            Self::Empty => write!(f, \"empty lane set\"),\r\n            Self::Shape => write!(f, \"lane lengths differ\"),\r\n        }\r\n    }"]
[57.703229, "o", "\r\n}\r\n\r\nimpl std::error::Error for FoldErr {}\r\n"]
[57.70344, "o", "\u001b[?2004h"]
[57.703479, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[62.913079, "i", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/fold.rs\n"]
[62.913294, "o", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/fold.rs\r\n\u001b[?2004l\r"]
[62.914374, "o", "pub(crate) mod fold;\r\npub(crate) mod pale;\r\npub(crate) mod reed;\r\n"]
[62.914415, "o", "use crate::model::{FoldErr, Mark};\r\n\r\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n    if a.is_empty() {\r\n        return Err(FoldErr::Empty);\r\n    }\r\n    if a.len() != b.len() || a.len() != c.len() {\r\n        return Err(FoldErr::Shape);\r\n    }\r\n\r\n    let mut low = a[0];\r\n    let mut high = a[0];\r\n    let mut has_absent = false;\r\n    for (value, present) in a.iter().zip(b.iter()) {\r\n        low = low.min(*value);\r\n        high = high.max(*value);\r\n        has_absent |= *present == 0;\r\n    }\r\n\r\n    Ok(Mark {\r\n        low,\r\n        high,\r\n        has_absent,\r\n    })\r\n}\r\n"]
[62.914583, "o", "\u001b[?2004h"]
[62.914607, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[63.231421, "i", "cat /app/rust/src/ember/reed.rs\n"]
[63.2317, "o", "cat /app/rust/src/ember/reed.rs\r\n"]
[63.231727, "o", "\u001b[?2004l\r"]
[63.232642, "o", "use crate::ember::fold::tilt_a;\r\nuse crate::model::{Cell, FoldErr, Page};\r\n\r\npub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n    let mut pages = Vec::new();\r\n    for (id, chunk) in cells.chunks(width).enumerate() {\r\n        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n        let mark = tilt_a(&values, &present, &origins)?;\r\n\r\n        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n        regions.sort();\r\n        let region_low = regions.first().cloned().unwrap_or_default();\r\n        let region_high = regions.last().cloned().unwrap_or_default();\r\n        pages.push(Page {\r\n            id,\r\n            generation: 3,\r\n            mark,\r\n            region_low,\r\n            region_high,\r\n            cells: chunk.to_vec(),\r\n        });\r\n    }\r\n    Ok"]
[63.232666, "o", "(pages)\r\n}\r\n"]
[63.232883, "o", "\u001b[?2004h"]
[63.232906, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[70.342875, "i", "cat /app/rust/src/ember/pale.rs\n"]
[70.343187, "o", "cat /app/rust/src/ember/pale.rs\r\n"]
[70.34321, "o", "\u001b[?2004l\r"]
[70.344332, "o", "#[derive(Clone, Debug, Default)]\r\npub(crate) struct Dial {\r\n    pub jobs: usize,\r\n    pub cells: usize,\r\n    pub bytes: usize,\r\n}\r\n\r\npub(crate) fn tilt_d(a: &mut Dial, b: usize, c: usize) {\r\n    a.jobs += 1;\r\n    a.cells += b;\r\n    a.bytes += c;\r\n}\r\n"]
[70.344575, "o", "\u001b[?2004h"]
[70.344603, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
[70.718826, "i", "cat /app/rust/src/codec.rs\n"]
[70.719204, "o", "cat /app/rust/src/codec.rs\r\n\u001b[?2004l\r"]
[70.720485, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n    let file = File::open(path)?;\r\n    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n        }\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n        if fields.len() != 4 {\r\n            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub(crate) fn write_pages(path: &"]
[70.720572, "o", "Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high,\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,\r\n            page.region_high,\r\n            page.cells.len()\r\n        )?;\r\n        for cell in &page.cells {\r\n            writeln!(\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[70.720765, "o", "\u001b[?2004h"]
[70.720816, "o", "root@50e6e43b-7274-4d6c-9364-8f2f0de5585a:/app# "]
