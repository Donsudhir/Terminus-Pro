[83.741212, "o", "\u0000\u0000\u0000\u0000K\u000e\u0010�\u0002A\u000e\u0018�\u0003D\u000e \u0002q\u000e\u0018A\u000e\u0010A\u000e\bL\u0000\u0000\u0000h\u0007\u0000\u0000Z)���\u0000\u0000\u0000\u0004�\u0014A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004E\u000e(�\u0005D\u000e0�\u0006A\u000e8�\u0007N\u000eP\u0002�\r\n\u000e8D\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b\u0000L\u0000\u0000\u0000�\u0007\u0000\u0000h���\u0000\u0005\u0000\u0000\u0004\u0004\u0015A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007D\u000e`\u0003�\u0002\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bF\u000b(\u0000\u0000\u0000p\b\u0000\u0000\u0018����\u0005\u0000\u0000\u0000L\u000e\u0010�\u0002E\u000e\u0018�\u0003\u0002K\u000e\u0010E\u000e\bG��X\u000e\u0018�\u0003�\u0002h\u0000\u0000\u00004\b\u0000\u0000�h���\u0007\u0000\u0000\u00044\u0015A\u0000T\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004E\u000e(�\u0005A\u000e0�\u0006D\u000e8�\u0007G\u000e�\u0001\u0003M\u0001\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b\u0003\u001c\u0006\u000e\b������A\u000e�\u0001�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002P\u0000\u0000\u0000�\b\u0000\u00000p���(\u0000\u0000\u00048\u0015A\u0000B\u000e\u0010�\u0002J\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007G\u000e�\u0007\u0003�\u0011\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bG\u000b\u0000\u0000\u0000 \u0000\u0000\u0000�\b\u0000\u0000�(���\u0003\u0000\u0000\u00044\u0016A\u0000\u000e�\u0007�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002\u0010\u0000\u0000\u0000�\t\u0000\u0000����M\u0000\u0000\u0000\u0000\u0000\u0000\u00008\u0000\u0000\u0000�\t\u0000\u0000����X\u0001\u0000\u0000\u0000B\u000e\u0010�\u0002E\u000e\u0018�\u0003A\u000e �\u0004A\u000e(�\u0005D\u000e@\u0002�\r\n\u000e(D\u000e A\u000e\u0018B\u000e\u0010B\u000e\bG\u000b\u0000P\u0000\u0000\u0000h\t\u0000\u0000�����\f\u0000\u0000\u0004�\u0016A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007G\u000e�\u0006\u0003�\r\n\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bH\u000b\u0000\u0000\u0000 \u0000\u0000\u0000�\t\u0000\u0000�+���\u0002\u0000\u0000\u0004L\u0017A\u0000\u000e�\u0006�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002<\u0000\u0000\u0000H\r\n\u0000\u0000`����\u0001\u0000\u0000\u0000I\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004A\u000e(�\u0005D\u000e0�\u0006\u0002�\r\n\u000e(D\u000e B\u000e\u0018B\u000e\u0010B\u000e\bD\u000b\u0000\u0000\u00004\u0000\u0000\u0000�\r\n\u0000\u0000\u0010���=\u0001\u0000\u0000\u0000B\u000e\u0010�\u0002A\u000e\u0018�\u0003D\u000e �\u0004\u0003 \u0001\r\n\u000e\u0018A\u000e\u0010B\u000e\bN\u000bA\u000e\u0018A\u000e\u0010B\u000e\b\u0000L\u0000\u0000\u0000X\r\n\u0000\u0000\u0018����\u0000\u0000\u0000\u0004|\u0017A\u0000B\u000e\u0010�\u0002E\u000e\u0018�\u0003E\u000e �\u0004B\u000e(�\u0005D\u000e0�\u0006D\u000e8�\u0007D\u000e`\u0002L\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b\u0000L\u0000\u0000\u0000�\r\n\u0000\u0000h����\u0000\u0000\u0000\u0004�\u0017A\u0000B\u000e\u0010�\u0002E\u000e\u0018�\u0003E\u000e �\u0004B\u000e(�\u0005D\u000e0�\u0006D\u000e8�\u0007D\u000e`\u0002L\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b\u0000P\u0000\u0000\u0000�\r\n\u0000\u0000ظ���\u0005\u0000\u0000\u0004�\u0017A\u0000B\u000e\u0010�\u0002I\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006D\u000e8�\u0007D\u000e�\u0001\u0003�\u0002\r\n\u000e8D\u000e0A\u000e(B"]
[83.74122, "o", "\u000e B\u000e\u0018B\u000e\u0010B\u000e\bF\u000b\u0000\u0000\u0000 \u0000\u0000\u0000L\u000b\u0000\u0000�,��\u001a\u0000\u0000\u0000\u0004�\u0017A\u0000\u000e�\u0001�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002L\u0000\u0000\u0000p\u000b\u0000\u0000@���1\u0004\u0000\u0000\u0004�\u0017A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003O\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007D\u000e`\u0003\u000e\u0002\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bE\u000bH\u0000\u0000\u0000(\f\u0000\u00000����\u0004\u0000\u0000\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005N\u000e0�\u0006A\u000e8�\u0007D\u000eP\u0003�\u0002\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bG\u000bH\u0000\u0000\u0000t\f\u0000\u0000�����\u0002\u0000\u0000\u0000B\u000e\u0010�\u0002O\u000e\u0018�\u0003E\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007D\u000e`\u0002�\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bD\u000b\u0000P\u0000\u0000\u0000X\f\u0000\u0000(����\u001b\u0000\u0000\u0004�\u0017A\u0000B\u000e\u0010�\u0002B\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007G\u000e�\b\u0003?\u000b\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bF\u000b\u0000\u0000\u0000 \u0000\u0000\u0000�\f\u0000\u0000�+��Y\u0003\u0000\u0000\u0004�\u0018A\u0000\u000e�\b�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002P\u0000\u0000\u0000�\f\u0000\u0000�����\u0004\u0000\u0000\u0004�\u0018A\u0000B\u000e\u0010�\u0002E\u000e\u0018�\u0003B\u000e �\u0004B\u000e(�\u0005A\u000e0�\u0006A\u000e8�\u0007G\u000e�\u0002\u0003�\u0003\r\n\u000e8A\u000e0A\u000e(B\u000e B\u000e\u0018B\u000e\u0010B\u000e\bA\u000b\u0000\u0000\u0000 \u0000\u0000\u0000$\r\u0000\u0000�.��X\u0000\u0000\u0000\u00047\u0019A\u0000\u000e�\u0002�\u0007�\u0006�\u0005�\u0004�\u0003�\u0002\u0000\u0000\u0000\u0000��\u00016�\u0001\u0005�\t\u0000�\u0002\u0005�\b\u0000�\u0003\u0005�\t\u0000�\u0005\u0005�\b