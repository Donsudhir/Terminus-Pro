[85.088631, "i", "cat /app/rust/src/main.rs\n"]
[85.08882, "o", "cat /app/rust/src/main.rs\r\n\u001b[?2004l\r"]
[85.089818, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\nuse ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n\r\nfn main() {\r\n    if let Err(error) = run() {\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n    Ok(())\r\n}\r\n"]
[85.090003, "o", "\u001b[?2004hroot@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[85.412973, "i", "cat /app/rust/src/model.rs\n"]
[85.41328, "o", "cat /app/rust/src/model.rs\r\n"]
[85.413356, "o", "\u001b[?2004l\r"]
[85.415148, "o", "pub(crate) const RUNE_VOID: u8 = 0;\r\npub(crate) const RUNE_FIXED: u8 = 1;\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Cell {\r\n    pub origin: u8,\r\n    pub present: u8,\r\n    pub amount: i64,\r\n    pub region: String,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Mark {\r\n    pub low: i64,\r\n    pub high: i64,\r\n    pub has_absent: bool,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\n"]
[85.415232, "o", "pub(crate) struct Page {\r\n    pub id: usize,\r\n    pub generation: u8,\r\n    pub mark: Mark,\r\n    pub region_low: String,\r\n    pub region_high: String,\r\n    pub cells: Vec<Cell>,\r\n}\r\n\r\n#[derive(Debug)]\r\npub(crate) enum FoldErr {\r\n    Empty,\r\n    Shape,\r\n}\r\n\r\nimpl std::fmt::Display for FoldErr {\r\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n        match self {\r\n            Self::Empty => write!(f, \"empty lane set\"),\r\n            Self::Shape => write!(f, \"lane lengths differ\"),\r\n        }\r\n    }\r\n}\r\n\r\nimpl std::error::Error for FoldErr {}\r\n"]
[85.415589, "o", "\u001b[?2004h"]
[85.415652, "o", "root@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[90.37284, "i", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/reed.rs\n"]
[90.373412, "o", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/reed.rs\r\n\u001b[?2004l\r"]
[90.374625, "o", "pub(crate) mod fold;\r\npub(crate) mod pale;\r\npub(crate) mod reed;\r\nuse crate::ember::fold::tilt_a;\r\nuse crate::model::{Cell, FoldErr, Page};\r\n\r\npub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n    let mut pages = Vec::new();\r\n    for (id, chunk) in cells.chunks(width).enumerate() {\r\n        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n        let mark = tilt_a(&values, &present, &origins)?;\r\n\r\n        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n        regions.sort();\r\n        let region_low = regions.first().cloned().unwrap_or_default();\r\n        let region_high = regions.last().cloned().unwrap_or_default();\r\n"]
[90.374649, "o", "        pages.push(Page {\r\n            id,\r\n            generation: 3,\r\n            mark,\r\n            region_low,\r\n            region_high,\r\n            cells: chunk.to_vec(),\r\n        });\r\n    }\r\n    Ok(pages)\r\n}\r\n"]
[90.374913, "o", "\u001b[?2004h"]
[90.374983, "o", "root@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[90.694932, "i", "cat /app/rust/src/ember/fold.rs\n"]
[90.695166, "o", "cat /app/rust/src/ember/fold.rs\r\n\u001b[?2004l\r"]
[90.69621, "o", "use crate::model::{FoldErr, Mark};\r\n\r\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n    if a.is_empty() {\r\n        return Err(FoldErr::Empty);\r\n    }\r\n    if a.len() != b.len() || a.len() != c.len() {\r\n        return Err(FoldErr::Shape);\r\n    }\r\n\r\n    let mut low = a[0];\r\n    let mut high = a[0];\r\n    let mut has_absent = false;\r\n    for (value, present) in a.iter().zip(b.iter()) {\r\n        low = low.min(*value);\r\n        high = high.max(*value);\r\n        has_absent |= *present == 0;\r\n    }\r\n\r\n    Ok(Mark {\r\n        low,\r\n        high,\r\n        has_absent,\r\n    })\r\n}\r\n"]
[90.696413, "o", "\u001b[?2004hroot@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[99.596171, "i", "cat /app/rust/src/codec.rs\n"]
[99.59631, "o", "cat /app/rust/src/codec.rs\r\n\u001b[?2004l\r"]
[99.597899, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n    let file = File::open(path)?;\r\n"]
[99.597927, "o", "    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n        }\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n        if fields.len() != 4 {\r\n"]
[99.598014, "o", "            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub(crate) fn write_pages(path: &Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high,\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,\r\n            page.region_high,\r\n            page.cells.len()\r\n        )?;\r\n        for"]
[99.598046, "o", " cell in &page.cells {\r\n            writeln!(\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[99.59829, "o", "\u001b[?2004hroot@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[99.906137, "i", "cat /app/rust/src/ember/pale.rs /app/rust/src/report.rs\n"]
[99.90659, "o", "cat /app/rust/src/ember/pale.rs /app/rust/src/report.rs"]
[99.906602, "o", "\r\n"]
[99.906649, "o", "\u001b[?2004l\r"]
[99.908444, "o", "#[derive(Clone, Debug, Default)]\r\npub(crate) struct Dial {\r\n    pub jobs: usize,\r\n    pub cells: usize,\r\n    pub bytes: usize,\r\n}\r\n\r\npub(crate) fn tilt_d(a: &mut Dial, b: usize, c: usize) {\r\n    a.jobs += 1;\r\n    a.cells += b;\r\n    a.bytes += c;\r\n}\r\n"]
[99.908514, "o", "use crate::ember::pale::Dial;\r\n\r\npub(crate) fn line(a: &Dial) -> String {\r\n    format!(\"jobs={} cells={} bytes={}\", a.jobs, a.cells, a.bytes)\r\n}\r\n"]
[99.908789, "o", "\u001b[?2004h"]
[99.908831, "o", "root@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[107.538359, "i", "cat /app/cpp/src/parse.cpp\n"]
[107.538664, "o", "cat /app/cpp/src/parse.cpp\r\n\u001b[?2004l\r"]
[107.539886, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runti"]
[107.53993, "o", "me_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n     "]
[107.539957, "o", "       Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[107.540189, "o", "\u001b[?2004h"]
[107.540221, "o", "root@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# "]
[107.883579, "i", "cat /app/cpp/src/main.cpp\n"]
[107.883836, "o", "cat /app/cpp/src/main.cpp\r\n\u001b[?2004l\r"]
[107.885499, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n\r\nnamespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n    if (child == 0) {\r\n"]
[107.885589, "o", "        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n\r\nint main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n"]
[107.885629, "o", "            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
