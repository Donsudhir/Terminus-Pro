[?2004l[?2004h>             case Op::All:
[?2004l[?2004h>                 keep = true;
[?2004l[?2004h>                 break;
[?2004l[?2004h>             case Op::Equal:
[?2004l[?2004h>                 keep = a.amount_lane[i] == b.x;
[?2004l[?2004h>                 break;
[?2004l[?2004h>             case Op::Range:
[?2004l[?2004h>                 keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;
[?2004l[?2004h>                 break;
[?2004l[?2004h>             case Op::IsNull:
[?2004l[?2004h>                 keep = false;
[?2004l[?2004h>                 break;
[?2004l[?2004h>             case Op::RegionEqual:
[?2004l[?2004h>                 keep = a.region_lane[i] == b.text;
[?2004l[?2004h>                 break;
[?2004l[?2004h>         }
[?2004l[?2004h>         if (keep) {
[?2004l[?2004h>             ++tally.row_count;
[?2004l[?2004h>             tally.sum_amount += a.amount_lane[i];
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return tally;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> }  // namespace loam
[?2004l[?2004h> EOF
[?2004l[?2004hroot@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# cat > /app/cpp/src/harbor/veil.cpp << 'EOF'
[?2004l[?2004h> #include "loam/plan.hpp"
[?2004l[?2004h> 
[?2004l[?2004h> namespace loam {
[?2004l[?2004h> namespace {
[?2004l[?2004h> 
[?2004l[?2004h> // Marker-based pruning is only sound for slabs whose markers are faithful to
[?2004l[?2004h> // the live-value domain. The current writer emits generation 3 with faithful
[?2004l[?2004h> // low/high/has_absent markers (see docs/report-schema.md). Older mixed-
[?2004l[?2004h> // generation slabs kept legacy markers that span non-live amounts and carry
[?2004l[?2004h> // inconsistent absence flags, so they must always be opened rather than
[?2004l[?2004h> // pruned. This keeps equivalent modes in agreement without rewriting the
[?2004l[?2004h> // archived artifacts.
[?2004l[?2004h> constexpr std::uint8_t kFaithfulGeneration = 3;
[?2004l[?2004h> 
[?2004l[?2004h> bool markers_trustworthy(const Slab& slab) {
[?2004l[?2004h>     return slab.generation == kFaithfulGeneration;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> }  // namespace
[?2004l[?2004h> 
[?2004l[?2004h> Gate turn_b(const Slab& a, const Probe& b) {
[?2004l[?2004h>     if (!b.skipping) {
[?2004l[?2004h>         return {true, "full"};
[?2004l[?2004h>     }
[?2004l[?2004h>     if (b.op == Op::All) {
[?2004l[?2004h>         return {true, "all"};
[?2004l[?2004h>     }
[?2004l[?2004h>     if (!markers_trustworthy(a)) {
[?2004l[?2004h>         return {true, "legacy"};
[?2004l[?2004h>     }
[?2004l[?2004h>     if (b.op == Op::IsNull) {
[?2004l[?2004h>         return {a.has_absent, a.has_absent ? "possible" : "empty"};
[?2004l[?2004h>     }
[?2004l[?2004h>     if (b.op == Op::RegionEqual) {
[?2004l[?2004h>         const bool read = b.text >= a.region_low && b.text <= a.region_high;
[?2004l[?2004h>         return {read, read ? "text-hit" : "text-away"};
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     const std::int64_t left = b.op == Op::Equal ? b.x : b.x;
[?2004l[?2004h>     const std::int64_t right = b.op == Op::Equal ? b.x : b.y;
[?2004l[?2004h>     const bool read = !(right < a.low || left > a.high);
[?2004l[?2004h>     return {read, read ? "range-hit" : "range-away"};
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> }  // namespace loam
[?2004l[?2004h> EOF
[?2004l[?2004hroot@7aed3a99-a5bf-4e6f-82b7-b58237d56534:/app# cat > /app/rust/src/ember/fold.rs << 'EOF'
[?2004l[?2004h> use crate::model::{FoldErr, Mark};
[?2004l[?2004h> 
[?2004l[?2004h> // Liveness matches the reader contract: Retired (0) is never live, Inherited
[?2004l[?2004h> // (1) is always live, Current (2) is live only when present. Markers must be
[?2004l[?2004h> // faithful to the live-value domain: low/high span only live amounts, and
[?2004l[?2004h> // has_absent is set whenever any non-live entry is present. A slab whose
[?2004l[?2004h> // entries are all non-live records low 0, high 0, and has_absent true.
[?2004l[?2004h> fn is_live(origin: u8, present: u8) -> bool {
[?2004l[?2004h>     match origin {
[?2004l[?2004h>         0 => false,
[?2004l[?2004h>         1 => true,
[?2004l[?2004h>         _ => present != 0,
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> pub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {
[?2004l[?2004h>     if a.is_empty() {
[?2004l[?2004h>         return Err(FoldErr::Empty);
[?2004l[?2004h>     }
[?2004l[?2004h>     if a.len() != b.len() || a.len() != c.len() {
[?2004l[?2004h>         return Err(FoldErr::Shape);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     let mut low: Option<i64> = None;
[?2004l[?2004h>     let mut high: Option<i64> = None;
[?2004l[?2004h>     let mut has_absent = false;
[?2004l[?2004h>     for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {
[?2004l[?2004h>         if is_live(*origin, *present) {
[?2004l[?2004h>             low = Some(low.map_or(*value, |cur| cur.min(*value)));
[?2004l[?2004h>             high = Some(high.map_or(*value, |cur| cur.max(*value)));
[?2004l[?2004h>         } else {
[?2004l[?2004h>             has_absent = true;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     match (low, high) {
[?2004l[?2004h>         (Some(low), Some(high)) => Ok(Mark {
[?2004l[?2004h>             low,
[?2004l[?2004h>             high,
[?2004l[?2004h>             has_absent,
[?2004l[?2004h>         }),
[?2004l[?2004h>         _ => Ok(Mark {
[?2004l[?2004h>             low: 0,
[?2004l[?2004h>             high: 0,
[?2004l[?2004h>             has_absent: true,
[?2004l[?2004h>         }),
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> EOF
