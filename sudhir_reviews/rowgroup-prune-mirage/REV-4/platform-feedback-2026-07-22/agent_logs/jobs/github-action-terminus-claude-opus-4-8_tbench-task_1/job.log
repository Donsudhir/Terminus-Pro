Sending keys: ["cat > /app/rust/src/ember/fold.rs << 'EOF'\nuse crate::model::{FoldErr, Mark};\n\n// Liveness matches the reader contract: Retired (0) is never live, Inherited\n// (1) is always live, Current (2) is live only when present. Markers must be\n// faithful to the live-value domain: low/high span only live amounts, and\n// has_absent is set whenever any non-live entry is present. A slab whose\n// entries are all non-live records low 0, high 0, and has_absent true.\nfn is_live(origin: u8, present: u8) -> bool {\n    match origin {\n        0 => false,\n        1 => true,\n        _ => present != 0,\n    }\n}\n\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\n    if a.is_empty() {\n        return Err(FoldErr::Empty);\n    }\n    if a.len() != b.len() || a.len() != c.len() {\n        return Err(FoldErr::Shape);\n    }\n\n    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        if is_live(*origin, *present) {\n            low = Some(low.map_or(*value, |cur| cur.min(*value)));\n            high = Some(high.map_or(*value, |cur| cur.max(*value)));\n        } else {\n            has_absent = true;\n        }\n    }\n\n    match (low, high) {\n        (Some(low), Some(high)) => Ok(Mark {\n            low,\n            high,\n            has_absent,\n        }),\n        _ => Ok(Mark {\n            low: 0,\n            high: 0,\n            has_absent: true,\n        }),\n    }\n}\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
