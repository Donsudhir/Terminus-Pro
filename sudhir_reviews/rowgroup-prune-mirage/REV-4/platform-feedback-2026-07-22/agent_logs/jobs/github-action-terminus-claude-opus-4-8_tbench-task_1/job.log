Sending keys: ['cat > /app/cpp/src/harbor/veil.cpp << \'EOF\'\n#include "loam/plan.hpp"\n\nnamespace loam {\nnamespace {\n\n// Marker-based pruning is only sound for slabs whose markers are faithful to\n// the live-value domain. The current writer emits generation 3 with faithful\n// low/high/has_absent markers (see docs/report-schema.md). Older mixed-\n// generation slabs kept legacy markers that span non-live amounts and carry\n// inconsistent absence flags, so they must always be opened rather than\n// pruned. This keeps equivalent modes in agreement without rewriting the\n// archived artifacts.\nconstexpr std::uint8_t kFaithfulGeneration = 3;\n\nbool markers_trustworthy(const Slab& slab) {\n    return slab.generation == kFaithfulGeneration;\n}\n\n}  // namespace\n\nGate turn_b(const Slab& a, const Probe& b) {\n    if (!b.skipping) {\n        return {true, "full"};\n    }\n    if (b.op == Op::All) {\n        return {true, "all"};\n    }\n    if (!markers_trustworthy(a)) {\n        return {true, "legacy"};\n    }\n    if (b.op == Op::IsNull) {\n        return {a.has_absent, a.has_absent ? "possible" : "empty"};\n    }\n    if (b.op == Op::RegionEqual) {\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\n        return {read, read ? "text-hit" : "text-away"};\n    }\n\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\n    const bool read = !(right < a.low || left > a.high);\n    return {read, read ? "range-hit" : "range-away"};\n}\n\n}  // namespace loam\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
