[27.712837, "o", "Tally walk_row(const Slab& a, const Probe& b, const Gate& c);\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c);\r\nTally sweep_e(const Tally& a, const Tally& b);\r\n\r\n}  // namespace loam\r\n"]
[27.714183, "o", "#pragma once\r\n\r\n#include <cstdint>\r\n#include <string>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n\r\nenum class Origin : std::uint8_t { Retired = 0, Inherited = 1, Current = 2 };"]
[27.714224, "o", "\r\n\r\nstruct Cell {\r\n    std::uint8_t present{};\r\n    Origin origin{Origin::Current};\r\n    std::int64_t amount{};\r\n    std::string region;\r\n"]
[27.714255, "o", "};\r\n\r\nstruct Slab {\r\n    std::size_t id{};\r\n    std::uint8_t generation{};\r\n    std::int64_t low{};\r\n    std::int64_t high{};\r\n    bool has_absent{};\r\n    std::string region_low;\r\n    std::string region_high;\r\n    std::vector<Cell> cells;\r\n    std::vector<std::int64_t> amount_lane;\r\n    std::vector<std::uint8_t> presence_lane;\r\n    std::vector<std::uint8_t> origin_lane;\r\n    std::vector<std::string> region_lane;\r\n"]
[27.714294, "o", "};\r\n\r\nenum class Op { All, Equal, Range, IsNull, RegionEqual };\r\nenum class Lane { Row, Batch };\r\n\r\nstruct Probe {\r\n    Op op{Op::All};\r\n    std::int64_t x{};\r\n    std::int64_t y{};\r\n    std::string text;\r\n    Lane lane{Lane::Row};\r\n    bool skipping{};\r\n};\r\n\r\n"]
[27.714324, "o", "struct Gate {\r\n    bool read{true};\r\n    std::string note;\r\n};\r\n\r\nstruct Tally {\r\n    std::int64_t row_count{};\r\n    std::int64_t sum_amount{};\r\n    std::int64_t pages_read{};\r\n};\r\n\r\nstruct CaseSpec {\r\n    std::string case_id;\r\n    std::string store_path;\r\n    Probe probe;\r\n};\r\n"]
[27.714362, "o", "\r\nstruct CaseResult {\r\n    std::string case_id;\r\n    Tally tally;\r\n    std::int64_t pages_total{};\r\n    Lane lane{Lane::Row};\r\n    bool skipping{};\r\n};\r\n\r\n}  // namespace loam\r\n"]
