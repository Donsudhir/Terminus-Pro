[70.851828, "o", "s=s.replace('''pub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\\n    if a.is_empty() {\\n        return Err(FoldErr::Empty);\\n    }\\n    if a.len() != b.len() || a.len() != c.len() {\\n        return Err(FoldErr::Shape);\\n    }\\n\\n    let mut low = a[0];\\n    let mut high = a[0];\\n    let mut has_absent = false;\\n    for (value, present) in a.iter().zip(b.iter()) {\\n        low = low.min(*value);\\n        high = high.max(*value);\\n        has_absent |= *present == 0;\\n    }\\n\\n    Ok(Mark {\\n        low,\\n        high,\\n        has_absent,\\n    })\\n}\\n''','''fn is_live(present: u8, origin: u8) -> bool {\\n    match origin {\\n        0 => false,\\n        1 => true,\\n        _ => present != 0,\\n    }\\n}\\n\\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\\n    if a.is_empty() {\\n        return Err(FoldErr::Empty);\\n    }\\n    if a.len() != b.len() || a.len() != c.len() {\\n        return Err(FoldErr::Shape);\\n    }\\n\\n    let mut low: Option<i64> = None;\\n "]
[70.851872, "o", "   let mut high: Option<i64> = None;\\n    let mut has_absent = false;\\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\\n        if is_live(*present, *origin) {\\n            low = Some(low.map_or(*value, |current| current.min(*value)));\\n            high = Some(high.map_or(*value, |current| current.max(*value)));\\n        } else {\\n            has_absent = true;\\n        }\\n    }\\n\\n    Ok(Mark {\\n        low: low.unwrap_or(0),\\n        high: high.unwrap_or(0),\\n        has_absent,\\n    })\\n}\\n''')\r\n\u001b[?2004l\r"]
[70.851887, "o", "\u001b[?2004h> "]
[70.851922, "o", "p.write_text(s)\r\n\u001b[?2004l\r"]
