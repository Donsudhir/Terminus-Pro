[32.831885, "o", "for f in /app/cpp/src/harbor/*.cpp /app/cpp/src/lattice/*.cpp /app/cpp/src/parse.cpp /app/cpp/src/report.cpp /app/cpp/src/main.cpp; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[32.831962, "o", "### /app/cpp/src/harbor/pale.cpp\r\n"]
[32.833415, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nstd::string turn_d(const Gate& a, const Probe& b) {\r\n    const char* lane = b.lane == Lane::Batch ? \"batch\" : \"row\";\r\n    return std::string(lane) + \":\" + (a.read ? \"open:\" : \"closed:\") + a.note;\r\n}\r\n\r\n"]
[32.833452, "o", "}  // namespace loam\r\n"]
[32.834733, "o", "### /app/cpp/src/harbor/veil.cpp\r\n"]
[32.835847, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n"]
[32.835886, "o", "        return {true, \"full\"};\r\n    }\r\n    if (b.op == Op::All) {\r\n"]
[32.835912, "o", "        return {true, \"all\"};\r\n    }\r\n    if (b.op == Op::IsNull) {\r\n        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n\r\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r\n}\r\n\r\n}  // namespace loam\r\n"]
[32.836087, "o", "### /app/cpp/src/lattice/bay.cpp\r\n"]
[32.836998, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\n\r\nTally sweep_e(const Tally& a, const Tally& b) {\r\n    return {\r\n        a.row_count + b.row_count,\r\n        a.sum_amount + b.sum_amount,\r\n"]
[32.837035, "o", "        a.pages_read + b.pages_read,\r\n    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
[32.837187, "o", "### /app/cpp/src/lattice/rill.cpp\r\n"]
[32.838117, "o", "#include \"loam/exec.hpp\"\r\n\r\n#include <cstddef>\r\n#include <vector>\r\n\r\nnamespace loam {\r\n"]
[32.838138, "o", "\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n"]
[32.838155, "o", "    tally.pages_read = 1;\r\n\r\n    const std::size_t count = a.amount_lane.size();\r\n    std::vector<unsigned char> admit(count, 0);\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    }\r\n\r\n    if (b.op == Op::IsNull) {\r\n        for (std::size_t i = 0; i < count; ++i) {\r\n            if (admit[i] == 0) {\r\n                ++tally.row_count;\r\n            }\r\n        }\r\n        return tally;\r\n    }\r\n"]
[32.838189, "o", "\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        if (admit[i] == 0) {\r\n            continue;\r\n"]
[32.838214, "o", "        }\r\n        bool keep = false;\r\n        switch (b.op) {\r\n            case Op::All:\r\n                keep = true;\r\n                break;\r\n            case Op::Equal:\r\n                keep = a.amount_lane[i] == b.x;\r\n                break;\r\n            case Op::Range:\r\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n                break;\r\n            case Op::IsNull:\r\n                keep = false;\r\n                break;\r\n            case Op::RegionEqual:\r\n                keep = a.region_lane[i] == b.text;\r\n                break;\r\n        }\r\n        if (keep) {\r\n"]
[32.838235, "o", "            ++tally.row_count;\r\n            tally.sum_amount += a.amount_lane[i];\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[32.838367, "o", "### /app/cpp/src/parse.cpp\r\n"]
[32.83943, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n"]
[32.839466, "o", "\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n"]
[32.839489, "o", "        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n"]
[32.839514, "o", "    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace"]
[32.839536, "o", "\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n"]
[32.839554, "o", "    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;"]
[32.839579, "o", "\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n"]
[32.839602, "o", "        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {"]
[32.83962, "o", "\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n"]
[32.839641, "o", "            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[32.839787, "o", "### /app/cpp/src/report.cpp\r\n"]
[32.841778, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <fstream>\r\n"]
[32.841807, "o", "#include <sstream>\r\n#include <stdexcept>\r\n\r\n"]
[32.841827, "o", "namespace loam {\r\nnamespace {\r\n\r\nstd::string escape_json(const std::string& value) {\r\n    std::string out;\r\n"]
[32.841848, "o", "    for (const char ch : value) {\r\n        if (ch == '\"' || ch == '\\\\') {\r\n            out.push_back('\\\\');\r\n        }\r\n"]
[32.841875, "o", "        out.push_back(ch);\r\n    }\r\n    return out;\r\n}\r\n\r\n"]
[32.841893, "o", "std::string cases_json(const std::vector<CaseResult>& cases) {\r\n    std::ostringstream out;\r\n    out << '[';\r\n"]
[32.841911, "o", "    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n        if (i != 0) out << ',';\r\n"]
[32.841931, "o", "        const auto& item = cases[i];\r\n        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n"]
[32.841969, "o", "            << \",\\\"pages_total\\\":\" << item.pages_total\r\n            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n            << '}';\r\n    }\r\n    out << ']';\r\n"]
[32.841991, "o", "    return out.str();\r\n}\r\n\r\n"]
[32.84201, "o", "}  // namespace\r\n\r\nstd::string lane_name(const Lane lane) {\r\n    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n}\r\n\r\n"]
[32.842032, "o", "void write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n"]
[32.842046, "o", "    if (path.has_parent_path()) {\r\n        std::filesystem::create_directories(path.parent_path());\r\n    }\r\n    const std::string body = cases_json(cases);"]
[32.842082, "o", "\r\n    const std::string digest = digest_hex(body);\r\n    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    if (!output) {\r\n        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n"]
[32.842105, "o", "    }\r\n    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n}\r\n"]
[32.842125, "o", "\r\n}  // namespace loam\r\n"]
[32.842442, "o", "### /app/cpp/src/main.cpp\r\n"]
[32.844583, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n"]
[32.844616, "o", "#include <filesystem>\r\n#include <iostream>"]
[32.844636, "o", "\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n"]
[32.844654, "o", "\r\n"]
[32.844681, "o", "namespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n"]
[32.844701, "o", "        throw std::runtime_error(\"fork failed\");\r\n    }\r\n"]
[32.844721, "o", "    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {"]
[32.844741, "o", "\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }"]
[32.844767, "o", "\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n"]
[32.844788, "o", "\r\nint main(int argc, char** argv) {\r\n    try {\r\n"]
[32.844806, "o", "        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n"]
[32.844826, "o", "            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n"]
[32.844847, "o", "            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n"]
[32.844868, "o", "        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n"]
[32.844887, "o", "        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n"]
[32.844911, "o", "    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
[32.84511, "o", "\u001b[?2004h"]
[32.84513, "o", "root@771690eb-7154-42c4-9dbd-ecb2505d85b4:/app# "]
[33.189011, "i", "for f in /app/rust/src/*.rs /app/rust/src/ember/*.rs; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\n"]
[33.189804, "o", "for f in /app/rust/src/*.rs /app/rust/src/ember/*.rs; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[33.190009, "o", "### /app/rust/src/codec.rs\r\n"]
[33.191288, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n"]
[33.191348, "o", "    let file = File::open(path)?;\r\n    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n        }\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n"]
[33.191426, "o", "        if fields.len() != 4 {\r\n            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub(crate) fn write_pages(path: &Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high,\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,\r\n            page.region_high,\r\n            page.cells"]
[33.191512, "o", ".len()\r\n        )?;\r\n        for cell in &page.cells {\r\n            writeln!(\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[33.191659, "o", "### /app/rust/src/main.rs\r\n"]
[33.192761, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\nuse ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n\r\nfn main() {\r\n    if let Err(error) = run() {"]
[33.192811, "o", "\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n"]
[33.192858, "o", "    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n    Ok(())\r\n}\r\n"]
[33.193027, "o", "### /app/rust/src/model.rs\r\n"]
[33.194103, "o", "pub(crate) const RUNE_VOID: u8 = 0;\r\npub(crate) const RUNE_FIXED: u8 = 1;\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Cell {\r\n    pub origin: u8,\r\n    pub present: u8,\r\n    pub amount: i64,\r\n    pub region: String,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Mark {\r\n    pub low: i64,\r\n"]
[33.194143, "o", "    pub high: i64,\r\n    pub has_absent: bool,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Page {\r\n    pub id: usize,\r\n    pub generation: u8,\r\n    pub mark: Mark,\r\n    pub region_low: String,\r\n    pub region_high: String,\r\n    pub cells: Vec<Cell>,\r\n}\r\n\r\n#[derive(Debug)]\r\npub(crate) enum FoldErr {\r\n    Empty,\r\n    Shape,\r\n}\r\n\r\nimpl std::fmt::Display for FoldErr {\r\n"]
[33.194207, "o", "    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n        match self {\r\n            Self::Empty => write!(f, \"empty lane set\"),\r\n            Self::Shape => write!(f, \"lane lengths differ\"),\r\n        }\r\n    }\r\n}\r\n\r\nimpl std::error::Error for FoldErr {}\r\n"]
[33.194382, "o", "### /app/rust/src/report.rs\r\n"]
[33.195487, "o", "use crate::ember::pale::Dial;\r\n\r\npub(crate) fn line(a: &Dial) -> String {\r\n    format!(\"jobs={} cells={} bytes={}\", a.jobs, a.cells, a.bytes)\r\n}\r\n"]
[33.195676, "o", "### /app/rust/src/ember/fold.rs\r\n"]
[33.196889, "o", "use crate::model::{FoldErr, Mark};\r\n\r\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n    if a.is_empty() {\r\n        return Err(FoldErr::Empty);\r\n    }\r\n"]
[33.19696, "o", "    if a.len() != b.len() || a.len() != c.len() {\r\n        return Err(FoldErr::Shape);\r\n    }\r\n\r\n    let mut low = a[0];\r\n    let mut high = a[0];\r\n    let mut has_absent = false;\r\n    for (value, present) in a.iter().zip(b.iter()) {\r\n        low = low.min(*value);\r\n        high = high.max(*value);\r\n        has_absent |= *present == 0;\r\n    }\r\n\r\n    Ok(Mark {\r\n        low,\r\n        high,\r\n        has_absent,\r\n    })\r\n}\r\n"]
[33.197183, "o", "### /app/rust/src/ember/mod.rs\r\n"]
[33.199015, "o", "pub(crate) mod fold;\r\npub(crate) mod pale;\r\npub(crate) mod reed;\r\n"]
[33.199205, "o", "### /app/rust/src/ember/pale.rs\r\n"]
[33.200334, "o", "#[derive(Clone, Debug, Default)]\r\npub(crate) struct Dial {\r\n    pub jobs: usize,\r\n    pub cells: usize,\r\n    pub bytes: usize,\r\n}\r\n\r\npub(crate) fn tilt_d(a: &mut Dial, b: usize, c: usize) {"]
[33.200421, "o", "\r\n    a.jobs += 1;\r\n    a.cells += b;\r\n    a.bytes += c;\r\n}\r\n"]
[33.200599, "o", "### /app/rust/src/ember/reed.rs\r\n"]
[33.20174, "o", "use crate::ember::fold::tilt_a;\r\nuse crate::model::{Cell, FoldErr, Page};\r\n\r\npub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n    let mut pages = Vec::new();\r\n    for (id, chunk) in cells.chunks(width).enumerate() {\r\n        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n"]
[33.201825, "o", "        let mark = tilt_a(&values, &present, &origins)?;\r\n\r\n        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n        regions.sort();\r\n        let region_low = regions.first().cloned().unwrap_or_default();\r\n        let region_high = regions.last().cloned().unwrap_or_default();\r\n        pages.push(Page {\r\n            id,\r\n            generation: 3,\r\n            mark,\r\n            region_low,\r\n            region_high,\r\n            cells: chunk.to_vec(),\r\n        });\r\n    }\r\n    Ok(pages)\r\n}\r\n"]
[33.20217, "o", "\u001b[?2004h"]
[33.20222, "o", "root@771690eb-7154-42c4-9dbd-ecb2505d85b4:/app# "]
[38.856656, "i", "cat /app/rust/src/codec.rs\n"]
[38.856865, "o", "cat /app/rust/src/codec.rs\r\n"]
[38.85689, "o", "\u001b[?2004l\r"]
[38.857908, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n    let file = File::open(path)?;\r\n    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n        }\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n        if fields.len() != 4 {\r\n            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub(crate) fn write_pages(path: &"]
[38.857951, "o", "Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high,\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,\r\n            page.region_high,\r\n            page.cells.len()\r\n        )?;\r\n        for cell in &page.cells {\r\n            writeln!(\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[38.858157, "o", "\u001b[?2004h"]
[38.858189, "o", "root@771690eb-7154-42c4-9dbd-ecb2505d85b4:/app# "]
[39.208472, "i", "cat /app/cpp/src/parse.cpp\n"]
[39.208607, "o", "cat /app/cpp/src/parse.cpp\r\n\u001b[?2004l\r"]
[39.209583, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runti"]
[39.209633, "o", "me_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n     "]
[39.209661, "o", "       Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
