[95.563745, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n"]
[95.563783, "o", "\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n"]
[95.563814, "o", "        return {true, \"full\"};\r\n    }\r\n    if (b.op == Op::All) {\r\n        return {true, \"all\"};\r\n    }\r\n    if (b.op == Op::IsNull) {\r\n        if (a.generation < 3) {\r\n            return {true, \"legacy-null\"};\r\n"]
[95.563841, "o", "        }\r\n        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n"]
[95.563865, "o", "\r\n    if (a.generation < 3) {\r\n        return {true, \"legacy-range\"};\r\n    }\r\n\r\n    const std::int64_t left = b.x;\r\n"]
[95.563884, "o", "    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r\n}\r\n\r\n"]
[95.563905, "o", "}  // namespace loam\r\n"]
[95.566198, "o", "#include \"loam/exec.hpp\"\r\n\r\n#include <cstddef>\r\n#include <vector>\r\n"]
[95.566236, "o", "\r\nnamespace loam {\r\nnamespace {\r\n\r\nbool is_live(std::uint8_t present, std::uint8_t origin) {\r\n    const auto decoded = static_cast<Origin>(origin);\r\n    if (decoded == Origin::Retired) {\r\n"]
[95.566259, "o", "        return false;\r\n    }\r\n    if (decoded == Origin::Inherited) {\r\n        return true;\r\n    }\r\n    return present != 0;\r\n}\r\n\r\n}  // namespace\r\n\r\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n\r\n    const std::size_t count = a.amount_lane.size();\r\n    std::vector<unsigned char> admit(count, 0);\r\n"]
[95.56628, "o", "    for (std::size_t i = 0; i < count; ++i) {\r\n        admit[i] = is_live(a.presence_lane[i], a.origin_lane[i]) ? 1 : 0;\r\n    }\r\n\r\n    if (b.op == Op::IsNull) {\r\n        for (std::size_t i = 0; i < count; ++i) {\r\n            if (admit[i] == 0) {\r\n                ++tally.row_count;\r\n            }\r\n"]
[95.566307, "o", "        }\r\n        return tally;\r\n    }\r\n\r\n    for (std::size_t i = 0; i < count; ++i) {\r\n        if (admit[i] == 0) {\r\n            continue;\r\n        }"]
[95.566325, "o", "\r\n        bool keep = false;\r\n        switch (b.op) {\r\n            case Op::All:\r\n                keep = true;\r\n                break;\r\n            case Op::Equal:\r\n                keep = a.amount_lane[i] == b.x;\r\n"]
[95.566346, "o", "                break;\r\n            case Op::Range:\r\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n                break;\r\n            case Op::IsNull:\r\n                keep = false;\r\n                break;\r\n            case Op::RegionEqual:\r\n"]
[95.566366, "o", "                keep = a.region_lane[i] == b.text;\r\n                break;\r\n        }\r\n        if (keep) {\r\n            ++tally.row_count;\r\n            tally.sum_amount += a.amount_lane[i];\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n"]
[95.566386, "o", "}  // namespace loam\r\n"]
[95.567771, "o", "use crate::model::{FoldErr, Mark};\r\n\r\nfn is_live(present: u8, origin: u8) -> bool {\r\n    match origin {\r\n        0 => false,\r\n        1 => true,\r\n        _ => present != 0,\r\n    }\r\n"]
[95.567801, "o", "}\r\n\r\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n    if a.is_empty() {\r\n"]
[95.567827, "o", "        return Err(FoldErr::Empty);\r\n    }\r\n    if a.len() != b.len() || a.len() != c.len() {\r\n        return Err(FoldErr::Shape);\r\n    }\r\n\r\n    let mut low: Option<i64> = None;\r\n    let mut high: Option<i64> = None;\r\n    let mut has_absent = false;\r\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\r\n        if is_live(*present, *origin) {\r\n            low = Some(low.map_or(*value, |current| current.min(*value)));\r\n            high = Some(high.map_or(*value, |current| current.max(*value)));\r\n"]
[95.567855, "o", "        } else {\r\n            has_absent = true;\r\n        }\r\n    }\r\n\r\n    Ok(Mark {\r\n        low: low.unwrap_or(0),\r\n        high: high.unwrap_or(0),\r\n        has_absent,\r\n    })\r\n}\r\n"]
[95.568127, "o", "\u001b[?2004h"]
