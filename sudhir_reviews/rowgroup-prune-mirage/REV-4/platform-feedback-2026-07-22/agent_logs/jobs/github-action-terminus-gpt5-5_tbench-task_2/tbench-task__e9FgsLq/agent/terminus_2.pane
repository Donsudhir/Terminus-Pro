[?2004l     1	#include "loam/exec.hpp"
     2	
     3	namespace loam {
     4	namespace {
     5	
     6	bool is_live(const Cell& cell) {
     7	    if (cell.origin == Origin::Retired) {
     8	        return false;
     9	    }
    10	    if (cell.origin == Origin::Inherited) {
    11	        return true;
    12	    }
    13	    return cell.present != 0;
    14	}
    15	
    16	bool matches(const Cell& cell, const Probe& probe) {
    17	    switch (probe.op) {
    18	        case Op::All:
    19	            return true;
    20	        case Op::Equal:
    21	            return cell.amount == probe.x;
    22	        case Op::Range:
    23	            return cell.amount >= probe.x && cell.amount <= probe.y;
    24	        case Op::IsNull:
    25	            return false;
    26	        case Op::RegionEqual:
    27	            return cell.region == probe.text;
    28	    }
    29	    return false;
    30	}
    31	
    32	}  // namespace
    33	
    34	Tally walk_row(const Slab& a, const Probe& b, const Gate& c) {
    35	    Tally tally;
    36	    if (!c.read) {
    37	        return tally;
    38	    }
    39	    tally.pages_read = 1;
    40	    for (const auto& cell : a.cells) {
    41	        const bool live = is_live(cell);
    42	        if (b.op == Op::IsNull) {
    43	            if (!live) {
    44	                ++tally.row_count;
    45	            }
    46	            continue;
    47	        }
    48	        if (live && matches(cell, b)) {
    49	            ++tally.row_count;
    50	            tally.sum_amount += cell.amount;
    51	        }
    52	    }
    53	    return tally;
    54	}
    55	
    56	}  // namespace loam
