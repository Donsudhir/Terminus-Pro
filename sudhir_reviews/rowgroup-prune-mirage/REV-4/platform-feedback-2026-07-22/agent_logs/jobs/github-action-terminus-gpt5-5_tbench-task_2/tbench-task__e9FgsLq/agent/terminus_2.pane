    23	            present: fields[1].parse()?,
    24	            amount: fields[2].parse()?,
    25	            region: fields[3].trim().to_owned(),
    26	        });
    27	    }
    28	    Ok(rows)
    29	}
    30	
    31	pub(crate) fn write_pages(path: &Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {
    32	    if let Some(parent) = path.parent() {
    33	        std::fs::create_dir_all(parent)?;
    34	    }
    35	    let file = File::create(path)?;
    36	    let mut out = BufWriter::new(file);
    37	    writeln!(out, "H|3")?;
    38	    for page in pages {
    39	        writeln!(
    40	            out,
    41	            "P|{}|{}|{}|{}|{}|{}|{}|{}",
    42	            page.id,
    43	            page.generation,
    44	            page.mark.low,
    45	            page.mark.high,
    46	            u8::from(page.mark.has_absent),
    47	            page.region_low,
    48	            page.region_high,
    49	            page.cells.len()
    50	        )?;
    51	        for cell in &page.cells {
    52	            writeln!(
    53	                out,
    54	                "R|{}|{}|{}|{}",
    55	                cell.present, cell.origin, cell.amount, cell.region
    56	            )?;
    57	        }
    58	    }
    59	    out.flush()?;
