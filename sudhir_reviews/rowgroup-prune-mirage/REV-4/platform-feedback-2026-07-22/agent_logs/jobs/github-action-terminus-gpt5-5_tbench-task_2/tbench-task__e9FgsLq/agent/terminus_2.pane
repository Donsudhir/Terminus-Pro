    10	namespace loam {
    11	namespace {
    12	
    13	std::vector<std::string> split(const std::string& line) {
    14	    std::vector<std::string> fields;
    15	    std::size_t start = 0;
    16	    while (true) {
    17	        const auto end = line.find('|', start);
    18	        fields.push_back(line.substr(start, end - start));
    19	        if (end == std::string::npos) {
    20	            break;
    21	        }
    22	        start = end + 1;
    23	    }
    24	    return fields;
    25	}
    26	
    27	}  // namespace
    28	
    29	std::vector<Slab> load_store(const std::filesystem::path& path) {
    30	    std::ifstream input(path);
    31	    if (!input) {
    32	        throw std::runtime_error("cannot open store: " + path.string());
    33	    }
    34	
    35	    std::vector<Slab> slabs;
    36	    std::string line;
    37	    while (std::getline(input, line)) {
    38	        if (line.empty() || line.rfind("H|", 0) == 0) {
    39	            continue;
    40	        }
    41	        const auto page = split(line);
    42	        if (page.size() != 9 || page[0] != "P") {
    43	            throw std::runtime_error("bad page record in " + path.string());
    44	        }
    45	        Slab slab;
    46	        slab.id = std::stoull(page[1]);
    47	        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));
    48	        slab.low = std::stoll(page[3]);
    49	        slab.high = std::stoll(page[4]);
    50	        slab.has_absent = page[5] == "1";
    51	        slab.region_low = page[6];
    52	        slab.region_high = page[7];
    53	        const auto row_count = std::stoull(page[8]);
    54	        for (std::size_t i = 0; i < row_count; ++i) {
    55	            if (!std::getline(input, line)) {
    56	                throw std::runtime_error("short page in " + path.string());
    57	            }
    58	            const auto row = split(line);
    59	            if (row.size() != 5 || row[0] != "R") {
    60	                throw std::runtime_error("bad row record in " + path.string());
    61	            }
    62	            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));
    63	            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));
    64	            const auto amount = std::stoll(row[3]);
    65	            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});
    66	            slab.presence_lane.push_back(presence);
    67	            slab.origin_lane.push_back(origin);
    68	            slab.amount_lane.push_back(amount);
    69	            slab.region_lane.push_back(row[4]);
    70	        }
    71	        slabs.push_back(std::move(slab));
    72	    }
    73	    return slabs;
    74	}
    75	
    76	CaseResult run_case(const CaseSpec& spec) {
    77	    const auto slabs = load_store(spec.store_path);
    78	    Tally total;
    79	    for (const auto& slab : slabs) {
    80	        const Gate gate = turn_b(slab, spec.probe);
    81	        const auto label = turn_d(gate, spec.probe);
    82	        (void)label;
    83	        const Tally part = spec.probe.lane == Lane::Batch
    84	            ? sweep_c(slab, spec.probe, gate)
    85	            : walk_row(slab, spec.probe, gate);
    86	        total = sweep_e(total, part);
    87	    }
    88	    return {
    89	        spec.case_id,
    90	        total,
    91	        static_cast<std::int64_t>(slabs.size()),
    92	        spec.probe.lane,
    93	        spec.probe.skipping,
    94	    };
    95	}
    96	
    97	}  // namespace loam
