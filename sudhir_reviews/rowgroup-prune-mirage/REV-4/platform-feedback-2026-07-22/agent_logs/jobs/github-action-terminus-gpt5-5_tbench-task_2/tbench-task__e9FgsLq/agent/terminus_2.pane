     5	
     6	pub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {
     7	    let file = File::open(path)?;
     8	    let mut rows = Vec::new();
     9	    for (line_no, line) in BufReader::new(file).lines().enumerate() {
    10	        let line = line?;
    11	        if line_no == 0 && line.starts_with("origin,") {
    12	            continue;
    13	        }
