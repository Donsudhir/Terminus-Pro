[?2004l#include "loam/plan.hpp"

namespace loam {
namespace {

bool legacy_origin_varies(const Slab& slab) {
    if (slab.generation >= 3) {
        return false;
    }
    for (const auto origin : slab.origin_lane) {
        if (static_cast<Origin>(origin) != Origin::Current) {
            return true;
        }
    }
    return false;
}

}  // namespace

Gate turn_b(const Slab& a, const Probe& b) {
    if (!b.skipping) {
        return {true, "full"};
    }
    if (b.op == Op::All) {
        return {true, "all"};
    }
    if (b.op == Op::IsNull) {
        const bool read = a.has_absent || legacy_origin_varies(a);
        return {read, read ? "possible" : "empty"};
    }
    if (b.op == Op::RegionEqual) {
        const bool read = b.text >= a.region_low && b.text <= a.region_high;
        return {read, read ? "text-hit" : "text-away"};
    }

    // Generation 3 stores carry faithful live-value numeric markers.  Some
    // archived generation 2 slabs were written with incomplete mixed-origin
    // markers; if a slab also records absent/non-live entries, its low/high
    // cannot safely exclude a numeric probe.  Keep selective reads fast on
    // healthy slabs, but open these legacy mixed slabs conservatively.
    if (a.generation < 3 && (a.has_absent || legacy_origin_varies(a))) {
        return {true, "legacy-open"};
    }

    const std::int64_t left = b.x;
    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;
    const bool read = !(right < a.low || left > a.high);
    return {read, read ? "range-hit" : "range-away"};
}

}  // namespace loam
