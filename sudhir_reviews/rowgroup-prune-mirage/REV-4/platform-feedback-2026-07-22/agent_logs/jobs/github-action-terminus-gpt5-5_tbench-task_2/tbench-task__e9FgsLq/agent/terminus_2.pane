[?2004l     1	#include "loam/exec.hpp"
     2	
     3	#include <cstddef>
     4	#include <vector>
     5	
     6	namespace loam {
     7	
     8	Tally sweep_c(const Slab& a, const Probe& b, const Gate& c) {
     9	    Tally tally;
    10	    if (!c.read) {
    11	        return tally;
    12	    }
    13	    tally.pages_read = 1;
    14	
    15	    const std::size_t count = a.amount_lane.size();
    16	    std::vector<unsigned char> admit(count, 0);
    17	    for (std::size_t i = 0; i < count; ++i) {
    18	        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;
    19	    }
    20	
    21	    if (b.op == Op::IsNull) {
    22	        for (std::size_t i = 0; i < count; ++i) {
    23	            if (admit[i] == 0) {
    24	                ++tally.row_count;
    25	            }
    26	        }
    27	        return tally;
    28	    }
    29	
    30	    for (std::size_t i = 0; i < count; ++i) {
    31	        if (admit[i] == 0) {
    32	            continue;
    33	        }
    34	        bool keep = false;
    35	        switch (b.op) {
    36	            case Op::All:
    37	                keep = true;
    38	                break;
    39	            case Op::Equal:
    40	                keep = a.amount_lane[i] == b.x;
    41	                break;
    42	            case Op::Range:
    43	                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;
    44	                break;
    45	            case Op::IsNull:
    46	                keep = false;
    47	                break;
    48	            case Op::RegionEqual:
    49	                keep = a.region_lane[i] == b.text;
    50	                break;
    51	        }
    52	        if (keep) {
    53	            ++tally.row_count;
    54	            tally.sum_amount += a.amount_lane[i];
    55	        }
    56	    }
    57	    return tally;
    58	}
    59	
    60	}  // namespace loam
