===== /app/rust/src/ember/reed.rs =====
     1	use crate::ember::fold::tilt_a;
     2	use crate::model::{Cell, FoldErr, Page};
     3	
     4	pub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {
     5	    let mut pages = Vec::new();
     6	    for (id, chunk) in cells.chunks(width).enumerate() {
     7	        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();
     8	        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();
     9	        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();
    10	        let mark = tilt_a(&values, &present, &origins)?;
    11	
    12	        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();
    13	        regions.sort();
    14	        let region_low = regions.first().cloned().unwrap_or_default();
    15	        let region_high = regions.last().cloned().unwrap_or_default();
    16	        pages.push(Page {
    17	            id,
    18	            generation: 3,
    19	            mark,
    20	            region_low,
    21	            region_high,
    22	            cells: chunk.to_vec(),
    23	        });
    24	    }
    25	    Ok(pages)
    26	}
===== /app/rust/src/main.rs =====
     1	mod codec;
     2	mod ember;
     3	mod model;
     4	mod report;
     5	
     6	use ember::pale::{tilt_d, Dial};
     7	use std::path::{Path, PathBuf};
     8	
     9	fn main() {
    10	    if let Err(error) = run() {
    11	        eprintln!("loam-ingest: {error}");
    12	        std::process::exit(1);
    13	    }
    14	}
    15	
    16	fn run() -> Result<(), Box<dyn std::error::Error>> {
    17	    let args: Vec<String> = std::env::args().collect();
    18	    if args.len() != 3 {
    19	        return Err("usage: loam-ingest <csv> <store>".into());
    20	    }
    21	    let cells = codec::read_csv(Path::new(&args[1]))?;
    22	    let pages = ember::reed::gather(cells, 4)?;
    23	    let directory = PathBuf::from(&args[2]);
    24	    std::fs::create_dir_all(&directory)?;
    25	    let target = directory.join("data.store");
    26	    codec::write_pages(&target, &pages)?;
    27	
    28	    let size = std::fs::metadata(&target)?.len() as usize;
    29	    let mut dial = Dial::default();
    30	    let cell_count = pages.iter().map(|page| page.cells.len()).sum();
    31	    tilt_d(&mut dial, cell_count, size);
    32	    eprintln!("{}", report::line(&dial));
    33	    Ok(())
    34	}
