[?2004l     1	#include "loam/plan.hpp"
     2	
     3	namespace loam {
     4	
     5	Gate turn_b(const Slab& a, const Probe& b) {
     6	    if (!b.skipping) {
     7	        return {true, "full"};
     8	    }
     9	    if (b.op == Op::All) {
    10	        return {true, "all"};
    11	    }
    12	    if (b.op == Op::IsNull) {
    13	        return {a.has_absent, a.has_absent ? "possible" : "empty"};
    14	    }
    15	    if (b.op == Op::RegionEqual) {
    16	        const bool read = b.text >= a.region_low && b.text <= a.region_high;
    17	        return {read, read ? "text-hit" : "text-away"};
    18	    }
    19	
    20	    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;
    21	    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;
    22	    const bool read = !(right < a.low || left > a.high);
    23	    return {read, read ? "range-hit" : "range-away"};
    24	}
    25	
    26	}  // namespace loam
