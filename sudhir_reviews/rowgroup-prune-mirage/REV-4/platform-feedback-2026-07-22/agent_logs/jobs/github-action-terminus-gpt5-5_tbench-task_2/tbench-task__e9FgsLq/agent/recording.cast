[40.614207, "o", "     1\tuse crate::model::{FoldErr, Mark};\r\n     2\t\r\n     3\tpub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n     4\t    if a.is_empty() {\r\n"]
[40.614242, "o", "     5\t        return Err(FoldErr::Empty);\r\n     6\t    }\r\n     7\t    if a.len() != b.len() || a.len() != c.len() {\r\n     8\t        return Err(FoldErr::Shape);\r\n     9\t    }\r\n"]
[40.61428, "o", "    10\t\r\n    11\t    let mut low = a[0];\r\n    12\t    let mut high = a[0];\r\n    13\t    let mut has_absent = false;\r\n    14\t    for (value, present) in a.iter().zip(b.iter()) {\r\n    15\t        low = low.min(*value);\r\n    16\t        high = high.max(*value);\r\n    17\t        has_absent |= *present == 0;\r\n    18\t    }\r\n    19\t\r\n    20\t    Ok(Mark {\r\n    21\t        low,\r\n    22"]
[40.614306, "o", "\t        high,\r\n    23\t        has_absent,\r\n    24\t    })\r\n    25\t}\r\n"]
