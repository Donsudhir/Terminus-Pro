[32.395286, "o", "     1\tuse crate::model::{Cell, Page};\r\n     2\tuse std::fs::File;\r\n     3\tuse std::io::{BufRead, BufReader, BufWriter, Write};\r\n     4\tuse std::path::Path;\r\n     5\t\r\n     6\tpub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n     7\t    let file = File::open(path)?;\r\n     8\t    let mut rows = Vec::new();\r\n     9\t    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n    10\t        let line = line?;\r\n    11\t        if line_no == 0 && line.starts_with(\"origin,\") {\r\n    12\t            continue;\r\n    13\t        }\r\n"]
[32.395317, "o", "    14\t        if line.trim().is_empty() {\r\n    15\t            continue;\r\n    16\t        }\r\n    17\t        let fields: Vec<&str> = line.split(',').collect();\r\n"]
[32.395348, "o", "    18\t        if fields.len() != 4 {\r\n    19\t            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n    20\t        }\r\n    21\t        rows.push(Cell {\r\n    22\t            origin: fields[0].parse()?,\r\n    23\t            present: fields[1].parse()?,\r\n    24\t            amount: fields[2].parse()?,\r\n    25\t            region: fields[3].trim().to_owned(),\r\n    26\t        });\r\n    27\t    }\r\n    28\t    Ok(rows)\r\n    29\t}\r\n    30\t\r\n"]
