[40.285629, "o", "    79\t    for (const auto& slab : slabs) {\r\n    80\t        const Gate gate = turn_b(slab, spec.probe);\r\n    81\t        const auto label = turn_d(gate, spec.probe);\r\n    82\t        (void)label;\r\n    83\t        const Tally part = spec.probe.lane == Lane::Batch\r\n    84\t            ? sweep_c(slab, spec.probe, gate)\r\n    85\t            : walk_row(slab, spec.probe, gate);\r\n"]
