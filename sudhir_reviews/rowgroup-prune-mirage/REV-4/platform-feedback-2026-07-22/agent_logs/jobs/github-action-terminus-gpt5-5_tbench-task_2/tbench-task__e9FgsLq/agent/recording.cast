[84.168895, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nbool legacy_origin_varies(const Slab& slab) {\r\n    if (slab.generation >= 3) {\r\n        return false;\r\n    }\r\n    for (const auto origin : slab.origin_lane) {\r\n        if (static_cast<Origin>(origin) != Origin::Current) {\r\n            return true;\r\n        }\r\n    }\r\n    return false;\r\n"]
[84.168923, "o", "}\r\n\r\n}  // namespace\r\n\r\nGate turn_b(const Slab& a, const Probe& b) {\r\n    if (!b.skipping) {\r\n        return {true, \"full\"};\r\n    }\r\n    if (b.op == Op::All) {\r\n        return {true, \"all\"};\r\n    }\r\n    if (b.op == Op::IsNull) {\r\n"]
[84.168957, "o", "        const bool read = a.has_absent || legacy_origin_varies(a);\r\n        return {read, read ? \"possible\" : \"empty\"};\r\n    }\r\n    if (b.op == Op::RegionEqual) {\r\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    }\r\n\r\n    // Generation 3 stores carry faithful live-value numeric markers.  Some\r\n    // archived generation 2 slabs were written with incomplete mixed-origin\r\n    // markers; if a slab also records absent/non-live entries, its low/high\r\n    // cannot safely exclude a numeric probe.  Keep selective reads fast on\r\n    // healthy slabs, but open these legacy mixed slabs conservatively.\r\n    if (a.generation < 3 && (a.has_absent || legacy_origin_varies(a))) {\r\n        return {true, \"legacy-open\"};\r\n    }\r\n\r\n    const std::int64_t left = b.x;\r\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    const bool read = !(right < a.low || left > a.high);\r\n    return {read, read ? \"range-hit\" : \"range-away\"};\r"]
[84.168989, "o", "\n}\r\n\r\n}  // namespace loam\r\n"]
