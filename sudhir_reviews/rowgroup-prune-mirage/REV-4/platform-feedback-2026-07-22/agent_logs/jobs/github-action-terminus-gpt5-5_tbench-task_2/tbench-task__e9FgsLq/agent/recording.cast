[32.072344, "o", "    12\t    std::uint8_t present{};\r\n    13\t    Origin origin{Origin::Current};\r\n    14\t    std::int64_t amount{};\r\n    15\t    std::string region;\r\n    16\t};\r\n    17\t\r\n    18\tstruct Slab {\r\n    19\t    std::size_t id{};\r\n    20\t    std::uint8_t generation{};\r\n    21\t    std::int64_t low{};\r\n    22\t    std::int64_t high{};\r\n    23\t    bool has_absent{};\r\n    24\t    std::string region_low;\r\n    25\t    std::string region_high;\r\n    26\t    std::vector<Cell> cells;\r\n    27\t    std::vector<std::int64_t> amount_lane;\r\n    28\t    std::vector<std::uint8_t> presence_lane;\r\n    29\t    std::vector<std::uint8_t> origin_lane;\r\n    30\t    std::vector<std::string> region_lane;\r\n    31\t};\r\n    32\t\r\n"]
[32.072377, "o", "    33\tenum class Op { All, Equal, Range, IsNull, RegionEqual };\r\n    34\tenum class Lane { Row, Batch };\r\n    35\t\r\n    36\tstruct Probe {\r\n    37\t    Op op{Op::All};\r\n    38\t    std::int64_t x{};\r\n    39\t    std::int64_t y{};\r\n    40\t    std::string text;\r\n    41\t    Lane lane{Lane::Row};\r\n    42\t    bool skipping{};\r\n    43\t};\r\n"]
