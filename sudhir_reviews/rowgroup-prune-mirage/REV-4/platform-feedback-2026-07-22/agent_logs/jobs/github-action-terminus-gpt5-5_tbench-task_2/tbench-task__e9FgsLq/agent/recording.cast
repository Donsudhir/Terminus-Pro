[38.990029, "o", "     1\t#include \"loam/plan.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4\t\r\n     5\tGate turn_b(const Slab& a, const Probe& b) {\r\n     6\t    if (!b.skipping) {\r\n     7\t        return {true, \"full\"};\r\n     8\t    }"]
[38.990068, "o", "\r\n     9\t    if (b.op == Op::All) {\r\n    10\t        return {true, \"all\"};\r\n    11\t    }\r\n    12\t    if (b.op == Op::IsNull) {\r\n    13\t        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\r\n    14\t    }\r\n    15\t"]
[38.990101, "o", "    if (b.op == Op::RegionEqual) {\r\n    16\t        const bool read = b.text >= a.region_low && b.text <= a.region_high;\r\n    17\t        return {read, read ? \"text-hit\" : \"text-away\"};\r\n    18\t    }\r\n    19\t\r\n    20\t    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\r\n    21\t    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\r\n    22\t    const bool read = !(right < a.low || left > a.high);\r\n    23\t    return {read, read ? \"range-hit\" : \"range-away\"};\r\n    24\t}\r\n    25\t\r\n    26\t}  // namespace loam\r\n"]
[38.990397, "o", "\u001b[?2004hroot@d9a5bbe0-aedd-44fa-a7ef-3b2294bb5b51:/app# "]
