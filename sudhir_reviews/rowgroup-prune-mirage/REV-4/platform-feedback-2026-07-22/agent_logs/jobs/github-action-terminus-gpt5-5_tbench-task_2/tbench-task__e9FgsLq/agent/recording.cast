[32.080282, "o", "    89\t        spec.case_id,\r\n    90\t        total,\r\n    91\t        static_cast<std::int64_t>(slabs.size()),\r\n    92\t        spec.probe.lane,\r\n    93\t        spec.probe.skipping,\r\n    94\t    };\r\n    95\t}\r\n    96\t\r\n"]
