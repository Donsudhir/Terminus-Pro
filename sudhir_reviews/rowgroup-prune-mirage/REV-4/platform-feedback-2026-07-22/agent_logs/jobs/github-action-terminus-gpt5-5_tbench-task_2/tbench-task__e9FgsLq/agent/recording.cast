[39.313417, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\tnamespace loam {\r\n     4\t\r\n"]
[39.313429, "o", "     5\tTally sweep_e(const Tally& a, const Tally& b) {\r\n     6\t    return {\r\n     7\t        a.row_count + b.row_count,\r\n     8\t        a.sum_amount + b.sum_amount,\r\n     9\t        a.pages_read + b.pages_read,\r\n    10\t    };\r\n    11"]
