[84.518315, "i", "cat > /app/rust/src/ember/fold.rs <<'RS'\nuse crate::model::{FoldErr, Mark, RUNE_FIXED, RUNE_VOID};\n\nfn is_live(present: u8, origin: u8) -> bool {\n    if origin == RUNE_VOID {\n        return false;\n    }\n    if origin == RUNE_FIXED {\n        return true;\n    }\n    present != 0\n}\n\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\n    if a.is_empty() {\n        return Err(FoldErr::Empty);\n    }\n    if a.len() != b.len() || a.len() != c.len() {\n        return Err(FoldErr::Shape);\n    }\n\n    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        if is_live(*present, *origin) {\n            low = Some(low.map_or(*value, |current| current.min(*value)));\n            high = Some(high.map_or(*value, |current| current.max(*value)));\n        } else {\n            has_absent = true;\n        }\n    }\n\n    Ok(Mark {\n        low: low.unwrap_or(0),\n        high: high.un"]
[84.518407, "i", "wrap_or(0),\n        has_absent,\n    })\n}\nRS\ncat /app/rust/src/ember/fold.rs\n"]
[84.518493, "o", "cat > /app/rust/src/ember/fold.rs <<'RS'\r\n"]
