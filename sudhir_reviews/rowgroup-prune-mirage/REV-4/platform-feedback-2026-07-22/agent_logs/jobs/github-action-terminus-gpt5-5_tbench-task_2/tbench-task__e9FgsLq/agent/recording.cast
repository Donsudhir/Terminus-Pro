[32.08016, "o", "    39\t            continue;\r\n    40\t        }\r\n    41\t        const auto page = split(line);\r\n    42\t        if (page.size() != 9 || page[0] != \"P\") {\r\n    43\t            throw std::runtime_error(\"bad page record in \" + path.string());\r\n    44\t        }\r\n    45\t        Slab slab;\r\n    46\t        slab.id = std::stoull(page[1]);\r\n    47\t        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n    48\t        slab.low = std::stoll(page[3]);\r\n    49\t        slab.high = std::stoll(page[4]);\r\n"]
