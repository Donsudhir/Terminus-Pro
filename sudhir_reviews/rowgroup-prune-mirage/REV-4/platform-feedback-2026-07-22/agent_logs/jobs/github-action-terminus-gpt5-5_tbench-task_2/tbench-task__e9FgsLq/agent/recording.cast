[40.618638, "o", "     1\t#[derive(Clone, Debug, Default)]\r\n     2\tpub(crate) struct Dial {\r\n     3\t    pub jobs: usize,\r\n     4\t    pub cells: usize,\r\n     5\t    pub bytes: usize,\r\n     6\t}\r\n     7\t\r\n     8\t"]
[40.618654, "o", "pub(crate) fn tilt_d(a: &mut Dial, b: usize, c: usize) {\r\n     9\t    a.jobs += 1;\r\n    10\t    a.cells += b;\r\n    11\t    a.bytes += c;\r\n    12\t}\r\n"]
[40.618926, "o", "/app/rust/src/ember/reed.rs\r\n"]
[40.619536, "o", "===== /app/rust/src/ember/reed.rs =====\r\n"]
[40.620549, "o", "     1\tuse crate::ember::fold::tilt_a;\r\n     2\tuse crate::model::{Cell, FoldErr, Page};\r\n     3\t\r\n     4\tpub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n     5\t    let mut pages = Vec::new();\r\n     6\t    for (id, chunk) in cells.chunks(width).enumerate() {\r\n     7\t        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n     8\t        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n     9\t        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n    10\t        let mark = tilt_a(&values, &present, &origins)?;\r\n    11\t\r\n    12\t        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n    13\t        regions.sort();\r\n    14\t        let region_low = regions.first().cloned().unwrap_or_default();\r\n    15\t        let region_high = regions.last().cloned().unwrap_or_default();\r\n    16\t        pages.push(Page {\r\n    17\t            id,\r\n    18\t            generation: 3,\r\n    19"]
[40.620568, "o", "\t            mark,\r\n    20\t            region_low,\r\n    21\t            region_high,\r\n    22\t            cells: chunk.to_vec(),\r\n    23\t        });\r\n    24\t    }\r\n    25\t    Ok(pages)\r\n    26\t}\r\n"]
