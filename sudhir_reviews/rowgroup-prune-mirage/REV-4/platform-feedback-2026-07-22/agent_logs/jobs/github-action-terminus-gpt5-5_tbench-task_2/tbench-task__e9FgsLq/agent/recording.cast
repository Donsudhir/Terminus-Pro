[24.885746, "o", "/app/data/cases/incident.case\r\n"]
[24.886487, "o", "# id|store|operation|x|y|path|skipping|operator note\r\nm_range|/app/data/archive/mixed.store|range|10|40|row|1|invoice window\r\nm_narrow|/app/data/archive/mixed.store|range|10|20|row|1|narrow window\r\nm_null|/app/data/archive/mixed.store|isnull|0|0|batch|0|missing count\r\nm_interact|/app/data/archive/mixed.store|range|-1000|25|batch|1|mixed window\r\nm_neg|/app/data/archive/mixed.store|range|-100|-1|batch|0|negative window\r\nm_all|/app/data/archive/mixed.store|all|0|0|batch|0|full tally\r\nv_window|/app/data/archive/vault.store|range|10|50|row|1|vault window\r\nv_missing|/app/data/archive/vault.store|isnull|0|0|batch|1|vault absent probe\r\nv_check|/app/data/archive/vault.store|isnull|0|0|row|1|vault absent recheck\r\nv_full|/app/data/archive/vault.store|isnull|0|0|row|0|vault full control\r\n"]
