[32.403032, "o", "     1\tuse crate::ember::fold::tilt_a;\r\n     2\t"]
[32.40307, "o", "use crate::model::{Cell, FoldErr, Page};\r\n     3\t\r\n"]
[32.403097, "o", "     4\tpub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n     5\t    let mut pages = Vec::new();\r\n     6\t    for (id, chunk) in cells.chunks(width).enumerate() {\r\n     7\t        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n     8\t        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n     9\t        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n    10\t        let mark = tilt_a(&values, &present, &origins)?;\r\n"]
[32.403118, "o", "    11\t\r\n    12\t        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n    13\t        regions.sort();\r\n"]
[32.403141, "o", "    14\t        let region_low = regions.first().cloned().unwrap_or_default();\r\n    15\t        let region_high = regions.last().cloned().unwrap_or_default();\r\n    16\t        pages.push(Page {\r\n"]
[32.403168, "o", "    17\t            id,\r\n    18\t            generation: 3,\r\n    19\t            mark,\r\n    20\t            region_low,\r\n"]
[32.403187, "o", "    21\t            region_high,\r\n"]
[32.403207, "o", "    22\t            cells: chunk.to_vec(),\r\n    23\t        });\r\n    24\t    }\r\n    25\t"]
[32.403222, "o", "    Ok(pages)\r\n    26\t}\r\n"]
[32.403587, "o", "===== /app/rust/src/main.rs =====\r\n"]
[32.405032, "o", "     1\tmod codec;\r\n     2\tmod ember;\r\n     3\tmod model;\r\n     4\tmod report;\r\n     5\t\r\n     6\tuse ember::pale::{tilt_d, Dial};\r\n     7\tuse std::path::{Path, PathBuf};\r\n     8\t\r\n     9\tfn main() {\r\n    10\t    if let Err(error) = run() {\r\n    11\t        eprintln!(\"loam-ingest: {error}\");\r\n"]
[32.405049, "o", "    12\t        std::process::exit(1);\r\n    13\t    }\r\n"]
[32.405065, "o", "    14\t}\r\n    15\t\r\n    16\tfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    17\t    let args: Vec<String> = std::env::args().collect();\r\n    18\t    if args.len() != 3 {\r\n    19\t        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    20\t    }\r\n    21\t    let cells = codec::read_csv(Path::new(&args[1]))?;"]
[32.405088, "o", "\r\n    22\t    let pages = ember::reed::gather(cells, 4)?;\r\n    23\t    let directory = PathBuf::from(&args[2]);\r\n    24\t    std::fs::create_dir_all(&directory)?;\r\n    25\t    let target = directory.join(\"data.store\");\r\n"]
[32.405107, "o", "    26\t    codec::write_pages(&target, &pages)?;\r\n    27\t\r\n    28\t    let size = std::fs::metadata(&target)?.len() as usize;\r\n    29\t    let mut dial = Dial::default();\r\n    30\t    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    31\t    tilt_d(&mut dial, cell_count, size);\r\n    32\t    eprintln!(\"{}\", report::line(&dial));\r\n    33\t    Ok(())\r\n    34\t}\r\n"]
[32.40532, "o", "===== /app/rust/src/model.rs =====\r\n"]
[32.406599, "o", "     1\tpub(crate) const RUNE_VOID: u8 = 0;\r\n     2\tpub(crate) const RUNE_FIXED: u8 = 1;\r\n     3\t\r\n     4\t#[derive(Clone, Debug)]\r\n     5\tpub(crate) struct Cell {\r\n     6"]
[32.406633, "o", "\t    pub origin: u8,\r\n     7\t    pub present: u8,\r\n     8\t    pub amount: i64,\r\n     9\t    pub region: String,\r\n    10\t}\r\n    11\t\r\n"]
[32.406698, "o", "    12\t#[derive(Clone, Debug)]\r\n    13\tpub(crate) struct Mark {\r\n    14\t    pub low: i64,\r\n    15\t    pub high: i64,\r\n    16\t    pub has_absent: bool,\r\n    17\t}\r\n    18\t\r\n    19\t#[derive(Clone, Debug)]\r\n    20\tpub(crate) struct Page {\r\n    21\t    pub id: usize,\r\n    22\t    pub generation: u8,\r\n    23\t    pub mark: Mark,\r\n"]
[32.406723, "o", "    24\t    pub region_low: String,\r\n    25\t    pub region_high: String,\r\n    26\t    pub cells: Vec<Cell>,\r\n    27\t}\r\n    28\t\r\n    29\t#[derive(Debug)]\r\n    30\tpub(crate) enum FoldErr {\r\n    31\t    Empty,\r\n    32\t    Shape,\r\n"]
[32.406747, "o", "    33\t}\r\n    34\t\r\n    35\timpl std::fmt::Display for FoldErr {\r\n    36\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n    37\t        match self {\r\n    38\t            Self::Empty => write!(f, \"empty lane set\"),\r\n    39\t            Self::Shape => write!(f, \"lane lengths differ\"),\r\n    40\t        }\r\n    41\t    }\r\n"]
[32.406777, "o", "    42\t}\r\n    43\t\r\n    44\timpl std::error::Error for FoldErr {}\r\n"]
[32.40698, "o", "===== /app/rust/src/report.rs =====\r\n"]
[32.409153, "o", "     1\tuse crate::ember::pale::Dial;\r\n     2\t\r\n     3\tpub(crate) fn line(a: &Dial) -> String {\r\n     4\t    format!(\"jobs={} cells={} bytes={}\", a.jobs, a.cells, a.bytes)\r\n     5\t}\r\n"]
