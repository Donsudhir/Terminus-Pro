[25.893814, "o", "sed -n '1,240p' /app/cpp/src/parse.cpp\r\n"]
[25.893828, "o", "\u001b[?2004l\r"]
[25.895015, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n"]
[25.895636, "o", "        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n   "]
[25.895656, "o", " }\r\n    std::sort(paths.begin(), paths.end());\r\n\r\n    std::vector<CaseSpec> cases;\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n            "]
[25.895666, "o", "cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[25.895859, "o", "\u001b[?2004hroot@d9a5bbe0-aedd-44fa-a7ef-3b2294bb5b51:/app# "]
[26.172595, "i", "sed -n '1,260p' /app/cpp/src/main.cpp\n"]
[26.172758, "o", "sed -n '1,260p' /app/cpp/src/main.cpp\r\n\u001b[?2004l\r"]
[26.174212, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n#include <unistd.h>\r\n#include <vector>\r\n\r\nnamespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n"]
[26.174236, "o", "    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n"]
[26.174249, "o", "    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n\r\n}  // namespace\r\n\r\n"]
[26.174381, "o", "int main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          <<"]
[26.174412, "o", " '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                  << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
[26.174554, "o", "\u001b[?2004h"]
[26.174585, "o", "root@d9a5bbe0-aedd-44fa-a7ef-3b2294bb5b51:/app# "]
[26.485547, "i", "sed -n '1,260p' /app/rust/src/codec.rs\n"]
[26.485743, "o", "sed -n '1,260p' /app/rust/src/codec.rs\r\n\u001b[?2004l\r"]
[26.486924, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n    let file = File::open(path)?;\r\n"]
[26.486968, "o", "    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n        }\r\n"]
[26.487006, "o", "        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n        if fields.len() != 4 {\r\n            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n}\r\n\r\npub(crate) fn write_pages(path: &Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high"]
[26.487027, "o", ",\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,\r\n            page.region_high,\r\n            page.cells.len()\r\n        )?;\r\n        for cell in &page.cells {\r\n            writeln!(\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n"]
[26.487055, "o", "    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[26.487245, "o", "\u001b[?2004h"]
[26.487264, "o", "root@d9a5bbe0-aedd-44fa-a7ef-3b2294bb5b51:/app# "]
[26.860708, "i", "sed -n '1,240p' /app/rust/src/main.rs\n"]
[26.860866, "o", "sed -n '1,240p' /app/rust/src/main.rs\r\n\u001b[?2004l\r"]
[26.86201, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\nuse ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n"]
[26.862044, "o", "\r\nfn main() {\r\n    if let Err(error) = run() {\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n"]
[26.862066, "o", "    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n"]
[26.862096, "o", "    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n"]
[26.862121, "o", "    Ok(())\r\n}\r\n"]
[26.862312, "o", "\u001b[?2004h"]
[26.862332, "o", "root@d9a5bbe0-aedd-44fa-a7ef-3b2294bb5b51:/app# "]
