[40.285295, "o", "     1\t#include \"loam/store.hpp\"\r\n     2\t\r\n     3\t#include \"loam/exec.hpp\"\r\n     4\t#include \"loam/plan.hpp\"\r\n     5\t\r\n     6\t#include <fstream>\r\n     7\t#include <stdexcept>\r\n     8\t#include <string>\r\n     9\t\r\n    10\tnamespace loam {\r\n    11\tnamespace {\r\n"]
[40.285369, "o", "    12\t\r\n    13\tstd::vector<std::string> split(const std::string& line) {\r\n    14\t    std::vector<std::string> fields;\r\n    15\t    std::size_t start = 0;\r\n    16\t    while (true) {\r\n    17\t        const auto end = line.find('|', start);\r\n    18\t        fields.push_back(line.substr(start, end - start));\r\n    19\t        if (end == std::string::npos) {\r\n    20\t            break;\r\n    21\t        }\r\n    22\t        start = end + 1;\r\n"]
[40.285412, "o", "    23\t    }\r\n    24\t    return fields;\r\n    25\t}\r\n    26\t\r\n    27\t}  // namespace\r\n    28\t\r\n    29\tstd::vector<Slab> load_store(const std::filesystem::path& path) {\r\n    30\t    std::ifstream input(path);\r\n    31\t    if (!input) {\r\n    32\t        throw std::runtime_error(\"cannot open store: \" + path.string());\r\n    33\t    }\r\n    34\t\r\n    35\t    std::vector<Slab> slabs;\r\n    36\t    std::string line;\r\n    37\t    while (std::getline(input, line)) {\r\n    38\t        if (line.empty() || line.rfind(\"H|\", 0) == 0) {\r\n    39\t            continue;\r\n    40\t        }\r\n    41\t        const auto page = split(line);\r\n    42\t        if (page.size() != 9 || page[0] != \"P\") {\r\n"]
[40.285439, "o", "    43\t            throw std::runtime_error(\"bad page record in \" + path.string());\r\n    44\t        }\r\n    45\t        Slab slab;\r\n    46\t        slab.id = std::stoull(page[1]);\r\n"]
[40.285467, "o", "    47\t        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n    48\t        slab.low = std::stoll(page[3]);\r\n    49\t        slab.high = std::stoll(page[4]);\r\n    50\t        slab.has_absent = page[5] == \"1\";\r\n    51\t        slab.region_low = page[6];\r\n    52\t        slab.region_high = page[7];\r\n    53\t        const auto row_count = std::stoull(page[8]);\r\n"]
[40.285497, "o", "    54\t        for (std::size_t i = 0; i < row_count; ++i) {\r\n    55\t            if (!std::getline(input, line)) {\r\n    56\t                throw std::runtime_error(\"short page in \" + path.string());\r\n    57\t            }\r\n    58\t            const auto row = split(line);\r\n    59\t            if (row.size() != 5 || row[0] != \"R\") {\r\n    60\t                throw std::runtime_error(\"bad row record in \" + path.string());\r\n    61\t            }\r\n"]
[40.285529, "o", "    62\t            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));\r\n    63\t            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));\r\n    64\t            const auto amount = std::stoll(row[3]);\r\n    65\t            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});\r\n    66\t            slab.presence_lane.push_back(presence);\r\n    67\t            slab.origin_lane.push_back(origin);\r\n"]
