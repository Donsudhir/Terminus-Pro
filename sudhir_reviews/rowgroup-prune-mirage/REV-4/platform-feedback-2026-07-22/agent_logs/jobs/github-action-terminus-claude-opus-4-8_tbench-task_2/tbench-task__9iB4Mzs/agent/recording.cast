[26.296258, "o", "#!/bin/bash\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\r\nmkdir -p \"$ROOT/bin\"\r\n\r\ncargo build --manifest-path \"$ROOT/rust/Cargo.toml\" --release --offline\r\nmake -C \"$ROOT/cpp\" clean all\r\ninstall -m 0755 \"$ROOT/rust/target/release/loam-ingest\" \"$ROOT/bin/loam-ingest\"\r\ninstall -m 0755 \"$ROOT/cpp/build/loam\" \"$ROOT/bin/loam\"\r\n"]
[26.296523, "o", "\u001b[?2004hroot@6d0a6e3d-fdf7-4011-af75-3ff5a105876f:/app# "]
