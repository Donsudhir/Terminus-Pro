[129.12894, "o", "\r\n/app/data/archive/current.store:P|1|3|100|130|0|north|south|4\r\n/app/data/archive/healthy.store:P|0|3|0|30|0|east|west|4\r\n/app/data/archive/healthy.store:P|1|3|100|130|0|north|south|4\r\n/app/data/archive/healthy.store:P|2|3|200|230|0|central|west|4\r\n/app/data/archive/mixed.store:P|0|2|100|100|1|east|west|4\r\n/app/data/archive/mixed.store:P|1|3|30|600|0|north|south|4\r\n/app/data/archive/mixed.store:P|2|3|-5|-5|0|central|central|1\r\n/app/data/archive/mixed.store:P|3|3|200|400|0|east|west|3\r\n/app/data/archive/vault.store:P|0|2|5|30|0|north|west|4\r\n/app/data/archive/vault.store:P|1|3|40|70|0|north|south|4\r\n/app/data/archive/vault.store:P|2|2|-20|90|1|central|east|3\r\n\u001b[?2004hroot@6d0a6e3d-fdf7-4011-af75-3ff5a105876f:/app# "]
[164.498188, "i", "cat > /app/cpp/src/lattice/rill.cpp <<'EOF'\n#include \"loam/exec.hpp\"\n\n#include <cstddef>\n#include <vector>\n\nnamespace loam {\nnamespace {\n\nbool lane_is_live(std::uint8_t origin, std::uint8_t present) {\n    // Mirror the row reader's liveness contract exactly.\n    if (origin == static_cast<std::uint8_t>(Origin::Retired)) {\n        return false;\n    }\n    if (origin == static_cast<std::uint8_t>(Origin::Inherited)) {\n        return true;\n    }\n    return present != 0;\n}\n\n}  // namespace\n\nTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\n    Tally tally;\n    if (!c.read) {\n        return tally;\n    }\n    tally.pages_read = 1;\n\n    const std::size_t count = a.amount_lane.size();\n    std::vector<unsigned char> admit(count, 0);\n    for (std::size_t i = 0; i < count; ++i) {\n        admit[i] = lane_is_live(a.origin_lane[i], a.presence_lane[i]) ? 1 : 0;\n    }\n\n    if (b.op == Op::IsNull) {\n        for (std::size_t i = 0; i < count; ++i) {\n            if (admit[i] == 0) {\n                ++tally.row_count;\n  "]
[164.498482, "i", "          }\n        }\n        return tally;\n    }\n\n    for (std::size_t i = 0; i < count; ++i) {\n        if (admit[i] == 0) {\n            continue;\n        }\n        bool keep = false;\n        switch (b.op) {\n            case Op::All:\n                keep = true;\n                break;\n            case Op::Equal:\n                keep = a.amount_lane[i] == b.x;\n                break;\n            case Op::Range:\n                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\n                break;\n            case Op::IsNull:\n                keep = false;\n                break;\n            case Op::RegionEqual:\n                keep = a.region_lane[i] == b.text;\n                break;\n        }\n        if (keep) {\n            ++tally.row_count;\n            tally.sum_amount += a.amount_lane[i];\n        }\n    }\n    return tally;\n}\n\n}  // namespace loam\nEOF\n"]
