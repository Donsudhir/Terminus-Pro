Sending keys: ['cat > /app/cpp/src/harbor/veil.cpp <<\'EOF\'\n#include "loam/plan.hpp"\n\nnamespace loam {\nnamespace {\n\n// Markers (low/high/has_absent/region_low/region_high) are only trustworthy\n// on faithfully written slabs. Archived mixed-generation slabs (older\n// generations) carry incomplete markers, so selective admission must not skip\n// them; the reader opens them and lets the exact per-cell scan decide.\nconstexpr std::uint8_t kFaithfulGeneration = 3;\n\nbool markers_faithful(const Slab& a) {\n    return a.generation >= kFaithfulGeneration;\n}\n\n}  // namespace\n\nGate turn_b(const Slab& a, const Probe& b) {\n    if (!b.skipping) {\n        return {true, "full"};\n    }\n    if (b.op == Op::All) {\n        return {true, "all"};\n    }\n    if (!markers_faithful(a)) {\n        return {true, "unfaithful-markers"};\n    }\n    if (b.op == Op::IsNull) {\n        return {a.has_absent, a.has_absent ? "possible" : "empty"};\n    }\n    if (b.op == Op::RegionEqual) {\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\n        return {read, read ? "text-hit" : "text-away"};\n    }\n\n    const std::int64_t left = b.op == Op::Equal ? b.x : b.x;\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\n    const bool read = !(right < a.low || left > a.high);\n    return {read, read ? "range-hit" : "range-away"};\n}\n\n}  // namespace loam\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
