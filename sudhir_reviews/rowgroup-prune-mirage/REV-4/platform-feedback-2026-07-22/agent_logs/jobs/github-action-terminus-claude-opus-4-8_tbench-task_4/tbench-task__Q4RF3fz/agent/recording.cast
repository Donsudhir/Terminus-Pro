[11.591511, "o", "cat /app/tools/build-all /app/tools/reset-lab /app/Makefile\r\n\u001b[?2004l\r"]
[11.592403, "o", "#!/bin/bash\r\nset -euo pipefail\r\n\r\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\r\nmkdir -p \"$ROOT/bin\"\r\n\r\ncargo build --manifest-path \"$ROOT/rust/Cargo.toml\" --release --offline\r\nmake -C \"$ROOT/cpp\" clean all\r\ninstall -m 0755 \"$ROOT/rust/target/release/loam-ingest\" \"$ROOT/bin/loam-ingest\"\r\ninstall -m 0755 \"$ROOT/cpp/build/loam\" \"$ROOT/bin/loam\"\r\n"]
[11.59249, "o", "#!/bin/bash\r\nset -euo pipefail\r\n\r\nrm -rf /app/data\r\nmkdir -p /app/data\r\ncp -R /opt/loam-seed/. /app/data/\r\nrm -rf /app/output\r\nmkdir -p /app/output\r\n"]
[11.592554, "o", ".PHONY: all clean\r\n\r\nall:\r\n\t./tools/build-all\r\n\r\nclean:\r\n\t$(MAKE) -C cpp clean\r\n\trm -rf rust/target bin\r\n"]
