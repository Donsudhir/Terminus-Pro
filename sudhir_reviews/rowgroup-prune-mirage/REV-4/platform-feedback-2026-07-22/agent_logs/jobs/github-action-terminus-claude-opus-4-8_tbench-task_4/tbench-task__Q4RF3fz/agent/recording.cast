[262.365035, "i", "cat > /app/rust/src/ember/fold.rs << 'EOF'\nuse crate::model::{FoldErr, Mark};\n\nfn is_live(origin: u8, present: u8) -> bool {\n    match origin {\n        0 => false,        // Retired: never live\n        1 => true,         // Inherited: always live\n        _ => present != 0, // Current: live when present\n    }\n}\n\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\n    if a.is_empty() {\n        return Err(FoldErr::Empty);\n    }\n    if a.len() != b.len() || a.len() != c.len() {\n        return Err(FoldErr::Shape);\n    }\n\n    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        if is_live(*origin, *present) {\n            low = Some(low.map_or(*value, |l| l.min(*value)));\n            high = Some(high.map_or(*value, |h| h.max(*value)));\n        } else {\n            has_absent = true;\n        }\n    }\n\n    // A slab whose entries are all non-live records low 0"]
[262.365149, "i", ", high 0, has_absent.\n    Ok(Mark {\n        low: low.unwrap_or(0),\n        high: high.unwrap_or(0),\n        has_absent,\n    })\n}\nEOF\n"]
