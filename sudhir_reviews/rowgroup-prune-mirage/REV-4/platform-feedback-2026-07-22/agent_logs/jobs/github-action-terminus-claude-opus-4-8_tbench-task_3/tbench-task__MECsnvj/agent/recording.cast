[253.439953, "i", "cat > /app/cpp/src/harbor/veil.cpp << 'EOF'\n#include \"loam/plan.hpp\"\n\nnamespace loam {\n\nGate turn_b(const Slab& a, const Probe& b) {\n    if (!b.skipping) {\n        return {true, \"full\"};\n    }\n    if (b.op == Op::All) {\n        return {true, \"all\"};\n    }\n    // Older-generation slabs predate faithful live-value markers: their low,\n    // high, and has_absent fields follow legacy conventions and may include\n    // non-live amounts or under-report absent entries. Skipping on them is\n    // unsafe, so admit them unconditionally and let the reader tally the\n    // real cells. Only current-generation markers are trusted for skipping.\n    if (a.generation < 3) {\n        return {true, \"legacy\"};\n    }\n    if (b.op == Op::IsNull) {\n        return {a.has_absent, a.has_absent ? \"possible\" : \"empty\"};\n    }\n    if (b.op == Op::RegionEqual) {\n        const bool read = b.text >= a.region_low && b.text <= a.region_high;\n        return {read, read ? \"text-hit\" : \"text-away\"};\n    }\n\n    const std::int64_t left = b.op == Op"]
[253.439998, "i", "::Equal ? b.x : b.x;\n    const std::int64_t right = b.op == Op::Equal ? b.x : b.y;\n    const bool read = !(right < a.low || left > a.high);\n    return {read, read ? \"range-hit\" : \"range-away\"};\n}\n\n}  // namespace loam\nEOF\n"]
