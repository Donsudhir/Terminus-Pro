[95.948823, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\nuse ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n\r\nfn main() {\r\n    if let Err(error) = run() {\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n    Ok(())\r\n}\r\n"]
[95.949039, "o", "\u001b[?2004hroot@fe722ac7-9c23-4e6d-8058-20e8defc1436:/app# "]
[96.287004, "i", "cat /app/rust/src/model.rs\n"]
[96.287129, "o", "cat /app/rust/src/model.rs\r\n\u001b[?2004l\r"]
[96.288181, "o", "pub(crate) const RUNE_VOID: u8 = 0;\r\npub(crate) const RUNE_FIXED: u8 = 1;\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Cell {\r\n    pub origin: u8,\r\n    pub present: u8,\r\n    pub amount: i64,\r\n    pub region: String,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Mark {\r\n    pub low: i64,\r\n    pub high: i64,\r\n    pub has_absent: bool,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Page {\r\n    pub id: usize,\r\n    pub generation: u8,\r\n    pub mark: Mark,\r\n    pub region_low: String,\r\n"]
[96.288218, "o", "    pub region_high: String,\r\n    pub cells: Vec<Cell>,\r\n}\r\n\r\n#[derive(Debug)]\r\npub(crate) enum FoldErr {\r\n    Empty,\r\n    Shape,\r\n}\r\n\r\nimpl std::fmt::Display for FoldErr {\r\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n        match self {\r\n            Self::Empty => write!(f, \"empty lane set\"),\r\n            Self::Shape => write!(f, \"lane lengths differ\"),\r\n        }\r\n    }\r\n}\r\n\r\n"]
[96.288255, "o", "impl std::error::Error for FoldErr {}\r\n"]
[96.288417, "o", "\u001b[?2004h"]
[96.28844, "o", "root@fe722ac7-9c23-4e6d-8058-20e8defc1436:/app# "]
[100.883072, "i", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/fold.rs\n"]
[100.883291, "o", "cat /app/rust/src/ember/mod.rs /app/rust/src/ember/fold.rs\r\n\u001b[?2004l\r"]
[100.884135, "o", "pub(crate) mod fold;\r\npub(crate) mod pale;\r\npub(crate) mod reed;\r\n"]
[100.884182, "o", "use crate::model::{FoldErr, Mark};\r\n\r\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\r\n    if a.is_empty() {\r\n        return Err(FoldErr::Empty);\r\n    }\r\n    if a.len() != b.len() || a.len() != c.len() {\r\n        return Err(FoldErr::Shape);\r\n    }\r\n\r\n    let mut low = a[0];\r\n    let mut high = a[0];\r\n    let mut has_absent = false;\r\n    for (value, present) in a.iter().zip(b.iter()) {\r\n        low = low.min(*value);\r\n        high = high.max(*value);\r\n        has_absent |= *present == 0;\r\n    }\r\n\r\n    Ok(Mark {\r\n        low,\r\n        high,\r\n        has_absent,\r\n    })\r\n}\r\n"]
[100.884397, "o", "\u001b[?2004hroot@fe722ac7-9c23-4e6d-8058-20e8defc1436:/app# "]
[108.870917, "i", "cat /app/rust/src/ember/reed.rs\n"]
[108.871069, "o", "cat /app/rust/src/ember/reed.rs\r\n\u001b[?2004l\r"]
[108.872922, "o", "use crate::ember::fold::tilt_a;\r\nuse crate::model::{Cell, FoldErr, Page};\r\n\r\npub(crate) fn gather(cells: Vec<Cell>, width: usize) -> Result<Vec<Page>, FoldErr> {\r\n    let mut pages = Vec::new();\r\n    for (id, chunk) in cells.chunks(width).enumerate() {\r\n        let values: Vec<i64> = chunk.iter().map(|cell| cell.amount).collect();\r\n        let present: Vec<u8> = chunk.iter().map(|cell| cell.present).collect();\r\n        let origins: Vec<u8> = chunk.iter().map(|cell| cell.origin).collect();\r\n"]
[108.872938, "o", "        let mark = tilt_a(&values, &present, &origins)?;\r\n\r\n        let mut regions: Vec<String> = chunk.iter().map(|cell| cell.region.clone()).collect();\r\n        regions.sort();\r\n        let region_low = regions.first().cloned().unwrap_or_default();\r\n        let region_high = regions.last().cloned().unwrap_or_default();\r\n        pages.push(Page {\r\n            id,"]
[108.873067, "o", "\r\n            generation: 3,\r\n            mark,\r\n            region_low,"]
[108.873089, "o", "\r\n            region_high,\r\n            cells: chunk.to_vec(),\r\n        });\r\n    }\r\n    Ok(pages)\r\n}\r\n"]
[108.873248, "o", "\u001b[?2004h"]
[108.873258, "o", "root@fe722ac7-9c23-4e6d-8058-20e8defc1436:/app# "]
[109.20641, "i", "cat /app/rust/src/ember/pale.rs\n"]
[109.206558, "o", "cat /app/rust/src/ember/pale.rs\r\n\u001b[?2004l\r"]
[109.20773, "o", "#[derive(Clone, Debug, Default)]\r\npub(crate) struct Dial {\r\n    pub jobs: usize,\r\n    pub cells: usize,\r\n    pub bytes: usize,\r\n}\r\n\r\npub(crate) fn tilt_d(a: &mut Dial, b: usize, c: usize) {\r\n    a.jobs += 1;\r\n    a.cells += b;\r\n    a.bytes += c;\r\n}\r\n"]
[109.207939, "o", "\u001b[?2004h"]
