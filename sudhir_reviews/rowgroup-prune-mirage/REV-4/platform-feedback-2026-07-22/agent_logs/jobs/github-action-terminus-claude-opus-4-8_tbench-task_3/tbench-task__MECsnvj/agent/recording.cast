[265.267187, "i", "cat > /app/rust/src/ember/fold.rs << 'EOF'\nuse crate::model::{FoldErr, Mark};\n\nconst ORIGIN_RETIRED: u8 = 0;\nconst ORIGIN_INHERITED: u8 = 1;\n\nfn is_live(present: u8, origin: u8) -> bool {\n    match origin {\n        ORIGIN_RETIRED => false,\n        ORIGIN_INHERITED => true,\n        _ => present != 0,\n    }\n}\n\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\n    if a.is_empty() {\n        return Err(FoldErr::Empty);\n    }\n    if a.len() != b.len() || a.len() != c.len() {\n        return Err(FoldErr::Shape);\n    }\n\n    let mut low: Option<i64> = None;\n    let mut high: Option<i64> = None;\n    let mut has_absent = false;\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\n        if is_live(*present, *origin) {\n            low = Some(low.map_or(*value, |current| current.min(*value)));\n            high = Some(high.map_or(*value, |current| current.max(*value)));\n        } else {\n            has_absent = true;\n        }\n    }\n\n    // A slab whose entries are all n"]
[265.267302, "i", "on-live records low 0, high 0, has_absent true.\n    let (low, high) = match (low, high) {\n        (Some(l), Some(h)) => (l, h),\n        _ => (0, 0),\n    };\n\n    Ok(Mark {\n        low,\n        high,\n        has_absent,\n    })\n}\nEOF\n"]
