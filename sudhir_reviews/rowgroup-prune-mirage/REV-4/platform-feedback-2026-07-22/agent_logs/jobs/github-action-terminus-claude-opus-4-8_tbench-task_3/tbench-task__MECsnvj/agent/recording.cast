[55.953192, "o", "cat /app/cpp/src/harbor/pale.cpp\r\n\u001b[?2004l\r"]
[55.954384, "o", "#include \"loam/plan.hpp\"\r\n\r\nnamespace loam {\r\n\r\nstd::string turn_d(const Gate& a, const Probe& b) {\r\n    const char* lane = b.lane == Lane::Batch ? \"batch\" : \"row\";\r\n    return std::string(lane) + \":\" + (a.read ? \"open:\" : \"closed:\") + a.note;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[55.954562, "o", "\u001b[?2004hroot@fe722ac7-9c23-4e6d-8058-20e8defc1436:/app# "]
