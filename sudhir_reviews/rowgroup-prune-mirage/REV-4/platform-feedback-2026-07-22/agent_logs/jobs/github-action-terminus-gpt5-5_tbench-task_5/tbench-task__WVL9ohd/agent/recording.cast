[25.834325, "o", "    15\t    std::size_t start = 0;\r\n    16\t    while (true) {\r\n    17\t        const auto end = line.find('|', start);\r\n    18\t        fields.push_back(line.substr(start, end - start));\r\n    19\t        if (end == std::string::npos) {\r\n    20\t            break;\r\n    21\t        }\r\n    22\t        start = end + 1;\r\n    23\t    }\r\n    24\t    return fields;\r\n    25\t}\r\n    26\t\r\n    27\t}  // namespace\r\n    28\t\r\n    29\tstd::vector<Slab> load_store(const std::filesystem::path& path) {\r\n    30\t    std::ifstream input(path);\r\n    31\t    if (!input) {\r\n    32\t        throw std::runtime_error(\"cannot open store: \" + path.string());\r\n"]
[25.834403, "o", "    33\t    }\r\n    34\t\r\n    35\t    std::vector<Slab> slabs;\r\n    36\t    std::string line;\r\n    37\t    while (std::getline(input, line)) {\r\n    38\t        if (line.empty() || line.rfind(\"H|\", 0) == 0) {\r\n    39\t            continue;\r\n    40\t        }\r\n    41\t        const auto page = split(line);\r\n    42\t        if (page.size() != 9 || page[0] != \"P\") {\r\n    43\t            throw std::runtime_error(\"bad page record in \" + path.string());\r\n    44\t        }\r\n    45\t        Slab slab;\r\n    46\t        slab.id = std::stoull(page[1]);\r\n    47\t        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n    48\t        slab.low = std::stoll(page[3]);\r\n    49\t        slab.high = std::stoll(page[4]);\r\n    50\t        slab.has_absent = page[5] == \"1\";\r\n    51\t        slab.region_low = page[6];\r\n    52\t        slab.region_high = page[7];\r\n    53\t        const auto row_count = std::stoull(page[8]);\r\n    54\t        for (std::size_t i = 0; i < row_count; ++i) {\r\n    55\t            if (!std::getline(input, line)) {"]
[25.834437, "o", "\r\n    56\t                throw std::runtime_error(\"short page in \" + path.string());\r\n    57\t            }\r\n    58\t            const auto row = split(line);\r\n    59\t            if (row.size() != 5 || row[0] != \"R\") {\r\n    60\t                throw std::runtime_error(\"bad row record in \" + path.string());\r\n    61\t            }\r\n    62\t            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));\r\n    63\t            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));\r\n"]
[25.834466, "o", "    64\t            const auto amount = std::stoll(row[3]);\r\n    65\t            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});\r\n    66\t            slab.presence_lane.push_back(presence);\r\n    67\t            slab.origin_lane.push_back(origin);\r\n    68\t            slab.amount_lane.push_back(amount);\r\n    69\t            slab.region_lane.push_back(row[4]);\r\n    70\t        }\r\n    71\t        slabs.push_back(std::move(slab));\r\n    72\t    }\r\n    73\t    return slabs;\r\n    74"]
[25.834504, "o", "\t}\r\n    75\t\r\n    76\tCaseResult run_case(const CaseSpec& spec) {\r\n    77\t    const auto slabs = load_store(spec.store_path);\r\n    78\t    Tally total;\r\n    79\t    for (const auto& slab : slabs) {\r\n    80\t        const Gate gate = turn_b(slab, spec.probe);\r\n    81\t        const auto label = turn_d(gate, spec.probe);\r\n    82\t        (void)label;\r\n    83\t        const Tally part = spec.probe.lane == Lane::Batch\r\n    84\t            ? sweep_c(slab, spec.probe, gate)\r\n    85\t            : walk_row(slab, spec.probe, gate);\r\n"]
[25.834544, "o", "    86\t        total = sweep_e(total, part);\r\n    87\t    }\r\n    88\t    return {\r\n    89\t        spec.case_id,\r\n    90\t        total,\r\n    91\t        static_cast<std::int64_t>(slabs.size()),\r\n    92\t        spec.probe.lane,\r\n    93\t        spec.probe.skipping,\r\n    94\t    };\r\n    95\t}\r\n    96\t\r\n    97\t}  // namespace loam\r\n"]
