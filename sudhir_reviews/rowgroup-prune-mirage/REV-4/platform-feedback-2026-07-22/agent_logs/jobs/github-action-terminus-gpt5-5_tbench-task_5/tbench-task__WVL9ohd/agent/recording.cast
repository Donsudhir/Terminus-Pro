[26.758258, "o", "    11\tnamespace {\r\n    12\t\r\n    13\tint run_ingest(const char* input, const char* output) {\r\n    14\t    const pid_t child = fork();\r\n    15\t    if (child == -1) {\r\n    16\t        throw std::runtime_error(\"fork failed\");\r\n    17\t    }\r\n    18\t    if (child == 0) {\r\n    19\t        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n    20\t        _exit(127);\r\n    21\t    }\r\n    22\t    int status = 0;\r\n    23\t    if (waitpid(child, &status, 0) == -1) {\r\n    24\t        throw std::runtime_error(\"waitpid failed\");\r\n    25\t    }\r\n    26\t    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n    27\t}\r\n"]
[26.758313, "o", "    28\t\r\n    29\t}  // namespace\r\n    30\t\r\n    31\tint main(int argc, char** argv) {\r\n    32\t    try {\r\n    33\t        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n    34\t            const auto specs = loam::load_cases(argv[2]);\r\n    35\t            std::vector<loam::CaseResult> results;\r\n    36\t            results.reserve(specs.size());\r\n    37\t            for (const auto& spec : specs) {\r\n    38\t                results.push_back(loam::run_case(spec));\r\n    39\t            }\r\n    40\t            loam::write_report(argv[3], results);\r\n    41\t            return 0;\r\n    42\t        }\r\n    43\t        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n    44\t            return run_ingest(argv[2], argv[3]);\r\n    45\t        }\r\n    46\t        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n    47\t            const auto slabs = loam::load_store(argv[2]);\r\n    48\t            for (const auto& slab : slabs) {\r\n    49\t                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n    50\t   "]
[26.75837, "o", "                       << '|' << slab.low << '|' << slab.high << '|'\r\n    51\t                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n    52\t                          << '\\n';\r\n    53\t            }\r\n    54\t            return 0;\r\n    55\t        }\r\n    56\t        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n    57\t                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n    58\t                  << \"       loam inspect <store>\\n\";\r\n    59\t        return 2;\r\n    60\t    } catch (const std::exception& error) {\r\n    61\t        std::cerr << \"loam: \" << error.what() << '\\n';\r\n    62\t        return 1;\r\n    63\t    }\r\n    64\t}\r\n"]
