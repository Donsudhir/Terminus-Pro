[108.666817, "o", "s=s.replace('''use crate::model::{FoldErr, Mark};\\n\\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\\n    if a.is_empty() {\\n        return Err(FoldErr::Empty);\\n    }\\n    if a.len() != b.len() || a.len() != c.len() {\\n        return Err(FoldErr::Shape);\\n    }\\n\\n    let mut low = a[0];\\n    let mut high = a[0];\\n    let mut has_absent = false;\\n    for (value, present) in a.iter().zip(b.iter()) {\\n        low = low.min(*value);\\n        high = high.max(*value);\\n        has_absent |= *present == 0;\\n    }\\n\\n    Ok(Mark {\\n        low,\\n        high,\\n        has_absent,\\n    })\\n}\\n''', '''use crate::model::{FoldErr, Mark};\\n\\nfn is_live(present: u8, origin: u8) -> bool {\\n    match origin {\\n        0 => false,\\n        1 => true,\\n        _ => present != 0,\\n    }\\n}\\n\\npub(crate) fn tilt_a(a: &[i64], b: &[u8], c: &[u8]) -> Result<Mark, FoldErr> {\\n    if a.is_empty() {\\n        return Err(FoldErr::Empty);\\n    }\\n    if a.len() != b.len() || a.len() != c.len() {\\n        "]
[108.666922, "o", "return Err(FoldErr::Shape);\\n    }\\n\\n    let mut low = 0;\\n    let mut high = 0;\\n    let mut saw_live = false;\\n    let mut has_absent = false;\\n\\n    for ((value, present), origin) in a.iter().zip(b.iter()).zip(c.iter()) {\\n        if is_live(*present, *origin) {\\n            if !saw_live {\\n                low = *value;\\n                high = *value;\\n                saw_live = true;\\n            } else {\\n                low = low.min(*value);\\n                high = high.max(*value);\\n            }\\n        } else {\\n            has_absent = true;\\n        }\\n    }\\n\\n    if !saw_live {\\n        has_absent = true;\\n    }\\n\\n    Ok(Mark {\\n        low,\\n        high,\\n        has_absent,\\n    })\\n}\\n''')\r\n\u001b[?2004l\r"]
