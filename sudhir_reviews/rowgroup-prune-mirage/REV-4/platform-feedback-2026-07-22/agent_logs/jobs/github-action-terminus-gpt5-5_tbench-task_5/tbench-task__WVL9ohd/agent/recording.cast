[41.359075, "o", "     7\tnamespace loam {\r\n     8\tnamespace {\r\n     9\t\r\n    10\tstd::string escape_json(const std::string& value) {\r\n    11\t    std::string out;\r\n    12\t    for (const char ch : value) {\r\n    13\t        if (ch == '\"' || ch == '\\\\') {\r\n    14\t            out.push_back('\\\\');\r\n    15\t        }\r\n    16\t        out.push_back(ch);\r\n    17\t    }\r\n    18\t    return out;\r\n    19\t}\r\n    20\t\r\n    21\tstd::string cases_json(const std::vector<CaseResult>& cases) {\r\n    22\t    std::ostringstream out;\r\n"]
[41.359103, "o", "    23\t    out << '[';\r\n    24\t    for (std::size_t i = 0; i < cases.size(); ++i) {\r\n    25\t        if (i != 0) out << ',';\r\n    26\t        const auto& item = cases[i];\r\n    27\t        out << \"{\\\"case_id\\\":\\\"\" << escape_json(item.case_id)\r\n    28\t            << \"\\\",\\\"row_count\\\":\" << item.tally.row_count\r\n"]
[41.359131, "o", "    29\t            << \",\\\"sum_amount\\\":\" << item.tally.sum_amount\r\n    30\t            << \",\\\"pages_total\\\":\" << item.pages_total\r\n    31\t            << \",\\\"pages_read\\\":\" << item.tally.pages_read\r\n    32\t            << \",\\\"path\\\":\\\"\" << lane_name(item.lane)\r\n    33\t            << \"\\\",\\\"skipping\\\":\" << (item.skipping ? \"true\" : \"false\")\r\n    34\t            << '}';\r\n    35\t    }\r\n    36\t    out << ']';\r\n    37\t    return out.str();\r\n"]
[41.359166, "o", "    38\t}\r\n    39\t\r\n    40\t}  // namespace\r\n    41\t\r\n    42\tstd::string lane_name(const Lane lane) {\r\n    43\t    return lane == Lane::Batch ? \"batch\" : \"row\";\r\n    44\t}\r\n    45\t\r\n    46\tvoid write_report(const std::filesystem::path& path, const std::vector<CaseResult>& cases) {\r\n    47"]
[41.359193, "o", "\t    if (path.has_parent_path()) {\r\n    48\t        std::filesystem::create_directories(path.parent_path());\r\n    49\t    }\r\n    50\t    const std::string body = cases_json(cases);\r\n    51\t    const std::string digest = digest_hex(body);\r\n    52\t    std::ofstream output(path, std::ios::binary | std::ios::trunc);\r\n    53\t    if (!output) {\r\n    54\t        throw std::runtime_error(\"cannot write report: \" + path.string());\r\n    55\t    }\r\n    56\t    output << \"{\\\"status\\\":\\\"complete\\\",\\\"cases\\\":\" << body\r\n    57\t           << \",\\\"digest\\\":\\\"\" << digest << \"\\\"}\\n\";\r\n    58\t}\r\n    59\t\r\n    60\t}  // namespace loam\r\n"]
