[18.361084, "o", "#include \"loam/exec.hpp\"\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nbool is_live(const Cell& cell) {\r\n    if (cell.origin == Origin::Retired) {\r\n        return false;\r\n"]
[18.361142, "o", "    }\r\n    if (cell.origin == Origin::Inherited) {\r\n        return true;\r\n    }\r\n    return cell.present != 0;\r\n}\r\n\r\nbool matches(const Cell& cell, const Probe& probe) {\r\n    switch (probe.op) {\r\n        case Op::All:\r\n"]
[18.36116, "o", "            return true;\r\n        case Op::Equal:\r\n            return cell.amount == probe.x;\r\n        case Op::Range:\r\n            return cell.amount >= probe.x && cell.amount <= probe.y;\r\n        case Op::IsNull:\r\n            return false;\r\n        case Op::RegionEqual:\r\n            return cell.region == probe.text;\r\n    }\r\n    return false;\r\n}\r\n\r\n}  // namespace\r\n\r\nTally walk_row(const Slab& a, const Probe& b, const Gate& c) {\r\n    Tally tally;\r\n    if (!c.read) {\r\n"]
[18.361168, "o", "        return tally;\r\n    }\r\n    tally.pages_read = 1;\r\n    for (const auto& cell : a.cells) {\r\n"]
[18.361179, "o", "        const bool live = is_live(cell);\r\n        if (b.op == Op::IsNull) {\r\n            if (!live) {\r\n                ++tally.row_count;\r\n            }"]
[18.361194, "o", "\r\n            continue;\r\n        }\r\n        if (live && matches(cell, b)) {\r\n            ++tally.row_count;\r\n"]
[18.361212, "o", "            tally.sum_amount += cell.amount;\r\n        }\r\n    }\r\n    return tally;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[18.361432, "o", "\u001b[?2004hroot@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[18.36154, "o", "sed -n '1,200p' /app/cpp/src/digest.cpp\r\n\u001b[?2004l\r"]
[18.362923, "o", "#include \"loam/report.hpp\"\r\n\r\n#include <cstdint>\r\n#include <iomanip>\r\n#include <sstream>\r\n\r\nnamespace loam {\r\n\r\nstd::string digest_hex(const std::string& text) {\r\n    std::uint64_t value = 1469598103934665603ULL;\r\n"]
[18.36297, "o", "    for (const unsigned char byte : text) {\r\n        value ^= byte;\r\n        value *= 1099511628211ULL;\r\n"]
[18.362997, "o", "    }\r\n    std::ostringstream out;\r\n    out << std::hex << std::setfill('0') << std::setw(16) << value;\r\n    return out.str();\r\n}\r\n\r\n}  // namespace loam\r\n"]
[18.36317, "o", "\u001b[?2004h"]
