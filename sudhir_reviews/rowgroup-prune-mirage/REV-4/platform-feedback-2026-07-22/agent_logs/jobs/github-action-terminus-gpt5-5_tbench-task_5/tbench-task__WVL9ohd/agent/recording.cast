[40.328383, "o", "     1\t#include \"loam/exec.hpp\"\r\n     2\t\r\n     3\t#include <cstddef>\r\n     4\t#include <vector>\r\n     5\t\r\n     6\tnamespace loam {\r\n     7\t\r\n     8\tTally sweep_c(const Slab& a, const Probe& b, const Gate& c) {\r\n     9\t    Tally tally;\r\n    10\t    if (!c.read) {\r\n    11\t        return tally;\r\n"]
[40.328459, "o", "    12\t    }\r\n    13\t    tally.pages_read = 1;\r\n    14\t\r\n    15\t    const std::size_t count = a.amount_lane.size();\r\n    16\t    std::vector<unsigned char> admit(count, 0);\r\n    17\t    for (std::size_t i = 0; i < count; ++i) {\r\n    18\t        admit[i] = a.presence_lane[i] != 0 ? 1 : 0;\r\n    19\t    }\r\n    20\t\r\n    21\t    if (b.op == Op::IsNull) {\r\n    22\t        for (std::size_t i = 0; i < count; ++i) {\r\n    23\t            if (admit[i] == 0) {\r\n    24\t                ++tally.row_count;\r\n    25\t            }\r\n    26\t        }\r\n    27\t        return tally;\r\n    28\t    }\r\n    29\t\r\n    30\t    for (std::size_t i = 0; i < count; ++i) {\r\n    31\t        if (admit[i] == 0) {\r\n    32\t            continue;\r\n    33\t        }\r\n    34\t        bool keep = false;\r\n    35\t        switch (b.op) {\r\n    36\t            case Op::All:\r\n    37\t                keep = true;\r\n    38\t                break;\r\n    39\t            case Op::Equal:\r\n    40\t                keep = a.amount_lane[i] == b.x;\r\n    41\t                break;\r\n    42\t   "]
[40.328508, "o", "         case Op::Range:\r\n    43\t                keep = a.amount_lane[i] >= b.x && a.amount_lane[i] <= b.y;\r\n    44\t                break;\r\n    45\t            case Op::IsNull:\r\n    46\t                keep = false;\r\n    47\t                break;\r\n    48\t            case Op::RegionEqual:\r\n    49\t                keep = a.region_lane[i] == b.text;\r\n    50\t                break;\r\n    51\t        }\r\n    52\t        if (keep) {\r\n    53\t            ++tally.row_count;\r\n    54\t            tally.sum_amount += a.amount_lane[i];\r\n    55\t        }\r\n    56\t    }\r\n    57\t    return tally;\r\n    58\t}\r\n    59\t\r\n    60\t}  // namespace loam\r\n"]
