[18.897219, "i", "sed -n '1,260p' /app/rust/src/main.rs\nsed -n '1,260p' /app/rust/src/codec.rs\nsed -n '1,220p' /app/rust/src/model.rs\n"]
[18.897417, "o", "sed -n '1,260p' /app/rust/src/main.rs\r\n"]
[18.897446, "o", "\u001b[?2004l\r"]
[18.898884, "o", "mod codec;\r\nmod ember;\r\nmod model;\r\nmod report;\r\n\r\n"]
[18.898923, "o", "use ember::pale::{tilt_d, Dial};\r\nuse std::path::{Path, PathBuf};\r\n\r\nfn main() {\r\n    if let Err(error) = run() {\r\n        eprintln!(\"loam-ingest: {error}\");\r\n        std::process::exit(1);\r\n"]
[18.898947, "o", "    }\r\n}\r\n\r\nfn run() -> Result<(), Box<dyn std::error::Error>> {\r\n    let args: Vec<String> = std::env::args().collect();\r\n    if args.len() != 3 {\r\n        return Err(\"usage: loam-ingest <csv> <store>\".into());\r\n    }\r\n"]
[18.898981, "o", "    let cells = codec::read_csv(Path::new(&args[1]))?;\r\n    let pages = ember::reed::gather(cells, 4)?;\r\n    let directory = PathBuf::from(&args[2]);\r\n    std::fs::create_dir_all(&directory)?;\r\n    let target = directory.join(\"data.store\");\r\n    codec::write_pages(&target, &pages)?;\r\n"]
[18.898997, "o", "\r\n    let size = std::fs::metadata(&target)?.len() as usize;\r\n    let mut dial = Dial::default();\r\n    let cell_count = pages.iter().map(|page| page.cells.len()).sum();\r\n    tilt_d(&mut dial, cell_count, size);\r\n    eprintln!(\"{}\", report::line(&dial));\r\n    Ok(())\r\n}\r\n"]
[18.899222, "o", "\u001b[?2004h"]
[18.899246, "o", "root@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[18.899345, "o", "sed -n '1,260p' /app/rust/src/codec.rs\r\n"]
[18.899369, "o", "\u001b[?2004l\r"]
[18.900457, "o", "use crate::model::{Cell, Page};\r\nuse std::fs::File;\r\nuse std::io::{BufRead, BufReader, BufWriter, Write};\r\nuse std::path::Path;\r\n\r\npub(crate) fn read_csv(path: &Path) -> Result<Vec<Cell>, Box<dyn std::error::Error>> {\r\n"]
[18.900486, "o", "    let file = File::open(path)?;\r\n    let mut rows = Vec::new();\r\n    for (line_no, line) in BufReader::new(file).lines().enumerate() {\r\n        let line = line?;\r\n        if line_no == 0 && line.starts_with(\"origin,\") {\r\n            continue;\r\n"]
[18.900526, "o", "        }\r\n        if line.trim().is_empty() {\r\n            continue;\r\n        }\r\n        let fields: Vec<&str> = line.split(',').collect();\r\n        if fields.len() != 4 {\r\n            return Err(format!(\"{}:{}: expected four columns\", path.display(), line_no + 1).into());\r\n        }\r\n        rows.push(Cell {\r\n            origin: fields[0].parse()?,\r\n            present: fields[1].parse()?,\r\n            amount: fields[2].parse()?,\r\n            region: fields[3].trim().to_owned(),\r\n        });\r\n    }\r\n    Ok(rows)\r\n"]
[18.900557, "o", "}\r\n\r\npub(crate) fn write_pages(path: &Path, pages: &[Page]) -> Result<(), Box<dyn std::error::Error>> {\r\n    if let Some(parent) = path.parent() {\r\n        std::fs::create_dir_all(parent)?;\r\n    }\r\n    let file = File::create(path)?;\r\n    let mut out = BufWriter::new(file);\r\n    writeln!(out, \"H|3\")?;\r\n    for page in pages {\r\n        writeln!(\r\n            out,\r\n            \"P|{}|{}|{}|{}|{}|{}|{}|{}\",\r\n            page.id,\r\n            page.generation,\r\n            page.mark.low,\r\n            page.mark.high,\r\n            u8::from(page.mark.has_absent),\r\n            page.region_low,"]
[18.900579, "o", "\r\n            page.region_high,\r\n            page.cells.len()\r\n        )?;\r\n        for cell in &page.cells {\r\n            writeln!("]
[18.900606, "o", "\r\n                out,\r\n                \"R|{}|{}|{}|{}\",\r\n                cell.present, cell.origin, cell.amount, cell.region\r\n            )?;\r\n        }\r\n    }\r\n    out.flush()?;\r\n    Ok(())\r\n}\r\n"]
[18.900798, "o", "\u001b[?2004h"]
[18.90082, "o", "root@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[18.900913, "o", "sed -n '1,220p' /app/rust/src/model.rs\r\n\u001b[?2004l\r"]
[18.901996, "o", "pub(crate) const RUNE_VOID: u8 = 0;\r\npub(crate) const RUNE_FIXED: u8 = 1;\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Cell {\r\n"]
[18.90202, "o", "    pub origin: u8,\r\n    pub present: u8,\r\n    pub amount: i64,\r\n    pub region: String,\r\n"]
[18.902049, "o", "}\r\n\r\n#[derive(Clone, Debug)]\r\npub(crate) struct Mark {\r\n    pub low: i64,\r\n    pub high: i64,\r\n    pub has_absent: bool,\r\n}\r\n\r\n#[derive(Clone, Debug)]\r\n"]
[18.902094, "o", "pub(crate) struct Page {\r\n    pub id: usize,\r\n    pub generation: u8,\r\n    pub mark: Mark,\r\n    pub region_low: String,\r\n    pub region_high: String,\r\n    pub cells: Vec<Cell>,\r\n}\r\n\r\n#[derive(Debug)]\r\npub(crate) enum FoldErr {\r\n    Empty,\r\n    Shape,\r\n}\r\n"]
[18.902155, "o", "\r\nimpl std::fmt::Display for FoldErr {\r\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\r\n        match self {\r\n            Self::Empty => write!(f, \"empty lane set\"),\r\n            Self::Shape => write!(f, \"lane lengths differ\"),\r\n        }\r\n    }\r\n}\r\n\r\nimpl std::error::Error for FoldErr {}\r\n"]
