[17.381136, "o", "\u001b[?2004hroot@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[17.858572, "i", "sed -n '1,240p' /app/cpp/src/store.cpp\nsed -n '1,240p' /app/cpp/src/main.cpp\nsed -n '1,220p' /app/cpp/src/parse.cpp\n"]
[17.858769, "o", "sed -n '1,240p' /app/cpp/src/store.cpp\r\n\u001b[?2004l\r"]
[17.860159, "o", "#include \"loam/store.hpp\"\r\n\r\n#include \"loam/exec.hpp\"\r\n#include \"loam/plan.hpp\"\r\n\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\nnamespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<Slab> load_store(const std::filesystem::path& path) {\r\n    std::ifstream input(path);\r\n    if (!input) {\r\n        throw std::runtime_error(\"cannot open store: \" + path.string());\r\n    }\r\n\r\n    std::vector<Slab> slabs;\r\n    std::string line;\r\n    while (std::getline(input, line)) {\r\n        if (line.empty() || line.rfind(\"H|\", 0) == 0) {\r\n            continue;\r\n        }\r\n        const auto page = split(line);\r\n        if (page"]
[17.860187, "o", ".size() != 9 || page[0] != \"P\") {\r\n            throw std::runtime_error(\"bad page record in \" + path.string());\r\n        }\r\n        Slab slab;\r\n        slab.id = std::stoull(page[1]);\r\n        slab.generation = static_cast<std::uint8_t>(std::stoul(page[2]));\r\n        slab.low = std::stoll(page[3]);\r\n        slab.high = std::stoll(page[4]);\r\n        slab.has_absent = page[5] == \"1\";\r\n        slab.region_low = page[6];\r\n        slab.region_high = page[7];\r\n        const auto row_count = std::stoull(page[8]);\r\n        for (std::size_t i = 0; i < row_count; ++i) {\r\n            if (!std::getline(input, line)) {\r\n                throw std::runtime_error(\"short page in \" + path.string());\r\n            }\r\n            const auto row = split(line);\r\n            if (row.size() != 5 || row[0] != \"R\") {\r\n                throw std::runtime_error(\"bad row record in \" + path.string());\r\n            }\r\n"]
[17.860214, "o", "            const auto presence = static_cast<std::uint8_t>(std::stoul(row[1]));\r\n            const auto origin = static_cast<std::uint8_t>(std::stoul(row[2]));\r\n            const auto amount = std::stoll(row[3]);\r\n            slab.cells.push_back({presence, static_cast<Origin>(origin), amount, row[4]});\r\n            slab.presence_lane.push_back(presence);\r\n            slab.origin_lane.push_back(origin);\r\n"]
[17.860379, "o", "            slab.amount_lane.push_back(amount);\r\n            slab.region_lane.push_back(row[4]);\r\n        }\r\n        slabs.push_back(std::move(slab));\r\n    }\r\n    return slabs;\r\n}\r\n\r\nCaseResult run_case(const CaseSpec& spec) {\r\n    const auto slabs = load_store(spec.store_path);\r\n    Tally total;\r\n    for (const auto& slab : slabs) {\r\n        const Gate gate = turn_b(slab, spec.probe);\r\n        const auto label = turn_d(gate, spec.probe);\r\n        (void)label;\r\n        const Tally part = spec.probe.lane == Lane::Batch\r\n            ? sweep_c(slab, spec.probe, gate)\r\n            : walk_row(slab, spec.probe, gate);\r\n        total = sweep_e(total, part);\r\n    }\r\n    return {\r\n        spec.case_id,\r\n        total,\r\n        static_cast<std::int64_t>(slabs.size()),\r\n        spec.probe.lane,\r\n        spec.probe.skipping,\r\n    };\r\n}\r\n\r\n}  // namespace loam\r\n"]
[17.860531, "o", "\u001b[?2004hroot@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[17.860623, "o", "sed -n '1,240p' /app/cpp/src/main.cpp\r\n\u001b[?2004l\r"]
[17.861678, "o", "#include \"loam/report.hpp\"\r\n#include \"loam/store.hpp\"\r\n\r\n#include <filesystem>\r\n#include <iostream>\r\n#include <stdexcept>\r\n#include <sys/wait.h>\r\n"]
[17.861727, "o", "#include <unistd.h>\r\n#include <vector>\r\n\r\nnamespace {\r\n\r\nint run_ingest(const char* input, const char* output) {\r\n    const pid_t child = fork();\r\n    if (child == -1) {\r\n        throw std::runtime_error(\"fork failed\");\r\n    }\r\n    if (child == 0) {\r\n        execl(\"/app/bin/loam-ingest\", \"loam-ingest\", input, output, nullptr);\r\n        _exit(127);\r\n    }\r\n    int status = 0;\r\n    if (waitpid(child, &status, 0) == -1) {\r\n        throw std::runtime_error(\"waitpid failed\");\r\n    }\r\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;\r\n}\r\n"]
[17.861776, "o", "\r\n}  // namespace\r\n\r\nint main(int argc, char** argv) {\r\n    try {\r\n        if (argc == 4 && std::string(argv[1]) == \"audit\") {\r\n            const auto specs = loam::load_cases(argv[2]);\r\n            std::vector<loam::CaseResult> results;\r\n"]
[17.861833, "o", "            results.reserve(specs.size());\r\n            for (const auto& spec : specs) {\r\n                results.push_back(loam::run_case(spec));\r\n            }\r\n            loam::write_report(argv[3], results);\r\n            return 0;\r\n        }\r\n        if (argc == 4 && std::string(argv[1]) == \"ingest\") {\r\n            return run_ingest(argv[2], argv[3]);\r\n        }\r\n        if (argc == 3 && std::string(argv[1]) == \"inspect\") {\r\n            const auto slabs = loam::load_store(argv[2]);\r\n            for (const auto& slab : slabs) {\r\n                std::cout << slab.id << '|' << static_cast<int>(slab.generation)\r\n                          << '|' << slab.low << '|' << slab.high << '|'\r\n                          << (slab.has_absent ? 1 : 0) << '|' << slab.cells.size()\r\n                          << '\\n';\r\n            }\r\n            return 0;\r\n        }\r\n        std::cerr << \"usage: loam audit <case-directory> <report-path>\\n\"\r\n                  << \"       loam ingest <csv> <store-directory>\\n\"\r\n                 "]
[17.861865, "o", " << \"       loam inspect <store>\\n\";\r\n        return 2;\r\n    } catch (const std::exception& error) {\r\n        std::cerr << \"loam: \" << error.what() << '\\n';\r\n        return 1;\r\n    }\r\n}\r\n"]
[17.862, "o", "\u001b[?2004h"]
[17.862018, "o", "root@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
[17.862119, "o", "sed -n '1,220p' /app/cpp/src/parse.cpp\r\n\u001b[?2004l\r"]
[17.863345, "o", "#include \"loam/store.hpp\"\r\n\r\n#include <algorithm>\r\n#include <fstream>\r\n#include <stdexcept>\r\n#include <string>\r\n\r\nnamespace loam {\r\n"]
[17.863379, "o", "namespace {\r\n\r\nstd::vector<std::string> split(const std::string& line) {\r\n    std::vector<std::string> fields;\r\n    std::size_t start = 0;\r\n    while (true) {\r\n        const auto end = line.find('|', start);\r\n        fields.push_back(line.substr(start, end - start));\r\n        if (end == std::string::npos) {\r\n            break;\r\n        }\r\n        start = end + 1;\r\n    }\r\n    return fields;\r\n}\r\n"]
[17.863402, "o", "\r\nOp parse_op(const std::string& value) {\r\n    if (value == \"all\") return Op::All;\r\n    if (value == \"eq\") return Op::Equal;\r\n    if (value == \"range\") return Op::Range;\r\n    if (value == \"isnull\") return Op::IsNull;\r\n    if (value == \"region_eq\") return Op::RegionEqual;\r\n    throw std::runtime_error(\"unknown operation: \" + value);\r\n}\r\n\r\nLane parse_lane(const std::string& value) {\r\n"]
[17.863431, "o", "    if (value == \"row\") return Lane::Row;\r\n    if (value == \"batch\") return Lane::Batch;\r\n    throw std::runtime_error(\"unknown path: \" + value);\r\n}\r\n\r\n}  // namespace\r\n\r\nstd::vector<CaseSpec> load_cases(const std::filesystem::path& directory) {\r\n    std::vector<std::filesystem::path> paths;\r\n    for (const auto& entry : std::filesystem::directory_iterator(directory)) {\r\n        if (entry.is_regular_file() && entry.path().extension() == \".case\") {\r\n            paths.push_back(entry.path());\r\n        }\r\n    }\r\n    std::sort(paths.begin(), paths.end());\r\n"]
[17.863461, "o", "\r\n    std::vector<CaseSpec> cases;\r\n    for (const auto& path : paths) {\r\n        std::ifstream input(path);\r\n        if (!input) {\r\n            throw std::runtime_error(\"cannot open case file: \" + path.string());\r\n        }\r\n        std::string line;\r\n        while (std::getline(input, line)) {\r\n            if (line.empty() || line[0] == '#') {\r\n                continue;\r\n            }\r\n            const auto fields = split(line);\r\n"]
[17.863483, "o", "            if (fields.size() != 8) {\r\n                throw std::runtime_error(\"bad case row in \" + path.string());\r\n            }\r\n            Probe probe;\r\n            probe.op = parse_op(fields[2]);\r\n            if (probe.op == Op::RegionEqual) {\r\n                probe.text = fields[3];\r\n            } else {\r\n                probe.x = std::stoll(fields[3]);\r\n                probe.y = std::stoll(fields[4]);\r\n            }\r\n"]
[17.863504, "o", "            probe.lane = parse_lane(fields[5]);\r\n            probe.skipping = fields[6] == \"1\";\r\n            cases.push_back({fields[0], fields[1], std::move(probe)});\r\n        }\r\n    }\r\n    return cases;\r\n}\r\n\r\n}  // namespace loam\r\n"]
[17.863713, "o", "\u001b[?2004hroot@fe235c13-c054-4119-9fa0-e69d44d4c050:/app# "]
