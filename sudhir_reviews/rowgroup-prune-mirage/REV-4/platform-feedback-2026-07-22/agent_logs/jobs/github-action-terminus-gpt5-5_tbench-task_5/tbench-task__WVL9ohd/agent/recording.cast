[17.374386, "o", "H|2\r\nP|0|2|100|100|1|east|west|4\r\nR|1|0|-999|east\r\nR|1|2|10|east\r\nR|1|2|20|west\r\nR|0|2|777|west\r\nP|1|3|30|600|0|north|south|4\r\nR|1|2|30|north\r\nR|1|2|40|north\r\nR|1|2|500|south\r\n"]
