# Bundled laboratory families
family aurora
point 11 0@0 0@0 0@0
point 12 7@0 1@0 2@0
point 13 1@0 8@0 3@0
point 14 2@0 1@0 9@0
point 15 6@0 5@0 4@0
point 16 -3@0 4@0 2@0
point 17 3@0 -2@0 5@0
variant base 0 0@0 0@0 0@0
variant upper 420 1@500 -3@490 5@480
variant lower -420 -7@-300 2@-310 9@-320
end

family meridian
point 21 -4@0 -3@0 1@0
point 22 5@0 -2@0 0@0
point 23 -1@0 6@0 2@0
point 24 2@0 1@0 8@0
point 25 7@0 4@0 5@0
point 26 -5@0 3@0 6@0
point 27 4@0 -6@0 3@0
point 28 0@0 2@0 -4@0
variant base 0 0@0 0@0 0@0
variant far 380 3@520 1@510 -2@500
variant near -380 5@-250 -4@-260 7@-270
end

family prism
point 31 0@-2 0@-2 0@-2
point 32 9@-2 1@-1 1@0
point 33 1@-1 7@-2 3@-1
point 34 3@-2 1@0 5@-1
point 35 5@-1 3@-1 7@-2
point 36 -3@-1 5@-2 1@0
point 37 7@-2 -5@-2 3@-1
variant base 0 0@0 0@0 0@0
variant raised 360 1@470 2@460 -1@450
variant reduced -360 -2@-280 3@-290 1@-300
end
