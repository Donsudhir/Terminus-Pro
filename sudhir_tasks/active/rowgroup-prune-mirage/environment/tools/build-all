#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$ROOT/bin"

cargo build --manifest-path "$ROOT/rust/Cargo.toml" --release --offline
make -C "$ROOT/cpp" clean all
install -m 0755 "$ROOT/rust/target/release/loam-ingest" "$ROOT/bin/loam-ingest"
install -m 0755 "$ROOT/cpp/build/loam" "$ROOT/bin/loam"
